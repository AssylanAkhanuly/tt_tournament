...@_theme

direction: down

# Три колонки: иначе четырнадцать дорожек уходят в один ряд шириной под 20000 px.
grid-columns: 3

# РАБОЧИЙ ПУТЬ КАЖДОЙ РОЛИ: с какого экрана начинает, куда идёт, что нажимает.
# Роли по документу федерации (TZ §2) и совещанию 04.11.2026; роли сборной
# 19–22 работают в экранах роли 11.
# Контур — документы федерации (решение 11.08.2026) и решения совещания
# 04.11.2026 (flows/README.md): три категории календаря; клубных турниров нет,
# матч «без судьи» — режим главного судьи.
# Узлы с кодом «Э№.№» — экраны: их поэкранная детализация (зоны, поля, кнопки,
# состояния) — в flows/<номер роли>-*.md; коды здесь и там совпадают.
# Сводка прав — ROLES.md.
#
# Как читать:
#   синее   — экран (Э№) или шаг работы
#   жёлтое  — развилка либо ключевое право (то, чего нет у других)
#   зелёное — результат действия
#   красное — отказ, блокировка, «нельзя»
#   серое   — пояснение: чего роль не делает или что видит со стороны

# ── 1 ────────────────────────────────────────────────────────────────────────
r1: "1 · АДМИНИСТРАТОР ФЕДЕРАЦИИ\nдесктоп · правит всё" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  a0: "Э1.1 Панель Федерации\nтребует внимания: турниры без судьи,\nзависшие заявки, неоплаченные взносы" { class: step }
  a1: "Э1.2 Календарь сезона\nфильтры: категория · пол · возраст · город" { class: step }
  a2: "Э1.4 Завести соревнование\nдаты · город · разряды · граница · флаги" { class: step }
  a3: "Э1.3 Карточка турнира\nрегламент · заявки · сетка · расписание ·\nсудьи · протокол · журнал" { class: step }
  a4: "Э1.5 Пользователи и роли\nреестр: спортсмены · судьи · тренеры · клубы\nЕДИНСТВЕННЫЙ, кто заводит аккаунты\nи выдаёт роли с областью и сроком" { class: rbac }
  a6: "Э1.7 Журнал действий\nкто · что · когда · было-стало" { class: step }
  a7: "Опубликовать соревнование" { class: good }
  a10: "Опубликовать ЕРК\nединый республиканский календарь\nсезона выходит на сайт целиком" { class: good }
  a8: "Отменить или перенести\nзаявки сохраняются, заявители уведомлены" { class: block }
  a9: "Судью НЕ назначает — это ГСК\nсчёт НЕ вводит" { class: muted }

  a0 -> a1 -> a2 -> a3 -> a7
  a1 -> a10
  a3 -> a8 { class: back }
  a0 -> a4
  a0 -> a6
  a4 -> a9 { class: loop }
}

# ── 2 ────────────────────────────────────────────────────────────────────────
r2: "2 · ЭКОНОМИСТ / БУХГАЛТЕР\nдесктоп · только деньги" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  b0: "Э2.1 Взносы за сезон\nоплачен · не оплачен · квитанция на проверке\nфильтр: клуб · регион · год · вид платежа" { class: step }
  b1: "Э2.2 Карточка взноса\nгод · сумма · дата · кто отметил" { class: step }
  b2: "Подтвердить\nквитанция сходится с платежом;\nоплата по ссылке банка подтверждается сама" { class: good }
  b7: "Подтвердить с пометкой\nпометка — в карточке и журнале" { class: good }
  b3: "Отказать с причиной\nплательщику уходит уведомление,\nзапись в журнал" { class: block }
  b4: "Неоплаченный взнос закрывает заявку,\nа не регистрацию" { class: good }
  b6: "Э2.5 Виды платежей и основания\nсумма по лиге · положения и приказы\nвидны плательщику" { class: step }

  b0 -> b1 -> b2 -> b4
  b1 -> b7 -> b4
  b1 -> b3 { class: back }
  b0 -> b6
}

# ── 3 и 4 ────────────────────────────────────────────────────────────────────
r34: "3 и 4 · МЕНЕДЖЕРЫ\nдве разные роли" {
  style.fill: "#ecfeff"
  style.stroke: "#06b6d4"

  c0: "Вход" { class: start }
  c1: "Э3.1 Обзорная панель\nчасть разделов администратора недоступна" { class: live }
  c2: "Э3.2 Все модули в режиме чтения\nкалендарь · заявки · сетки · протоколы\nреестры · рейтинги · взносы · таблицы Лиги" { class: step }
  c3: "Фильтровать · выгрузить · распечатать" { class: step }
  c4: "Э3.3 Подписки на соревнования\nуведомления без права вмешаться" { class: step }
  c5: "Менеджер по организации соревнований\nничего не правит: только чтение" { class: block }
  c6: "Э3.4 Тренерский совет — роль 3\nзаседание по ссылке Zoom · протокол:\nподпись секретаря → согласование" { class: step }

  c0 -> c1 -> c2 -> c3
  c2 -> c4
  c1 -> c5 { class: back }
  c1 -> c6
}

# ── 5 ────────────────────────────────────────────────────────────────────────
r5: "5 · ПРЕДСЕДАТЕЛЬ ГСК\nдесктоп · судейство" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  d0: "Э5.1 Панель ГСК\nждут судей · назначение не подтверждено" { class: step }
  d2: "Э5.2 Судьи на турнир\nзаявки и наряд одним экраном:\nрейтинг · категория · место в наряде" { class: step }
  d3: "СОБРАТЬ НАРЯД\nглавный судья, секретарь, зам, судьи —\nиз заявок и назначением" { class: rbac }
  d11: "Э5.8 Выбор судьи в наряд\nназначить из реестра, если заявок мало" { class: step }
  d14: "Назначенный судья подтверждает\nдо этого — «ждёт подтверждения»" { class: good }
  d4: "Э5.9 Отказ с причиной\nсудья может подать снова, пока приём открыт" { class: block }
  d6: "Э5.4 Итоговый протокол\nтолько чтение: закрывает главный судья,\nсутки на исправление" { class: step }
  d9: "Э5.5 Реестр судей: допуск и рейтинг\nтаблица: фамилия и итог R" { class: step }
  d12: "Э5.6 Документы на проверке\nS3 семинары · S4 награды и коллегия" { class: step }
  d13: "Э5.7 Публикация рейтинга\nапелляции — окно 10 дней" { class: step }

  d0 -> d2 -> d3
  d2 -> d11 -> d14
  d3 -> d14
  d2 -> d4 { class: back }
  d4 -> d2 { class: back }
  d0 -> d6
  d0 -> d9
  d9 -> d12 -> d13
  d12 -> d4 { class: back }
}

# ── 6 ────────────────────────────────────────────────────────────────────────
r6: "6 · ГЛАВНЫЙ СУДЬЯ СОРЕВНОВАНИЙ\nдесктоп · один турнир" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  e0: "Э6.1 Мой турнир\nкарточка соревнования · кто подался" { class: step }
  e1: "Э6.2 Заявки участников\nтолько чтение: условия проверяет система —\nвзнос · возраст · предел · квота региона" { class: step }
  e3: "Закрыть приём заявок" { class: step }
  e4: "Э6.3 Жеребьёвка и сетка\nсистема — по подсказке или сам;\nдвое сеяных, в круге «змейка»" { class: step }
  e5: "Э6.4 Расписание: дни на столы" { class: step }
  e6: "Э6.5 Судьи на столах\nили вызов пары «без судьи» —\nсчёт вносит игрок" { class: step }
  e7: "Э6.6 Ход турнира\nкарта столов · счёт · задержки" { class: step }
  e8: "Вызвать пару на стол\nуведомление «вызваны на стол N»" { class: rbac }
  e9: "Исправить счёт на любом этапе\nтолько главный судья · в журнал" { class: block }
  e12: "Передать полномочия\nсекретарю или заместителю —\nсам только смотрит" { class: rbac }
  e10: "Э6.9 Сформировать и закрыть протокол\nбез утверждения коллегией" { class: step }
  e11: "Э6.7 Итоговый протокол\nсутки на исправление,\nпотом пересчёт рейтинга" { class: good }

  e0 -> e1 -> e3 -> e4 -> e5 -> e6 -> e7 -> e8
  e7 -> e9 { class: back }
  e7 -> e12 { class: loop }
  e8 -> e10 -> e11
}

# ── 7 ────────────────────────────────────────────────────────────────────────
r7: "7 · ГЛАВНЫЙ СЕКРЕТАРЬ СОРЕВНОВАНИЙ\nдесктоп · оформляет то, что решил судья" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  f0: "Э7.1 Рабочий стол секретаря\nготовность: жеребьёвка · сетка ·\nрасписание · протокол" { class: step }
  f2: "Э7.3 Система проведения и сетка\nжеребьёвку проводит судья —\nсекретарь вносит" { class: step }
  f3: "Э7.4 Расписание: дни, столы, время" { class: step }
  f10: "Главный судья передал полномочия\nтеперь правит только секретарь" { class: rbac }
  f9: "Э7.6 Ход турнира\nвызов пар · ввод и исправление счёта" { class: step }
  f11: "Вернуть полномочия главному" { class: good }
  f4: "Э7.5 Протоколы: оформить" { class: step }
  f6: "Печать протоколов" { class: step }
  f8: "Заявки не рассматривает ·\nитоговый протокол не закрывает" { class: block }

  f0 -> f2 -> f3 -> f10 -> f9 -> f4 -> f6
  f9 -> f11
  f0 -> f8 { class: loop }
}

# ── 8 ────────────────────────────────────────────────────────────────────────
r8: "8 · ЗАМЕСТИТЕЛЬ ГЛАВНОГО СУДЬИ\nдесктоп · полномочия главного, когда тот передал" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  g1: "Э8.1 Мой турнир\nвидно, у кого полномочия" { class: step }
  g2: "Главный судья передал полномочия\nтеперь правит только заместитель" { class: rbac }
  g3: "Э8.2 Ход турнира\nвызов пар · исправление счёта" { class: step }
  g6: "Вернуть полномочия главному" { class: good }
  g5: "Итоговый протокол не закрывает" { class: block }

  g1 -> g2 -> g3 -> g6
  g3 -> g5 { class: loop }
}

# ── 9 ────────────────────────────────────────────────────────────────────────
r9: "9 · СУДЬЯ\nтелефон или планшет · свой стол" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  h0: "Э9.1 Мои турниры\nкарточка турнира · календарь · история" { class: step }
  h11: "Уведомление «вы назначены на стол N»\nвызов не «принимают» — назначает судья" { class: rbac }
  h1: "Э9.2 Мой стол\nтекущая пара · регламент · очередь" { class: step }
  h3: "Э9.3 Ввод счёта — чем ведётся стол?" { class: decide }
  h4: "По партиям\nсо своего телефона" { class: step }
  h5: "По очкам в реальном времени\nпланшет · счёт уходит в прямой эфир" { class: step }
  h6: "Э9.4 История матча\nотмена последнего · смена сторон и подачи" { class: step }
  h8: "Завершить матч" { class: good }
  h9: "Э9.5 Результат отправлен\nдальше правит только главный судья" { class: block }

  h0 -> h11 -> h1 -> h3
  h3 -> h4
  h3 -> h5
  h4 -> h6
  h5 -> h6
  h6 -> h8 -> h9
}

# ── 11 ───────────────────────────────────────────────────────────────────────
r11: "11 · ГЛАВНЫЙ ТРЕНЕР НАЦИОНАЛЬНОЙ КОМАНДЫ\nдесктоп · сборная" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  j0: "Доступ к роли — запросом с приказом,\nфедерация подтверждает" { class: muted }
  j1: "Э11.1 Состав национальной команды\nосновной и расширенный · план долей ·\nмедицинский допуск" { class: step }
  j2: "Э11.2 Карточка спортсмена сборной\nплан подготовки · медкарта · история" { class: step }
  j8: "Э11.5 План подготовки\nсоставляет личный тренер,\nсогласует главный тренер" { class: step }
  j3: "Э11.3 Календарь подготовки\nсборы и целевые старты сезона одной лентой" { class: step }
  j4: "Э11.4 Рапорты на командирование\nсам лист рапорта · история согласования" { class: step }
  j5: "Согласовать\nдокумент уходит в федерацию сам" { class: good }
  j6: "Вернуть на доработку или отклонить\nкомментарий обязателен" { class: block }

  j0 -> j1 -> j2 -> j8
  j8 -> j2 { class: back }
  j1 -> j3 -> j4
  j4 -> j5
  j4 -> j6 { class: loop }
}

# ── 12 ───────────────────────────────────────────────────────────────────────
r12: "12 · СТАРШИЙ ТРЕНЕР РЕГИОНА\nдесктоп · свой регион · главные старты РК" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  k0: "Э12.1 Мой регион\nспортсмены: рейтинг · год рождения ·\nвзнос · клуб" { class: step }
  k1: "Э12.2 Календарь главных стартов\nвосемь стартов и окна приёма заявок" { class: step }
  k2: "Э12.3 Формирование состава\nсистема показывает ТОЛЬКО тех, чья дата\nрождения в возрастных категориях старта\nи помечает неоплаченный взнос" { class: rbac }
  k3: "Приложить документы" { class: step }
  k4: "ПОДАТЬ ЗАЯВКУ\nодна заявка на весь список" { class: step }
  k5: "Система проверяет заявку\nквота региона · возраст · взнос · предел" { class: decide }
  k6: "Не принята сразу, с причиной\nисправить и подать снова" { class: block }
  k7: "Врач допустил — спортсмены в составе" { class: good }
  k8: "Э12.5 Свои на турнире — просмотр\nсетка · расписание · счёт своих" { class: step }
  k9: "Не своего региона — нельзя\nне проходящего по возрасту — нельзя" { class: block }
  k10: "Э12.8 Рапорт на командирование\nсформировать в системе или загрузить файлом ·\nсостав из своих спортсменов" { class: step }
  k11: "Согласует главный тренер сборной\n(его экран Э11.4)" { class: decide }
  k12: "Вернули на доработку\nкомментарий читается здесь же" { class: block }

  k0 -> k1 -> k2 -> k3 -> k4 -> k5
  k5 -> k6: не проходит { class: back }
  k6 -> k2 { class: back }
  k5 -> k7: проходит
  k7 -> k8
  k2 -> k9 { class: loop }
  k0 -> k10
  k10 -> k11
  k11 -> k12: на доработке { class: back }
  k12 -> k10 { class: back }
}

# ── 13 ───────────────────────────────────────────────────────────────────────
r13: "13 · АДМИНИСТРАТОР КЛУБА\nдесктоп · свой клуб · Евразийская лига" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  l0: "Зарегистрировать клуб — однократно" { class: step }
  l1: "Э13.1 Мой клуб\nспортсмены и люди клуба:\nдиректор · массажист · психолог · иное лицо" { class: step }
  l2: "Э13.2 Регистрация людей\nспортсмен · тренер · сотрудник" { class: step }

  l4: "Э13.3 ЕВРАЗИЙСКАЯ ЛИГА\nзаявить команду и состав ·\nподтверждать состав на каждый тур" { class: rbac }
  l5: "Команда играет, таблица копится" { class: good }


  l0 -> l1 -> l2 -> l4
  l4 -> l5
}

# ── 14 ───────────────────────────────────────────────────────────────────────
r14: "14 · СПОРТСМЕН\nсайт и приложение · единственный с приложением" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  m1: "Э14.2 Турниры\nодин список: мои старты и открытые приёмы ·\nидущий турнир — первая строка" { class: step }
  m2: "Какая категория?" { class: decide }
  m3: "Чемпионаты и Кубок РК\n«состав подаёт регион»" { class: muted }
  m4: "Евразийская лига\n«вы заявлены за команду»" { class: muted }
  m5: "Э14.3 Открытый республиканский\nКНОПКА «ЗАЯВИТЬСЯ»\nразряд · документы" { class: rbac }
  m7: "Э14.4 Моя заявка\nподана · допущен · не допущен врачом;\nнепроходящую система не принимает сразу" { class: step }
  m8: "Э14.5 Мой турнир и матч\nсоперник · стол · когда выходить" { class: step }
  m9: "Счёт ведёт судья;\nв матче «без судьи» вносит игрок" { class: block }
  m10: "Новый рейтинг — через сутки\nпосле закрытия протокола" { class: good }
  m11: "Э14.7 Профиль · Э14.6 Аналитика\nмой рейтинг и вход в разбор сезона ·\nматчи · личные встречи · взнос" { class: step }

  m1 -> m2
  m2 -> m3
  m2 -> m4
  m2 -> m5
  m5 -> m7
  m1 -> m8
  m7 -> m8 -> m9
  m8 -> m10 -> m11
}

# ── 18 ───────────────────────────────────────────────────────────────────────
r18: "18 · ВРАЧ СОРЕВНОВАНИЙ\nтелефон и десктоп · один турнир" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  v1: "Э18.1 Регистрация врача\nдоговор · документ об образовании ·\nудостоверение личности" { class: step }
  v2: "Э18.2 Мои турниры\nдоступ к заявкам — за 3 дня до старта" { class: step }
  v3: "Э18.3 Допуск участников\nсправка 027/у: из DamuMed или файлом" { class: step }
  v4: "Э18.4 Карточка участника\nдопущен / не допущен" { class: rbac }
  v5: "Отвечает за то, что справка нужная,\nа не за её подлинность" { class: block }

  v1 -> v2 -> v3 -> v4
  v4 -> v3 { class: back }
  v4 -> v5 { class: loop }
}

# ── 19 ────────────────────────────────────────────────────────────────────────
r19: "19 · ТРЕНЕР-КОНСУЛЬТАНТ\nдесктоп · сборная · копия главного тренера" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  c0: "Э11.1 Состав национальной команды\nсписок всех игроков сборной" { class: step }
  c1: "Э11.2 Карточка спортсмена сборной\nи остальные экраны главного тренера" { class: step }
  c2: "Те же права: согласует планы\nподготовки и рапорты" { class: rbac }
  c3: "Работа сборной не встаёт,\nкогда главного тренера нет" { class: good }

  c0 -> c1 -> c2 -> c3
}

# ── 20 ────────────────────────────────────────────────────────────────────────
r20: "20 · ТРЕНЕР СБОРНОЙ\nдесктоп · кадеты · юноши · взрослые" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  a0: "Э11.1 Состав сборной\nсписок игроков своей возрастной группы" { class: step }
  a1: "Э11.2 Карточка спортсмена сборной" { class: step }
  a2: "Э11.4 Рапорты на командирование\nот старших тренеров регионов\nпо спортсменам своего возраста" { class: step }

  a0 -> a1 -> a2
  a1 -> a0 { class: back }
}

# ── 21 ────────────────────────────────────────────────────────────────────────
r21: "21 · ВРАЧ СБОРНОЙ\nдесктоп · члены сборной" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  d0: "Э11.1 Состав национальной команды\nсписок всех игроков сборной" { class: step }
  d1: "Э11.2 Карточка спортсмена сборной\nмедицинская карта" { class: step }
  d2: "Вносит УМО, болезни, травмы\nс ограничением нагрузки и датой снятия" { class: good }
  d3: "Допуск на турнир ставит не он,\nа врач соревнований (18)" { class: block }

  d0 -> d1 -> d2
  d1 -> d0 { class: back }
  d2 -> d3 { class: loop }
}

# ── 22 ────────────────────────────────────────────────────────────────────────
r22: "22 · ПСИХОЛОГ СБОРНОЙ\nдесктоп · члены сборной" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  p0: "Э11.1 Состав национальной команды\nсписок всех игроков сборной" { class: step }
  p1: "Э11.2 Карточка спортсмена сборной\nспортивная карточка" { class: step }
  p2: "Комментарии и ход подготовки за год" { class: good }

  p0 -> p1 -> p2
  p1 -> p0 { class: back }
}

# ── Посетитель ───────────────────────────────────────────────────────────────
r0: "БЕЗ ВХОДА В СИСТЕМУ\nроли нет" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  n0: "Открыл сайт" { class: start }
  n1: "Э0.4 Рейтинг игроков с фильтрами\nрейтинг судей" { class: step }
  n2: "Э0.4 Страница турнира\nсостав · сетка · расписание · результаты\nсчёт в реальном времени" { class: step }
  n3: "Новости, анонсы, трансляция" { class: step }
  n4: "Дальше — только через регистрацию" { class: block }

  n0 -> n1
  n0 -> n2
  n0 -> n3
  n2 -> n4 { class: loop }
}
