...@_theme

direction: down

# Три колонки: иначе четырнадцать дорожек уходят в один ряд шириной под 20000 px.
grid-columns: 3

# РАБОЧИЙ ПУТЬ КАЖДОЙ РОЛИ: с какого экрана начинает, куда идёт, что нажимает.
# Четырнадцать ролей по документу федерации (TZ §2), подробности — ROLES.md.
#
# Как читать:
#   синее   — экран или шаг работы
#   жёлтое  — развилка либо ключевое право (то, чего нет у других)
#   зелёное — результат действия
#   красное — отказ, блокировка, «нельзя»
#   серое   — открытый вопрос: ответа нет, дальше не проектируем

# ── 1 ────────────────────────────────────────────────────────────────────────
r1: "1 · АДМИНИСТРАТОР ФЕДЕРАЦИИ\nдесктоп · правит всё" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  a0: "Панель Федерации\nчто требует внимания: турниры без судьи,\nзависшие заявки, неоплаченные взносы" { class: step }
  a1: "Календарь сезона" { class: step }
  a2: "Завести соревнование\nдаты · город · разряды · возрастная граница" { class: step }
  a3: "Пользователи и роли\nЕДИНСТВЕННЫЙ, кто заводит аккаунты\nи выдаёт роли с областью и сроком" { class: rbac }
  a4: "Реестры\nспортсмены · судьи · тренеры · клубы" { class: step }
  a5: "Опубликовать соревнование" { class: good }
  a6: "Отменить или перенести\nзаявки сохраняются, заявители уведомлены" { class: block }
  a7: "Судью НЕ назначает — это ГСК\nсчёт НЕ вводит" { class: muted }

  a0 -> a1 -> a2 -> a5
  a0 -> a3
  a0 -> a4
  a2 -> a6 { class: back }
  a3 -> a7 { class: loop }
}

# ── 2 ────────────────────────────────────────────────────────────────────────
r2: "2 · ЭКОНОМИСТ / БУХГАЛТЕР\nдесктоп · только деньги" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  b0: "Взносы за сезон\nоплачен · не оплачен · просрочен" { class: step }
  b1: "Фильтр по клубу, региону, году" { class: step }
  b2: "Карточка взноса" { class: step }
  b3: "Отметить оплату" { class: good }
  b4: "Снять отметку с причиной\nпопадает в журнал" { class: block }
  b5: "Спортсмен проходит допуск там,\nгде взнос требуется" { class: good }
  b6: "ОТКРЫТЫЙ ВОПРОС\nблокирует ли неоплаченный взнос заявку;\nвзнос за год или за сезон" { class: muted }
  b7: "Плата за турнир — не его:\nеё ставит и отмечает клуб" { class: muted }

  b0 -> b1 -> b2 -> b3 -> b5
  b2 -> b4 { class: back }
  b3 -> b6 { class: loop }
  b0 -> b7 { class: loop }
}

# ── 3 и 4 ────────────────────────────────────────────────────────────────────
r34: "3 и 4 · МЕНЕДЖЕРЫ-НАБЛЮДАТЕЛИ\nпо спортивной работе · по организации соревнований" {
  style.fill: "#ecfeff"
  style.stroke: "#06b6d4"

  c0: "Вход" { class: start }
  c1: "ВИДЯТ ВСЕ МОДУЛИ\nкалендарь · заявки · сетки · протоколы\nреестры · рейтинги · взносы · таблицы Лиги" { class: live }
  c2: "Фильтровать, искать, открывать" { class: step }
  c3: "Выгрузить или распечатать" { class: step }
  c4: "НИ ОДНОЙ КНОПКИ, МЕНЯЮЩЕЙ ДАННЫЕ\nни «сохранить», ни «утвердить», ни «отклонить»" { class: block }
  c5: "Это отдельный класс прав:\nчтение и запись проверяются раздельно,\nа не «админ минус кнопки»" { class: rbac }
  c6: "ОТКРЫТЫЙ ВОПРОС\nв документе обе роли описаны одинаково —\nэто одна роль или две?" { class: muted }

  c0 -> c1 -> c2 -> c3
  c1 -> c4 { class: back }
  c4 -> c5 { class: loop }
  c1 -> c6 { class: loop }
}

# ── 5 ────────────────────────────────────────────────────────────────────────
r5: "5 · ПРЕДСЕДАТЕЛЬ ГСК\nдесктоп · судейство и результаты" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  d0: "Мои соревнования\nчто ждёт назначения, что ждёт утверждения" { class: step }
  d1: "ОТКРЫТЫЙ ВОПРОС\nсудьи подают заявки или назначаем напрямую" { class: muted }
  d2: "Заявки судей\nвидны рейтинг, категория, история судейства" { class: step }
  d3: "НАЗНАЧИТЬ ГЛАВНОГО СУДЬЮ" { class: rbac }
  d4: "Отказ с причиной\nсудья может подать снова" { class: block }
  d5: "Наряд: секретарь, заместитель, судьи" { class: step }
  d6: "Протокол на утверждении" { class: step }
  d7: "УТВЕРДИТЬ ПРОТОКОЛ\nтурнир завершён, рейтинг пересчитан" { class: good }
  d8: "Вернуть с причиной\nввод открывается снова" { class: block }
  d9: "Рейтинг судей\nдокументы S3/S4 · публикация · апелляции 10 дней" { class: step }

  d0 -> d1 { class: loop }
  d0 -> d2 -> d3 -> d5
  d2 -> d4 { class: back }
  d4 -> d2 { class: back }
  d5 -> d6 -> d7
  d6 -> d8 { class: back }
  d0 -> d9
}

# ── 6 ────────────────────────────────────────────────────────────────────────
r6: "6 · ГЛАВНЫЙ СУДЬЯ СОРЕВНОВАНИЙ\nдесктоп · один турнир" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  e0: "Мой турнир\nсостояние · заявок · столов · сыграно" { class: step }
  e1: "Заявки участников\nкто подал · документы · взнос · возраст · ценз" { class: step }
  e2: "Принять или отклонить с причиной" { class: decide }
  e3: "Закрыть приём заявок" { class: step }
  e4: "Конструктор сетки\nформат из библиотеки или свой\nподсказка: что уложится в столы и часы" { class: step }
  e5: "Посев или жеребьёвка · расписание · столы" { class: step }
  e6: "Поставить судей на столы\nбез судьи стол не принимает матчи" { class: step }
  e7: "Ход турнира\nвсе столы, счёт, задержки" { class: step }
  e8: "Вызвать пару на стол\nуведомление игрокам и судье" { class: rbac }
  e9: "Исправить счёт · с лимитом времени\nкаждая правка — в журнал с автором" { class: block }
  e10: "Сформировать протокол\nввод блокируется" { class: step }
  e11: "Официальный — на утверждение ГСК\nклубный — закрывает сам" { class: good }

  e0 -> e1 -> e2 -> e3 -> e4 -> e5 -> e6 -> e7 -> e8
  e7 -> e9 { class: back }
  e8 -> e10 -> e11
}

# ── 7 ────────────────────────────────────────────────────────────────────────
r7: "7 · ГЛАВНЫЙ СЕКРЕТАРЬ СОРЕВНОВАНИЙ\nдесктоп · оформляет то, что решил судья" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  f0: "Турнир, куда назначен" { class: step }
  f1: "Провести жеребьёвку" { class: step }
  f2: "Собрать сетку по выбранному формату" { class: step }
  f3: "Составить расписание: дни, столы, время" { class: step }
  f4: "Оформить протоколы" { class: step }
  f5: "Передать главному судье на утверждение" { class: good }
  f6: "Печать протоколов" { class: step }
  f7: "ГРАНИЦА С СУДЬЁЙ НЕ ПРОВЕДЕНА\nу судьи «утверждение сеток», у секретаря «сетки»:\nчитаем как «секретарь делает, судья утверждает» —\nподтвердить" { class: muted }
  f8: "Заявки не рассматривает" { class: block }

  f0 -> f1 -> f2 -> f3 -> f4 -> f5 -> f6
  f2 -> f7 { class: loop }
  f0 -> f8 { class: loop }
}

# ── 8 ────────────────────────────────────────────────────────────────────────
r8: "8 · ЗАМЕСТИТЕЛЬ ГЛАВНОГО СУДЬИ\nфункционал в документе не заполнен" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  g0: "Роль есть в перечне федерации" { class: muted }
  g1: "ЧТО СПРОСИТЬ\nправа как у главного судьи —\nвсегда или только когда тот отсутствует?" { class: muted }
  g2: "Может ли утверждать сетку\nи подписывать протокол?" { class: muted }
  g3: "Входит в наряд судей?\nв методике рейтинга судей коэффициент\nдля заместителя УЖЕ ЕСТЬ" { class: muted }
  g4: "Сколько заместителей на турнире?" { class: muted }
  g5: "Экраны и кнопки не проектируем:\nлюбой вариант сейчас — догадка" { class: block }

  g0 -> g1 -> g2 -> g3 -> g4 -> g5
}

# ── 9 ────────────────────────────────────────────────────────────────────────
r9: "9 · СУДЬЯ\nпланшет или телефон · свой стол" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  h0: "Мои турниры\nгде он в наряде" { class: step }
  h1: "Мой стол\nномер · текущая пара · до скольких партий" { class: step }
  h2: "Принять вызов пары" { class: step }
  h3: "Режим ввода?" { class: decide }
  h4: "По партиям\nитог матча — производная" { class: step }
  h5: "По очкам в реальном времени\nсчёт уходит в прямой эфир" { class: step }
  h6: "Отмена последнего очка\nсмена сторон · смена подачи" { class: step }
  h7: "Обрыв связи: пишет локально\nпри расхождении ПРИОРИТЕТ У НЕГО —\nон видит игру" { class: rbac }
  h8: "Подтвердить результат" { class: good }
  h9: "После подтверждения правит\nтолько главный судья" { class: block }
  h10: "Мой рейтинг судьи\nбаллы S1-S4 · документы · апелляция 10 дней" { class: step }

  h0 -> h1 -> h2 -> h3
  h3 -> h4
  h3 -> h5
  h4 -> h6
  h5 -> h6
  h6 -> h7 { class: loop }
  h6 -> h8 -> h9
  h0 -> h10
}

# ── 10 ───────────────────────────────────────────────────────────────────────
r10: "10 · ИНСПЕКТОР / СУПЕРВАЙЗЕР\nдесктоп · смотрит со стороны" {
  style.fill: "#ecfeff"
  style.stroke: "#06b6d4"

  i0: "Соревнования на контроле" { class: step }
  i1: "Ход турнира глазами инспектора\nстолы и счёт — только просмотр" { class: live }
  i2: "Журнал правок и спорных ситуаций\nчто исправлялось, кем и почему" { class: live }
  i3: "Создать заключение\nпо соревнованию или по конкретному судье" { class: step }
  i4: "Приложить материалы" { class: step }
  i5: "Отправить" { class: good }
  i6: "ОТКРЫТЫЙ ВОПРОС\nкому уходит заключение и что меняет:\nрейтинг судьи? допуск? результат турнира?" { class: muted }
  i7: "Турниром не управляет" { class: block }

  i0 -> i1 -> i2 -> i3 -> i4 -> i5
  i5 -> i6 { class: loop }
  i0 -> i7 { class: loop }
}

# ── 11 ───────────────────────────────────────────────────────────────────────
r11: "11 · ГЛАВНЫЙ ТРЕНЕР НАЦИОНАЛЬНОЙ КОМАНДЫ\nфункционал в документе не заполнен" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  j0: "Роль есть в перечне федерации" { class: muted }
  j1: "ЧТО СПРОСИТЬ\nтолько смотрит составы и рейтинги —\nили ещё и заявляет сборную?" { class: muted }
  j2: "Международных стартов в календаре нет вовсе:\nв перечне только республиканские" { class: muted }
  j3: "Видит всех спортсменов страны\nили только кандидатский список?" { class: muted }
  j4: "Нужен ли свой срез «сборная»:\nотбор по рейтингу и результатам за период" { class: muted }
  j5: "Пока проставлено только чтение —\nэто наше допущение" { class: block }

  j0 -> j1 -> j2 -> j3 -> j4 -> j5
}

# ── 12 ───────────────────────────────────────────────────────────────────────
r12: "12 · СТАРШИЙ ТРЕНЕР РЕГИОНА\nдесктоп · свой регион · главные старты РК" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  k0: "Мой регион\nспортсмены: рейтинг, год рождения, взнос, клуб" { class: step }
  k1: "Календарь главных стартов\nвосемь стартов и сроки приёма заявок" { class: step }
  k2: "Формирование состава\nсистема показывает ТОЛЬКО проходящих\nпо возрастной границе этого старта\nи помечает неоплаченный взнос" { class: rbac }
  k3: "Приложить документы" { class: step }
  k4: "ПОДАТЬ ЗАЯВКУ\nодна заявка на весь список" { class: step }
  k5: "Решение главного судьи" { class: decide }
  k6: "Отказ с причиной\nисправить и подать снова" { class: block }
  k7: "Спортсмены в составе турнира" { class: good }
  k8: "Не своего региона — нельзя\nне проходящего по возрасту — нельзя" { class: block }

  k0 -> k1 -> k2 -> k3 -> k4 -> k5
  k5 -> k6: отклонена { class: back }
  k6 -> k2 { class: back }
  k5 -> k7: принята
  k2 -> k8 { class: loop }
}

# ── 13 ───────────────────────────────────────────────────────────────────────
r13: "13 · АДМИНИСТРАТОР КЛУБА\nдесктоп · свой клуб · Лига и клубные турниры" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  l0: "Зарегистрировать клуб" { class: step }
  l1: "Мой клуб\nспортсмены · тренеры · иные лица" { class: step }
  l2: "Завести спортсмена, тренера, сотрудника" { class: step }
  l3: "Что дальше?" { class: decide }

  l4: "ЕВРАЗИЙСКАЯ ЛИГА\nзаявить команду в свою лигу и её состав" { class: rbac }
  l5: "Перед каждым из четырёх туров\nподтвердить состав на тур" { class: step }
  l6: "Команда играет, таблица копится" { class: good }

  l7: "КЛУБНЫЙ ТУРНИР\nзавести: регламент и флаги —\nсудьи на столах · плата · рейтинг · ценз" { class: rbac }
  l8: "Назначить главного судью\nнеформально, конкурса нет" { class: step }
  l9: "Опубликовать — свободная запись" { class: good }
  l10: "Отметить оплату участия\nэто плата клуба, не годовой взнос" { class: step }

  l11: "ОТКРЫТЫЙ ВОПРОС\n«клубные соревнования» в документе —\nэто включает Лигу или это разные заявки?" { class: muted }

  l0 -> l1 -> l2 -> l3
  l3 -> l4: Лига
  l4 -> l5 -> l6
  l3 -> l7: свой турнир
  l7 -> l8 -> l9 -> l10
  l4 -> l11 { class: loop }
}

# ── 14 ───────────────────────────────────────────────────────────────────────
r14: "14 · СПОРТСМЕН\nсайт и приложение · единственный с приложением" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  m0: "Главная\nсвой рейтинг и место · ближайший турнир" { class: step }
  m1: "Календарь\nпо каждому старту видно, может ли он сам" { class: step }
  m2: "Какая категория?" { class: decide }
  m3: "Чемпионаты и Кубок РК\n«состав подаёт регион»" { class: muted }
  m4: "Евразийская лига\n«вы заявлены за команду»" { class: muted }
  m5: "Открытый республиканский\nКНОПКА «ЗАЯВИТЬСЯ»" { class: rbac }
  m6: "Клубный\nКНОПКА «ЗАПИСАТЬСЯ» — без рассмотрения" { class: rbac }
  m7: "Моя заявка\nподана · принята · отклонена с причиной" { class: step }
  m8: "Мой матч\nсоперник · стол · когда выходить" { class: step }
  m9: "Счёт ведёт судья\nспортсмен не вводит и не подтверждает" { class: block }
  m10: "Турнир завершён — новый рейтинг\nуведомление в приложение" { class: good }
  m11: "Аналитика\nматчи · винрейт · личные встречи\nрасширенная — платная" { class: step }

  m0 -> m1 -> m2
  m2 -> m3
  m2 -> m4
  m2 -> m5
  m2 -> m6
  m5 -> m7
  m6 -> m7
  m7 -> m8 -> m9
  m8 -> m10 -> m11
}

# ── Посетитель ───────────────────────────────────────────────────────────────
r0: "БЕЗ ВХОДА В СИСТЕМУ\nроли нет" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  n0: "Открыл сайт" { class: start }
  n1: "Рейтинг игроков с фильтрами\nрейтинг судей" { class: step }
  n2: "Страница турнира\nсостав · сетка · расписание · результаты\nсчёт в реальном времени" { class: step }
  n3: "Новости, анонсы, трансляция" { class: step }
  n4: "Дальше — только через регистрацию" { class: block }

  n0 -> n1
  n0 -> n2
  n0 -> n3
  n2 -> n4 { class: loop }
}
