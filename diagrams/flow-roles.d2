...@_theme

direction: down

# Три колонки: иначе четырнадцать дорожек уходят в один ряд шириной под 20000 px.
grid-columns: 3

# РАБОЧИЙ ПУТЬ КАЖДОЙ РОЛИ: с какого экрана начинает, куда идёт, что нажимает.
# Четырнадцать ролей по документу федерации (TZ §2).
# Узлы с кодом «Э№.№» — экраны: их поэкранная детализация (зоны, поля, кнопки,
# состояния) — в flows/<номер роли>-*.md; коды здесь и там совпадают.
# Сводка прав — ROLES.md.
#
# Как читать:
#   синее   — экран (Э№) или шаг работы
#   жёлтое  — развилка либо ключевое право (то, чего нет у других)
#   зелёное — результат действия
#   красное — отказ, блокировка, «нельзя»
#   серое   — открытый вопрос: ответа нет, дальше не проектируем

# ── 1 ────────────────────────────────────────────────────────────────────────
r1: "1 · АДМИНИСТРАТОР ФЕДЕРАЦИИ\nдесктоп · правит всё" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  a0: "Э1.1 Панель Федерации\nтребует внимания: турниры без судьи,\nзависшие заявки, неоплаченные взносы" { class: step }
  a1: "Э1.2 Календарь сезона\nфильтры: категория · пол · возраст · город" { class: step }
  a2: "Э1.4 Завести соревнование\nдаты · город · разряды · граница · флаги" { class: step }
  a3: "Э1.3 Карточка турнира\nрегламент · заявки · сетка · расписание ·\nсудьи · протокол · журнал" { class: step }
  a4: "Э1.5 Пользователи и роли\nЕДИНСТВЕННЫЙ, кто заводит аккаунты\nи выдаёт роли с областью и сроком" { class: rbac }
  a5: "Э1.6 Реестры\nспортсмены · судьи · тренеры · клубы" { class: step }
  a6: "Э1.7 Журнал действий\nкто · что · когда · было-стало" { class: step }
  a7: "Опубликовать соревнование" { class: good }
  a8: "Отменить или перенести\nзаявки сохраняются, заявители уведомлены" { class: block }
  a9: "Судью НЕ назначает — это ГСК\nсчёт НЕ вводит" { class: muted }

  a0 -> a1 -> a2 -> a3 -> a7
  a3 -> a8 { class: back }
  a0 -> a4
  a0 -> a5
  a0 -> a6
  a4 -> a9 { class: loop }
}

# ── 2 ────────────────────────────────────────────────────────────────────────
r2: "2 · ЭКОНОМИСТ / БУХГАЛТЕР\nдесктоп · только деньги" {
  style.fill: "#fffbeb"
  style.stroke: "#f59e0b"

  b0: "Э2.1 Взносы за сезон\nоплачен · не оплачен · просрочен\nфильтр: клуб · регион · год" { class: step }
  b1: "Э2.2 Карточка взноса\nгод · сумма · дата · кто отметил" { class: step }
  b2: "Отметить оплату" { class: good }
  b3: "Снять отметку с причиной\nпопадает в журнал" { class: block }
  b4: "Спортсмен проходит допуск там,\nгде взнос требуется" { class: good }
  b5: "Э2.3 Платежи по турнирам\nтолько просмотр: деньги клуба,\nих отмечает администратор клуба" { class: muted }
  b6: "ОТКРЫТЫЙ ВОПРОС\nблокирует ли неоплаченный взнос заявку;\nвзнос за год или за сезон" { class: muted }

  b0 -> b1 -> b2 -> b4
  b1 -> b3 { class: back }
  b2 -> b6 { class: loop }
  b0 -> b5
}

# ── 3 и 4 ────────────────────────────────────────────────────────────────────
r34: "3 и 4 · МЕНЕДЖЕРЫ-НАБЛЮДАТЕЛИ\nпо спортивной работе · по организации соревнований" {
  style.fill: "#ecfeff"
  style.stroke: "#06b6d4"

  c0: "Вход" { class: start }
  c1: "Э3.1 Обзорная панель\nте же зоны, что у администратора —\nбез единой кнопки записи" { class: live }
  c2: "Э3.2 Все модули в режиме чтения\nкалендарь · заявки · сетки · протоколы\nреестры · рейтинги · взносы · таблицы Лиги" { class: step }
  c3: "Фильтровать · выгрузить · распечатать" { class: step }
  c4: "Э3.3 Подписки на соревнования\nуведомления без права вмешаться" { class: step }
  c5: "НИ ОДНОЙ КНОПКИ, МЕНЯЮЩЕЙ ДАННЫЕ\nчтение и запись — раздельные права,\nа не «админ минус кнопки»" { class: block }
  c6: "ОТКРЫТЫЙ ВОПРОС\nв документе обе роли описаны одинаково —\nэто одна роль или две?" { class: muted }

  c0 -> c1 -> c2 -> c3
  c2 -> c4
  c1 -> c5 { class: back }
  c1 -> c6 { class: loop }
}

# ── 5 ────────────────────────────────────────────────────────────────────────
r5: "5 · ПРЕДСЕДАТЕЛЬ ГСК\nдесктоп · судейство и результаты" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  d0: "Э5.1 Мои соревнования\nочереди: ждут назначения судьи ·\nждут утверждения протокола" { class: step }
  d1: "ОТКРЫТЫЙ ВОПРОС\nсудьи подают заявки или назначаем напрямую" { class: muted }
  d2: "Э5.2 Заявки судей\nрейтинг · категория · история судейства" { class: step }
  d3: "НАЗНАЧИТЬ ГЛАВНОГО СУДЬЮ" { class: rbac }
  d4: "Отказ с причиной\nсудья может подать снова" { class: block }
  d5: "Э5.3 Наряд: секретарь ·\nзаместитель · судьи" { class: step }
  d6: "Э5.4 Протокол на утверждении\nсверка: правки счёта · техпобеды · неявки" { class: step }
  d7: "УТВЕРДИТЬ ПРОТОКОЛ\nтурнир завершён, рейтинг пересчитан" { class: good }
  d8: "Вернуть с причиной\nввод открывается снова" { class: block }
  d9: "Э5.5–Э5.7 Рейтинг судей\nжурнал S1–S4 · документы на проверке ·\nпубликация · апелляции 10 дней" { class: step }

  d0 -> d1 { class: loop }
  d0 -> d2 -> d3 -> d5
  d2 -> d4 { class: back }
  d4 -> d2 { class: back }
  d5 -> d6 -> d7
  d6 -> d8 { class: back }
  d0 -> d9
}

# ── 6 ────────────────────────────────────────────────────────────────────────
r6: "6 · ГЛАВНЫЙ СУДЬЯ СОРЕВНОВАНИЙ\nдесктоп · один турнир" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  e0: "Э6.1 Мой турнир\nшкала состояний · счётчики ·\nчто сейчас требуется" { class: step }
  e1: "Э6.2 Заявки участников\nкто подал · допуск: возраст · ценз ·\nвзнос · документы" { class: step }
  e2: "Принять или отклонить с причиной" { class: decide }
  e3: "Закрыть приём заявок" { class: step }
  e4: "Э6.3 Сетка: формат и посев\nподсказка: что уложится в столы и часы" { class: step }
  e5: "Э6.4 Расписание: дни на столы" { class: step }
  e6: "Э6.5 Судьи на столах\nбез судьи стол не принимает матчи" { class: step }
  e7: "Э6.6 Ход турнира\nкарта столов · счёт · задержки" { class: step }
  e8: "Вызвать пару на стол\nуведомление игрокам и судье" { class: rbac }
  e9: "Исправить счёт · с лимитом времени\nкаждая правка — в журнал с автором" { class: block }
  e10: "Э6.7 Итоговый протокол\nввод блокируется" { class: step }
  e11: "официальный — на утверждение ГСК\nклубный — закрывает сам" { class: good }

  e0 -> e1 -> e2 -> e3 -> e4 -> e5 -> e6 -> e7 -> e8
  e7 -> e9 { class: back }
  e8 -> e10 -> e11
}

# ── 7 ────────────────────────────────────────────────────────────────────────
r7: "7 · ГЛАВНЫЙ СЕКРЕТАРЬ СОРЕВНОВАНИЙ\nдесктоп · оформляет то, что решил судья" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  f0: "Э7.1 Рабочий стол секретаря\nготовность: жеребьёвка · сетка ·\nрасписание · протокол" { class: step }
  f1: "Э7.2 Жеребьёвка\nжребий или посев по рейтингу" { class: step }
  f2: "Э7.3 Сетка по формату,\nвыбранному судьёй" { class: step }
  f3: "Э7.4 Расписание: дни, столы, время" { class: step }
  f4: "Э7.5 Протоколы: оформить" { class: step }
  f5: "Передать главному судье на утверждение" { class: good }
  f6: "Печать протоколов" { class: step }
  f7: "ГРАНИЦА С СУДЬЁЙ НЕ ПРОВЕДЕНА\nу судьи «утверждение сеток», у секретаря «сетки»:\nчитаем как «секретарь делает, судья утверждает» —\nподтвердить" { class: muted }
  f8: "Заявки не рассматривает" { class: block }

  f0 -> f1 -> f2 -> f3 -> f4 -> f5 -> f6
  f2 -> f7 { class: loop }
  f0 -> f8 { class: loop }
}

# ── 8 ────────────────────────────────────────────────────────────────────────
r8: "8 · ЗАМЕСТИТЕЛЬ ГЛАВНОГО СУДЬИ\nфункционал не заполнен — флоу-гипотеза (вопрос 12.1)" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  g0: "В документе федерации роль пуста.\nНиже — рабочая гипотеза для дизайна" { class: muted }
  g1: "Э8.1 Мой турнир — режим замещения\nпанель судьи + индикатор смены:\n«ведёт главный» / «замещаю»" { class: step }
  g2: "Принять смену\nпередача — в журнал с временем" { class: rbac }
  g3: "Э8.2 Ход турнира — когда замещает\nвызов пар · правки счёта" { class: step }
  g4: "Э8.3 Мой рейтинг судьи\nкоэффициент 1,5 для заместителя\nв Положении УЖЕ ЕСТЬ" { class: step }
  g5: "Протокол и сетку не утверждает —\nдо ответа федерации" { class: block }

  g0 -> g1 -> g2 -> g3
  g3 -> g5 { class: loop }
  g1 -> g4
}

# ── 9 ────────────────────────────────────────────────────────────────────────
r9: "9 · СУДЬЯ\nпланшет или телефон · свой стол" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  h0: "Э9.1 Мои турниры\nназначения · заявки на судейство" { class: step }
  h1: "Э9.2 Мой стол\nтекущая пара · регламент · очередь" { class: step }
  h2: "Принять вызов пары" { class: step }
  h3: "Э9.3 Ввод счёта — режим?" { class: decide }
  h4: "По партиям\nитог матча — производная" { class: step }
  h5: "По очкам в реальном времени\nсчёт уходит в прямой эфир" { class: step }
  h6: "Отмена последнего · смена сторон\nи подачи · Э9.4 история матча" { class: step }
  h7: "Обрыв связи: пишет локально\nпри расхождении ПРИОРИТЕТ У НЕГО —\nон видит игру" { class: rbac }
  h8: "Подтвердить результат" { class: good }
  h9: "После подтверждения правит\nтолько главный судья" { class: block }
  h10: "Э9.5 Мой рейтинг судьи\nS1–S4 · документы · апелляция 10 дней" { class: step }

  h0 -> h1 -> h2 -> h3
  h3 -> h4
  h3 -> h5
  h4 -> h6
  h5 -> h6
  h6 -> h7 { class: loop }
  h6 -> h8 -> h9
  h0 -> h10
}

# ── 10 ───────────────────────────────────────────────────────────────────────
r10: "10 · ИНСПЕКТОР / СУПЕРВАЙЗЕР\nдесктоп · смотрит со стороны" {
  style.fill: "#ecfeff"
  style.stroke: "#06b6d4"

  i0: "Э10.1 Соревнования на контроле" { class: step }
  i1: "Э10.2 Ход турнира — только просмотр\nправки счёта и авторы · задержки · неявки" { class: live }
  i2: "Э10.3 Журнал правок и спорных ситуаций\nчто исправлялось, кем и почему" { class: live }
  i3: "Э10.4 Заключение\nпо соревнованию или по конкретному судье" { class: step }
  i4: "Приложить материалы и эпизоды" { class: step }
  i5: "Отправить" { class: good }
  i6: "ОТКРЫТЫЙ ВОПРОС\nкому уходит заключение и что меняет:\nрейтинг судьи? допуск? результат турнира?" { class: muted }
  i7: "Турниром не управляет" { class: block }

  i0 -> i1 -> i2 -> i3 -> i4 -> i5
  i5 -> i6 { class: loop }
  i0 -> i7 { class: loop }
}

# ── 11 ───────────────────────────────────────────────────────────────────────
r11: "11 · ГЛАВНЫЙ ТРЕНЕР НАЦИОНАЛЬНОЙ КОМАНДЫ\nфункционал не заполнен — флоу-гипотеза (вопрос 12.1)" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  j0: "В документе федерации роль пуста.\nНиже — рабочая гипотеза для дизайна" { class: muted }
  j1: "Э11.1 Кандидаты в сборную\nрейтинг · динамика за период ·\nрезультаты главных стартов" { class: step }
  j2: "Э11.2 Карточка спортсмена — чтение\nистория рейтинга · матчи · личные встречи" { class: step }
  j3: "Э11.3 Сравнение кандидатов\nдва-три спортсмена колонками" { class: step }
  j4: "Только чтение — наше допущение.\nЗаявляет ли сборную и видит ли всех —\nспросить" { class: block }

  j0 -> j1 -> j2 -> j3
  j1 -> j4 { class: loop }
}

# ── 12 ───────────────────────────────────────────────────────────────────────
r12: "12 · СТАРШИЙ ТРЕНЕР РЕГИОНА\nдесктоп · свой регион · главные старты РК" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  k0: "Э12.1 Мой регион\nспортсмены: рейтинг · год рождения ·\nвзнос · клуб" { class: step }
  k1: "Э12.2 Календарь главных стартов\nвосемь стартов и окна приёма заявок" { class: step }
  k2: "Э12.3 Формирование состава\nсистема показывает ТОЛЬКО проходящих\nпо возрастной границе этого старта\nи помечает неоплаченный взнос" { class: rbac }
  k3: "Приложить документы" { class: step }
  k4: "ПОДАТЬ ЗАЯВКУ\nодна заявка на весь список" { class: step }
  k5: "Решение главного судьи" { class: decide }
  k6: "Э12.4 Мои заявки: отказ с причиной\nисправить и подать снова" { class: block }
  k7: "Спортсмены в составе турнира" { class: good }
  k8: "Э12.5 Свои на турнире — просмотр\nсетка · расписание · счёт своих" { class: step }
  k9: "Не своего региона — нельзя\nне проходящего по возрасту — нельзя" { class: block }

  k0 -> k1 -> k2 -> k3 -> k4 -> k5
  k5 -> k6: отклонена { class: back }
  k6 -> k2 { class: back }
  k5 -> k7: принята
  k7 -> k8
  k2 -> k9 { class: loop }
}

# ── 13 ───────────────────────────────────────────────────────────────────────
r13: "13 · АДМИНИСТРАТОР КЛУБА\nдесктоп · свой клуб · Лига и клубные турниры" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  l0: "Зарегистрировать клуб — однократно" { class: step }
  l1: "Э13.1 Мой клуб\nспортсмены · тренеры · иные лица" { class: step }
  l2: "Э13.2 Регистрация людей\nспортсмен · тренер · сотрудник" { class: step }
  l3: "Что дальше?" { class: decide }

  l4: "Э13.3 ЕВРАЗИЙСКАЯ ЛИГА\nзаявить команду и состав ·\nподтверждать состав на каждый тур" { class: rbac }
  l5: "Команда играет, таблица копится" { class: good }

  l6: "Э13.4–Э13.5 КЛУБНЫЙ ТУРНИР\nрегламент и флаги: судьи на столах ·\nплата · рейтинг · ценз" { class: rbac }
  l7: "Назначить главного судью\nнеформально, конкурса нет" { class: step }
  l8: "Опубликовать — свободная запись" { class: good }
  l9: "Э13.6 Платежи клуба\nотметить оплату участия — это плата\nклуба, не годовой взнос" { class: step }

  l10: "ОТКРЫТЫЙ ВОПРОС\n«клубные соревнования» в документе —\nэто включает Лигу или это разные заявки?" { class: muted }

  l0 -> l1 -> l2 -> l3
  l3 -> l4: Лига
  l4 -> l5
  l3 -> l6: свой турнир
  l6 -> l7 -> l8 -> l9
  l4 -> l10 { class: loop }
}

# ── 14 ───────────────────────────────────────────────────────────────────────
r14: "14 · СПОРТСМЕН\nсайт и приложение · единственный с приложением" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  m0: "Э14.1 Главная\nсвой рейтинг и место · ближайший турнир ·\nмой матч" { class: step }
  m1: "Э14.2 Календарь\nпо каждому старту видно, как попасть" { class: step }
  m2: "Какая категория?" { class: decide }
  m3: "Чемпионаты и Кубок РК\n«состав подаёт регион»" { class: muted }
  m4: "Евразийская лига\n«вы заявлены за команду»" { class: muted }
  m5: "Э14.3 Открытый республиканский\nКНОПКА «ЗАЯВИТЬСЯ»\nразряд · документы · плата" { class: rbac }
  m6: "Клубный\nКНОПКА «ЗАПИСАТЬСЯ» — без рассмотрения" { class: rbac }
  m7: "Э14.4 Моя заявка\nподана · принята · отклонена с причиной" { class: step }
  m8: "Э14.5 Мой турнир и матч\nсоперник · стол · когда выходить" { class: step }
  m9: "Счёт ведёт судья\nспортсмен не вводит и не подтверждает" { class: block }
  m10: "Турнир завершён — новый рейтинг\nуведомление в приложение" { class: good }
  m11: "Э14.6 Аналитика · Э14.7 Профиль\nматчи · винрейт · личные встречи ·\nвзнос · расширенная — платная" { class: step }

  m0 -> m1 -> m2
  m2 -> m3
  m2 -> m4
  m2 -> m5
  m2 -> m6
  m5 -> m7
  m6 -> m7
  m7 -> m8 -> m9
  m8 -> m10 -> m11
}

# ── Посетитель ───────────────────────────────────────────────────────────────
r0: "БЕЗ ВХОДА В СИСТЕМУ\nроли нет" {
  style.fill: "#f9fafb"
  style.stroke: "#9ca3af"

  n0: "Открыл сайт" { class: start }
  n1: "Э0.4 Рейтинг игроков с фильтрами\nрейтинг судей" { class: step }
  n2: "Э0.4 Страница турнира\nсостав · сетка · расписание · результаты\nсчёт в реальном времени" { class: step }
  n3: "Новости, анонсы, трансляция" { class: step }
  n4: "Дальше — только через регистрацию" { class: block }

  n0 -> n1
  n0 -> n2
  n0 -> n3
  n2 -> n4 { class: loop }
}
