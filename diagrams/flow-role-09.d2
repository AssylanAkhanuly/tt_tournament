...@_theme

direction: down

# Роль 9 · Судья — поэкранный флоу.
# СГЕНЕРИРОВАНО: npm run gen:diagrams (design/scripts/gen-flow-diagrams.mjs).
# Содержание — flows/09-sudya.md; руками этот файл не правим.
#
# Как читать: контейнер — экран (код Э№.№ в заголовке), внутри
#   синее   — зона экрана: из чего он состоит
#   жёлтое  — действие: что нажимает и когда
#   серое   — состояние экрана или открытый вопрос
#   красное — блокировка, отказ, «нельзя»

head: "9 · СУДЬЯ\nВедение матчей, внесение результатов, подтверждение\nсыгранных встреч (TZ §2).\nУстройство: адаптивный сайт, обычно планшет за столом;\nработает и с телефона · область: турниры, где судья в\nнаряде; на матче — свой стол" { class: rbac }

s1: "Э9.1 · Мои турниры" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Первый экран после входа" { class: start }
  z1: "Мои назначения\n• Турниры, где судья в наряде\n• Название\n• Город\n• Даты\n• Моя роль — судья стола N / секретарь /\nзаместитель\n• Состояние турнира" { class: step }
  z2: "Открыт приём заявок на судейство ⚠\n• ⚠ 12.6 — зона нужна, только если конкурс\nзаявок сохраняется, а не прямое назначение\nсудьи\n• Список официальных стартов в состоянии\n«Приём заявок судей»\n• Название\n• Город\n• Даты\n• Приём до\n• Состояние моей заявки — не подана / подана /\nотклонена с причиной" { class: step }
  a1: "«Подать заявку на судейство» ⚠\nкогда: турнир в состоянии «Приём заявок\nсудей»\n→ Заявка уходит председателю ГСК (Э5.2);\nрешение придёт уведомлением" { class: rbac }
  a2: "«Подать снова»\nкогда: после отказа, пока приём открыт\n→ Видна причина отказа" { class: rbac }
  a3: "Строка назначения\nкогда: всегда\n→ Открывает мой стол" { class: rbac }
  st1: "Назначений нет\nПустое состояние со списком открытых\nприёмов." { class: muted }
  st2: "Заявки на судейство или прямое назначение — не решено\n⚠ 12.6: сохраняется ли конкурс заявок. От\nответа зависит, есть ли на экране вторая\nзона и кнопка подачи." { class: muted }
}

s2: "Э9.2 · Мой стол" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э9.1 Мои турниры — строка назначения\n• Уведомление «пара вызвана на стол»" { class: start }
  z1: "Шапка\n• Турнир\n• Номер моего стола\n• День" { class: step }
  z2: "Текущий матч\n• Оба игрока — имя, регион или клуб\n• Круг сетки\n• Регламент матча — до скольких побед в\nпартиях\n• Счёт по партиям, если матч уже идёт" { class: step }
  z3: "Очередь моего стола\n• Следующие матчи — пары и плановое время" { class: step }
  z4: "Индикатор вызова\n• Главный судья вызвал пару — карточка матча с\nкнопкой" { class: step }
  a1: "«Принять вызов пары»\nкогда: пара вызвана\n→ Подтверждает готовность стола; открывается\nввод счёта" { class: rbac }
  a2: "«Отметить неявку» ✳\nкогда: пара вызвана, игрок не пришёл\n→ Главному судье — на решение о технической\nпобеде (Э6.6); неявка судьи при заявке — −1\nбалл S1 (TZ §7.2)" { class: rbac }
  st1: "Матча нет — «стол свободен»\nПоказываем очередь стола." { class: muted }
  st2: "На турнире включён режим по очкам\nОб этом сказано в карточке матча заранее." { class: muted }
}

s3: "Э9.3 · Ввод счёта\nЭкран строится под палец и скорость: крупные цифры,\nминимум элементов, работа одной рукой (TZ §6)." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• После принятия вызова (Э9.2)\n• Из Э9.2 для идущего матча" { class: start }
  z1: "Две крупные кнопки-половины — по игроку на каждой ✳\n• Имя игрока\n• Счёт в текущей партии огромными цифрами\n• Счёт по партиям\n• Индикатор подачи — у кого подача; смена\nотмечается автоматически по счёту ✳" { class: step }
  z2: "Полоса управления ✳\n• Отмена последнего действия\n• Смена сторон\n• Пауза ✳" { class: step }
  z3: "Индикатор синхронизации\n• Связь есть\n• «N событий в очереди» при обрыве" { class: step }
  z4: "Режим — задаёт главный судья турнира (TZ §6.1–6.2)\n• По очкам — каждый тап +1 очко, счёт уходит в\nпрямой эфир и на трансляцию\n• По партиям — форма итога партии (счёт очков\nв партии), итог матча вычисляется из партий\nи вручную не задаётся" { class: step }
  a1: "«+1 очко стороне»\nкогда: матч идёт, режим по очкам\n→ Счёт в эфир; каждое очко хранится для\nаналитики и трансляции" { class: rbac }
  a2: "«Записать партию»\nкогда: матч идёт, режим по партиям\n→ Партия в счёт матча" { class: rbac }
  a3: "«Отменить последнее»\nкогда: матч идёт\n→ Точечная отмена очка или партии; в журнал" { class: rbac }
  a4: "«Смена сторон / подачи»\nкогда: по регламенту\n→ Фиксируется событием" { class: rbac }
  a5: "«Подтвердить результат»\nкогда: матч сыгран\n→ Результат уходит главному судье и в базу;\nсетка продвигается; дальше правит только\nглавный судья" { class: rbac }
  a6: "«История» — свайп или кнопка ✳\n→ Лента событий матча, только просмотр (из\nраздела Э9.4 «как попадает»)" { class: rbac }
  st1: "Обрыв связи\nВвод продолжается локально, счётчик очереди\nрастёт; после восстановления события уходят\nпо порядку." { class: muted }
  st2: "Расхождение после синхронизации\nПриоритет у судьи стола — он видит игру (TZ\n§12)." { class: muted }
  st3: "Подтверждение при обрыве\nРезультат уйдёт после синхронизации ✳." { class: muted }
}

s4: "Э9.4 · История матча" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Из Э9.3 — свайп или кнопка «история» ✳" { class: start }
  z1: "Лента событий матча по времени\n• Розыгрыши — кто взял очко\n• Закрытые партии со счётом\n• Смены сторон и подачи\n• Отмены\n• Паузы\nДля режима по партиям — только партии и\nсобытия." { class: step }
  a1: "Просмотр ленты\nкогда: всегда\n→ Только просмотр; исправление задним числом\n— через главного судью" { class: rbac }
}

s5: "Э9.5 · Мой рейтинг судьи" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Пункт меню «Мой рейтинг»" { class: start }
  z1: "R и место\n• R и место\n• Разбивка S1–S4\n• Признак зачёта — нужны баллы в трёх\nкатегориях из четырёх и обязательные S1 и S2\n• Напоминание: S1, S3, S4 обнуляются с нового\nгода, S2 остаётся (TZ §7.2)" { class: step }
  z2: "Журнал моих начислений\n• Дата\n• За что\n• Баллы\n• Коэффициент" { class: step }
  z3: "Мои документы\n• Тип — семинар, курс, награда, категория\n• Дата подачи\n• Состояние — на проверке / принят с баллами /\nотклонён с причиной" { class: step }
  z4: "Апелляция\n• После публикации рейтинга — окно 10 дней: до\nкакого числа\n• Форма: что оспариваю — документ, начисление,\nкоэффициент; обоснование\n• Состояние поданной — на рассмотрении (до 10\nрабочих дней) / решение" { class: step }
  a1: "«Загрузить документ» ⚠\nкогда: всегда\n→ Файл + тип; уходит на проверку\nпредседателю ГСК (Э5.6); ⚠ последствие\nподачи позже 10 дней не определено" { class: rbac }
  a2: "«Подать апелляцию»\nкогда: 10 дней после публикации\n→ Уходит комиссии; обоснованная → пересчёт;\nрешение окончательное" { class: rbac }
  st1: "Окно апелляции закрыто\nФормы нет, только история решений." { class: muted }
}

head -> s1
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s5

no: "ЧЕГО РОЛЬ НЕ МОЖЕТ\n• Менять сетку и расписание\n• Вводить счёт на чужом столе\n• Исправлять счёт после подтверждения — правка идёт\nчерез главного судью" { class: block }
s5 -> no { class: loop }
q: "ОТКРЫТЫЕ ВОПРОСЫ К ФЕДЕРАЦИИ\n• 12.6 — сохраняется ли конкурс заявок на судейство\nили судью назначают напрямую\n• Последствие подачи документа на рейтинг позже 10\nдней не определено" { class: muted }
s5 -> q { class: loop }
