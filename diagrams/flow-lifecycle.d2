...@_theme

direction: right

# Жизненный цикл турнира по ФНТ ТЗ v1.5 — сквозной сценарий через все роли.
# ПСК — председатель судейской коллегии, ГС — главный судья турнира,
# СС — судья стола.
#
# Два шлагбаума коллегии: система проведения утверждается ДО публикации,
# итоговый протокол ПОСЛЕ игры. Первый решает, состоится ли турнир в таком
# виде, второй решает, попадёт ли он в рейтинг. В обоих случаях решение
# принимает судья, а председатель его утверждает.

create: "ПСК: заводит турнир\nназвание · уровень · город · окно дат" { class: step }
openRef: Приём заявок судей { class: step }
refApply: "Судья: заявка на судейство" { class: step }
pickRef: "ПСК: выбирает судью\nрейтинг · категория · история" { class: step }

organize: "ГС: выбирает систему проведения\nформат · дисциплина · расписание · столы" { class: step }
gateOrg: "ПСК: система проведения утверждена?" { class: decide }
rework: "Возврат с причиной\nбез утверждения турнир не публикуется" { class: block }

publish: "Турнир опубликован\nоткрыт приём заявок игроков" { class: step }
coach: "Тренер: заявка со списком" { class: step }
self: "Игрок: заявка сам" { class: step }
review: "ГС: заявка одобрена?" { class: decide }
reject: Отказ с причиной { class: block }
squad: Игроки в составе { class: good }

tables: "ГС: назначает судей столов" { class: step }
gate: У каждого стола есть судья? { class: decide }
blocked: "Старт заблокирован\nбез судьи стол не принимает матчи" { class: block }

seed: "ГС: посев и запуск" { class: step }
bracket: "ДВИЖОК: сетка и распределение по столам" { class: engine }

play: "СС: ведёт матч\nрозыгрыши, партии, подача, смена сторон" { class: step }
live: "Счёт в реальном времени\nзрители, гости, YouTube-трансляция" { class: live }
advance: "ДВИЖОК: продвигает победителя" { class: engine }
more: Остались матчи? { class: decide }

close: "ГС: формирует итоговый протокол\nввод результатов заблокирован" { class: step }
gateRes: "ПСК: итоговый протокол утверждён?" { class: decide }
fix: "Возврат с причиной\nввод открыт, судья исправляет" { class: block }

ratings: "РАСЧЁТ РЕЙТИНГА: по заложенной методике" {
  style: { fill: "#fffbeb"; stroke: "#f59e0b"; stroke-width: 2 }
}
result: "Игрок видит результат и новую аналитику" { class: good }

create -> openRef
openRef -> refApply
refApply -> pickRef
pickRef -> organize

organize -> gateOrg
gateOrg -> rework: нет { class: back }
rework -> organize { class: back }
gateOrg -> publish: да

publish -> coach
publish -> self
coach -> review
self -> review
review -> reject: нет { class: back }
reject -> publish { class: back }
review -> squad: да

squad -> tables
tables -> gate
gate -> blocked: нет { class: back }
blocked -> tables { class: back }
gate -> seed: да
seed -> bracket
bracket -> play
play -> live: в реальном времени { class: loop }
play -> advance
advance -> more
more -> play: да { class: loop }
more -> close: нет

close -> gateRes
gateRes -> fix: нет { class: back }
fix -> close { class: back }
gateRes -> ratings: да
ratings -> result
