...@_theme

direction: down

# Роль 7 · Главный секретарь соревнований — поэкранный флоу.
# СГЕНЕРИРОВАНО: npm run gen:diagrams (design/scripts/gen-flow-diagrams.mjs).
# Содержание — flows/07-glavnyy-sekretar.md; руками этот файл не правим.
#
# Как читать: контейнер — экран (код Э№.№ в заголовке), внутри
#   синее   — зона экрана: из чего он состоит
#   жёлтое  — действие: что нажимает и когда
#   серое   — состояние экрана или открытый вопрос
#   красное — блокировка, отказ, «нельзя»

head: "7 · ГЛАВНЫЙ СЕКРЕТАРЬ СОРЕВНОВАНИЙ\nЖеребьёвка, сетки, расписание, протоколы (TZ §2).\nУстройство: десктоп · область: один турнир" { class: rbac }

s1: "Э7.1 · Рабочий стол секретаря" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Первый экран после входа" { class: start }
  z1: "Шапка турнира\n• Название\n• Даты\n• Состояние — шкала §4.3" { class: step }
  z2: "Список работ с состоянием готовности\n• Жеребьёвка — проведена / нет\n• Сетка — собрана / нет\n• Расписание — составлено / нет\n• Протокол — оформлен / нет\nКаждая строка — переход на свой экран." { class: step }
  z3: "Решение судьи — чтение ✳\n• Выбранный судьёй формат\n• Вводные турнира\nСекретарь работает по решению судьи ✳." { class: step }
  a1: "Строка «Жеребьёвка»\nкогда: «Система проведения»\n→ Открывает жеребьёвку" { class: rbac }
  a2: "Строка «Сетка»\nкогда: «Система проведения», после\nжеребьёвки\n→ Открывает сборку сетки" { class: rbac }
  a3: "Строка «Расписание»\nкогда: «Система проведения»\n→ Открывает расписание" { class: rbac }
  a4: "Строка «Протокол»\nкогда: «Итоговый протокол», когда матчи\nсыграны\n→ Открывает протоколы" { class: rbac }
  st1: "До «Системы проведения» работы закрыты\nПояснение «идёт приём заявок»; экрана заявок\nу секретаря нет." { class: muted }
}

s2: "Э7.2 · Жеребьёвка" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э7.1" { class: start }
  z1: "Состав участников — чтение\n• Берётся из принятых заявок\n• ФИО\n• Рейтинг\n• Регион / клуб" { class: step }
  z2: "Способ распределения\n• Переключатель «жребий / посев по рейтингу»" { class: step }
  z3: "Предпросмотр посева\n• Кто на каком номере\n• Почему именно так — по рейтингу" { class: step }
  z4: "Жребий\n• Кнопка жеребьёвки\n• Результат распределения по слотам" { class: step }
  a1: "«Провести жеребьёвку» ⚠\nкогда: «Система проведения»\n→ Распределение по слотам; результат идёт\nглавному судье ⚠ — кто отвечает, если судья\nне согласен, не подтверждено" { class: rbac }
  a2: "«Перебросить жребий» ✳\nкогда: пока сетка не утверждена судьёй\n→ Прежний результат уходит в журнал" { class: rbac }
}

s3: "Э7.3 · Сетка — сборка ⚠\nТо же, что у судьи в Э6.3 (вводные, подсказка системы,\nконструктор), но формат уже выбран судьёй — секретарь\nсобирает по нему. Наше чтение границы: секретарь делает,\nсудья утверждает ⚠ — может ли секретарь публиковать\nсетку без судьи, надо подтвердить." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э7.1, после жеребьёвки" { class: start }
  z1: "Вводные и конструктор — как в Э6.3 у судьи\n• Вводные турнира\n• Подсказка системы по формату\n• Конструктор сетки\n• Формат уже выбран судьёй — секретарь\nсобирает по нему" { class: step }
  z2: "Предпросмотр сетки\n• Дерево\n• Или таблица групп" { class: step }
  a1: "«Собрать сетку» ⚠\n→ Движок строит сетку; готовая сетка уходит\nглавному судье на утверждение ⚠ (секретарь\nделает, судья утверждает — граница не\nподтверждена)" { class: rbac }
}

s4: "Э7.4 · Расписание\nТо же, что Э6.4 у главного судьи: и состав экрана, и\nдействия." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э7.1" { class: start }
  z1: "Сетка расписания — как в Э6.4\n• Дни × столы\n• Карточки матчей\n• Конфликты подсвечены" { class: step }
  z2: "Граница с судьёй ✳\n• Секретарь расставляет, судья проверяет" { class: step }
  a1: "Расстановка матчей — действия те же, что в Э6.4 ✳\n→ Секретарь расставляет матчи по дням и\nстолам, судья проверяет ✳" { class: rbac }
}

s5: "Э7.5 · Протоколы" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э7.1, когда матчи сыграны" { class: start }
  z1: "Итоговый протокол в работе\n• Таблица результатов и мест\n• Поля оформления: даты, подписи, состав\nбригады" { class: step }
  z2: "Протоколы отдельных матчей\n• Список протоколов по матчам" { class: step }
  a1: "«Оформить протокол»\nкогда: «Итоговый протокол»\n→ Секретарь заполняет и передаёт главному\nсудье — на утверждение отправляет судья\n(Э6.7)" { class: rbac }
  a2: "«Печать»\nкогда: после закрытия\n→ Итоговый протокол и протоколы матчей" { class: rbac }
  st1: "Протокол возвращён коллегией\nСекретарь видит причину и правит оформление;\nисправление результатов — только через\nсудью." { class: muted }
}

head -> s1
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s5

no: "ЧЕГО РОЛЬ НЕ МОЖЕТ\n• Рассматривать заявки — решение по заявке принимает\nглавный судья\n• Вызывать пары и править счёт: ход турнира — только\nпросмотр ✳\n• Публиковать сетку без судьи ⚠" { class: block }
s5 -> no { class: loop }
q: "ОТКРЫТЫЕ ВОПРОСЫ К ФЕДЕРАЦИИ\n• Граница «судья решает, секретарь оформляет» не\nподтверждена: в документе у судьи — «утверждение\nсеток», у секретаря — «сетки» ⚠\n• Может ли секретарь публиковать сетку без утверждения\nглавного судьи\n• Кто отвечает, если главный судья не согласен с\nрезультатом жеребьёвки" { class: muted }
s5 -> q { class: loop }
