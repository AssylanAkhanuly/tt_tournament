...@_theme

direction: down

# Микрофлоу роли «Бухгалтер» (ФНТ ТЗ v1.5).
# Взнос платится картой в системе, состояние ставится автоматически по
# подтверждению банка (TZ §9.2) — бухгалтер разбирает только исключения.
#
# Красным — блокировка: заявка от участника с неоплаченным взносом не проходит.
# Это допущение с нашей стороны, у заказчика не подтверждено (QUESTIONS 6).

login: Вход { class: start }
registry: "Реестр взносов за год\nучастник · состояние · дата · как оплачен" { class: step }
filter: "Фильтр: не оплачено и просрочено" { class: step }
check: "Смотрит платежи без подтверждения банка" { class: step }
paid: Платёж пришёл мимо системы? { class: decide }
mark: "Отмечает оплату вручную\nс основанием и автором" { class: good }
overdue: "Состояние: просрочен\nзаявки не проходят" { class: block }
visible: "Состояние видно участнику и его тренеру" { class: good }
gate: "БЛОКИРОВКА: заявка от неоплатившего не проходит" { class: block }
done: Реестр в актуальном состоянии { class: good }

login -> registry
registry -> filter
filter -> check
check -> paid
paid -> mark: да
paid -> overdue: нет { class: back }
overdue -> gate { class: back }
mark -> visible
overdue -> visible { class: back }
visible -> done
