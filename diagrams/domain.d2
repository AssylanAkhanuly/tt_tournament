direction: down

# Доменная модель. Ключевое:
#   ROLE  — не флаг на пользователе, а связка «пользователь → роль → область»
#   GAME  — партия; MATCH счёт НЕ хранит, 3:1 это производная
#   RALLY — розыгрыш; без него нет ленты и точечной отмены
#   RALLY.at_device — время НА УСТРОЙСТВЕ: после офлайна очередь уходит пачкой,
#                     и по серверному времени порядок розыгрышей развалится

classes: {
  core: {style.fill: "#eff6ff"; style.stroke: "#3b82f6"}
  new: {style.fill: "#d1fae5"; style.stroke: "#10b981"; style.stroke-width: 2}
  audit: {style.fill: "#fee2e2"; style.stroke: "#ef4444"; style.stroke-width: 2}
}

user: USER {
  shape: sql_table
  class: core
  id: uuid {constraint: primary_key}
  # ИИН — чем человек входит (решение 30.08.2026): личность подтверждает
  # Smart Bridge по ИИН и одноразовому коду, пароля в системе нет и хранить
  # его негде. ИИН один на человека, поэтому он же ключ связывания с уже
  # заведённой карточкой — точное совпадение вместо поиска «похожего» по ФИО.
  iin: "string — 12 цифр, чем человек входит; пароля в системе нет" {constraint: unique}
  name: string
  # На этот номер уходит одноразовый код; он привязан к ИИН на стороне
  # государства, в профиле показывается маской и не правится.
  phone: string {constraint: unique}
  city: string
  photo_url: string
  club_id: uuid {constraint: foreign_key}
  rating: int
}

role: ROLE {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: uuid {constraint: foreign_key}
  kind: "четырнадцать ролей, см. ТЗ §2 (перечень федерации)"
  scope: "система | турнир | клуб | стол"
  scope_id: uuid
}

club: CLUB {
  shape: sql_table
  class: core
  id: uuid {constraint: primary_key}
  name: string
  city: string
}

# Шаблон регламента. Пресеты «Официальный» и «Клубный» живут ДАННЫМИ, а не в
# коде: строки этой таблицы. При создании турнира шаблон КОПИРУЕТ свои значения
# в поля турнира (см. ниже) — правка шаблона потом НЕ меняет уже созданные
# турниры, и турнир можно донастроить поверх пресета. Гейт полномочий: значения
# rating_pool=official, approval_by=collegium, judge_appointed_by=collegium
# допустимы только в системных шаблонах федерации (is_system, owner пустой).
tournament_template: TOURNAMENT_TEMPLATE {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  name: "«Официальный республиканский» | «Клубный» | своё"
  kind: "официальный | клубный — класс полномочий, гейтит допустимые значения"
  is_system: "bool — встроенный пресет федерации"
  owner_id: "uuid — пусто = глобальный; иначе кастомный шаблон организатора" {constraint: foreign_key}

  # Значения политик по умолчанию — та же схема, что у турнира.
  approval_by: "none | collegium"
  judge_appointed_by: "organizer | collegium"
  rating_pool: "none | internal | official"
  fee_model: "none | entry_fee | annual_membership"
  default_entry_fee: int
  needs_table_referees: bool
  needs_documents: bool
  rating_limit: string
}

tournament: TOURNAMENT {
  shape: sql_table
  class: core
  id: uuid {constraint: primary_key}
  name: string
  template_id: "uuid — из какого шаблона засеян регламент" {constraint: foreign_key}
  govtype: "официальный | клубный — копия kind шаблона, денормализация под фильтр"
  city: string
  format: "олимпийка | круговая | швейцарка"
  discipline: "одиночный | парный | командный"
  status: "состояния, см. ТЗ §4.3"
  games_to_win: int
  starts_at: datetime

  # Категория календаря ФНТ РК (ТЗ §4.1). Определяет, КТО подаёт заявку (§8.2):
  # старший тренер региона | администратор клуба | сам игрок. Это НЕ то же, что
  # govtype: govtype — кто заводит и утверждает, category — чей это старт.
  category: "главный республиканский | евразийская лига | открытый республиканский | клубный"
  gender: "мужской | женский | смешанный"

  # Скользящая возрастная граница (ТЗ §4.1): хранится ГОД РОЖДЕНИЯ и сезон, а не
  # строка в названии. Каждый сезон граница +1 (2007 → 2008 → …), название вида
  # «… 2008 г.р. и моложе» строится из этих двух полей.
  season: "int — сезон календаря"
  age_max_birth_year: "int — «этого г.р. и моложе»; пусто = без ограничения"

  # Политики — ИСТОЧНИК ПРАВДЫ поведения. Шаблон засевает их при создании,
  # дальше это собственные поля турнира. Код ветвится по approval_by /
  # rating_pool / …, а НЕ по govtype. Клубная «лига» и «любительский» — это один
  # и тот же клубный турнир с разным набором значений, а не отдельные категории
  # (республиканская Евразийская лига — другое, см. командную ветку ниже).
  approval_by: "none | collegium — кто утверждает систему и протокол"
  judge_appointed_by: "organizer | collegium — кто назначает главного судью"
  rating_pool: "none | internal | official — куда идёт результат"
  fee_model: "none | entry_fee | annual_membership — модель денег"
  entry_fee: "int — сумма, если fee_model = entry_fee"
  needs_table_referees: "bool — судьи на столах"
  needs_documents: "bool — документы к заявке"
  rating_limit: "string — ценз по рейтингу, если задан"
}

# Одна таблица на оба конкурса: на главного судью и на судейство столов.
# Различаются они тем, КТО рассматривает (коллегия либо главный судья) и
# сколько человек берут — а не структурой заявки. Набор судей столов пока
# наше допущение (QUESTIONS 12).
referee_application: REFEREE_APPLICATION {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  user_id: "uuid — судья-заявитель" {constraint: foreign_key}
  kind: "главный судья | секретарь | зам | судья"
  status: "подана | принята | отклонена"
  reject_reason: string
  decided_by: "uuid — коллегия или главный судья" {constraint: foreign_key}
}

# Годовой взнос. Отдельная сущность, а не флаг на игроке: у взноса свой год и
# своя дата оплаты. Платится картой через эквайринг Халык Банка (ePay), статус
# ставится автоматически по подтверждению банка (TZ §9.2).
# provider_ref — reference платежа ePay и ключ идемпотентности: банк присылает
# подтверждение повторно, без уникальности повтор оплатит взнос дважды.
# marked_by заполняется ТОЛЬКО при ручной отметке-исключении (платёж мимо
# системы, возврат, спор).
fee: MEMBERSHIP_FEE {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: uuid {constraint: foreign_key}
  year: "int — календарный или сезон, вопрос (Q 6.2)"
  status: "оплачен | не оплачен | просрочен"
  paid_at: datetime
  paid_via: "epay | вручную"
  provider_ref: "string — reference ePay, уникален"
  marked_by: "uuid — только для отметки вручную" {constraint: foreign_key}
  marked_reason: "string — основание ручной отметки"
}

# Плата ЗА КОНКРЕТНЫЙ ТУРНИР — отдельно от годового взноса. Её ставит
# администратор клуба, и она есть в т.ч. на любительских турнирах. Годовой взнос
# (MEMBERSHIP_FEE) — членство в федерации; эта плата — вход в один турнир.
payment: TOURNAMENT_PAYMENT {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  user_id: uuid {constraint: foreign_key}
  amount: "int — плата за этот турнир"
  status: "оплачено | не оплачено"
  paid_at: datetime
  marked_by: "uuid — администратор клуба" {constraint: foreign_key}
}

table_: TOURNAMENT_TABLE {
  shape: sql_table
  class: core
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  number: int
  referee_id: uuid {constraint: foreign_key}
}

application: APPLICATION {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  club_id: "uuid — пусто, если игрок сам" {constraint: foreign_key}
  submitted_by: uuid {constraint: foreign_key}
  source: "клуб | игрок сам"
  status: "подана | принята | отклонена"
  reject_reason: string
}

application_item: APPLICATION_ITEM {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  application_id: uuid {constraint: foreign_key}
  user_id: uuid {constraint: foreign_key}
}

entry: ENTRY {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  player1_id: uuid {constraint: foreign_key}
  player2_id: "uuid — пусто в одиночке" {constraint: foreign_key}
  seed: int
  place: int
  attended: "bool — вышел на игру; неявка учитывается по регламенту (сверка явки → рейтинг)"
}

# ——— Евразийская лига: командная ветка (ТЗ §4.10) ———
# Участник соревнования здесь не игрок, а КОМАНДА клуба. Личный турнир этой
# ветки не касается: у него team_match_id пустой. Правила встречи, очков и
# переходов между лигами пока не получены от федерации (QUESTIONS 11.1–11.4),
# поэтому здесь только каркас: дивизион → тур → командная встреча → личные матчи.
division: LEAGUE_DIVISION {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  season: "int — сезон"
  gender: "мужской | женский — розыгрыши раздельные"
  name: "Суперлига | 2 лига … 6 лига"
  level: "int — 1 = Суперлига; мужских 6, женских 2"
}

tour: LEAGUE_TOUR {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  division_id: uuid {constraint: foreign_key}
  number: "int — тур 1..4 за сезон"
  city: string
  starts_at: datetime
}

team: TEAM {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  club_id: "uuid — команду заявляет клуб" {constraint: foreign_key}
  division_id: "uuid — в какой лиге играет в этом сезоне" {constraint: foreign_key}
  name: string
  submitted_by: "uuid — администратор клуба (ТЗ §2)" {constraint: foreign_key}
}

# Состав. tour_id пустой = заявлен на весь сезон; иначе состав на конкретный тур
# (от тура к туру он может меняться — QUESTIONS 11.4).
team_member: TEAM_MEMBER {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  team_id: uuid {constraint: foreign_key}
  user_id: uuid {constraint: foreign_key}
  tour_id: "uuid — пусто = на сезон" {constraint: foreign_key}
}

# Встреча «команда против команды». Счёт (4:2) — производная от личных матчей
# внутри, как MATCH не хранит 3:1. Схема встречи — QUESTIONS 11.1.
team_match: TEAM_MATCH {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tour_id: uuid {constraint: foreign_key}
  team_a_id: uuid {constraint: foreign_key}
  team_b_id: uuid {constraint: foreign_key}
  status: "ожидает | идёт | завершена"
  winner_team_id: uuid {constraint: foreign_key}
}

match: MATCH {
  shape: sql_table
  class: core
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  team_match_id: "uuid — личная встреча внутри командной; пусто на личном турнире" {constraint: foreign_key}
  table_id: uuid {constraint: foreign_key}
  round: "1/8 | 1/4 | финал"
  side_a_id: uuid {constraint: foreign_key}
  side_b_id: uuid {constraint: foreign_key}
  serving_player_id: uuid {constraint: foreign_key}
  status: "ожидает | идёт | завершён"
  winner_side_id: uuid {constraint: foreign_key}
  is_walkover: bool
}

game: GAME {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  match_id: uuid {constraint: foreign_key}
  number: "номер партии 1..5"
  score1: int
  score2: int
  status: "идёт | завершена"

  # Кто вводил счёт: судья стола (официальный) либо главный судья (клубный).
  # На клубных победитель называет результат главному судье, тот вводит —
  # ввода игроком и подтверждения соперником НЕТ (по замечанию Андрея).
  entered_by: uuid {constraint: foreign_key}
  entry_source: "судья стола | главный судья"
}

rally: RALLY {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  game_id: uuid {constraint: foreign_key}
  number: int
  won_by: uuid {constraint: foreign_key}
  at_device: "datetime — время НА УСТРОЙСТВЕ"
  entered_by: uuid {constraint: foreign_key}
}

match_event: MATCH_EVENT {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  match_id: uuid {constraint: foreign_key}
  kind: "смена сторон | смена подачи"
  recorded_by: uuid {constraint: foreign_key}
  at: datetime
}

score_log: SCORE_LOG {
  shape: sql_table
  # Не class: audit. У sql_table d2 красит ШАПКУ цветом fill, а ТЕЛО строк —
  # цветом stroke, то есть наоборот по сравнению с обычным узлом. С классом
  # audit (fill светлый, stroke насыщенный) строки заливались #ef4444 и текст
  # в них не читался. Здесь цвета заданы под эту особенность: насыщенная
  # шапка, светлые строки. Сам класс в теме не трогаем — он для цилиндров.
  style: { fill: "#ef4444"; stroke: "#fee2e2"; stroke-width: 2 }
  id: uuid {constraint: primary_key}
  match_id: uuid {constraint: foreign_key}
  author_id: uuid {constraint: foreign_key}
  at: datetime
  before: string
  after: string
  reason: "правка судьи | переопределение"
}

rating_point: RATING_POINT {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: uuid {constraint: foreign_key}
  kind: "игрок | судья"
  tournament_id: uuid {constraint: foreign_key}
  value: "int — методика не определена (Q 5.1)"
  change: "int — например +24"
  at: datetime
}

# Обе таблицы появились после ревизии дизайна: на схеме архитектуры была
# «лента уведомлений» и «регистрация токена», а хранилища под ними — не было.
notification: NOTIFICATION {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: uuid {constraint: foreign_key}
  kind: "семь событий, см. ТЗ §10.1"
  title: string
  body: string
  created_at: datetime
  read_at: "datetime — пусто, пока не открыто"
}

push_token: PUSH_TOKEN {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: uuid {constraint: foreign_key}
  token: "string — токен Expo, один формат на обе ОС"
  platform: "ios | android"
  created_at: datetime
  revoked_at: "datetime — выход или DeviceNotRegistered"
}

# Новости и анонсы — тип страницы Wagtail (готовый CMS, написан на Django),
# в том же PostgreSQL и без отдельного сервиса. Редактор, черновики, расписание,
# ревизии, мультиязык — из коробки; медиа (обложки) — в R2. kind различает
# новость и анонс: у анонса pinned, он может быть про турнир (tournament_id) и
# уйти пушем — хук публикации Wagtail ставит воркеру задачу, тот кладёт
# NOTIFICATION подписчикам.
news: NEWS_POST {
  shape: sql_table
  class: new
  id: "uuid — Wagtail Page" {constraint: primary_key}
  kind: "новость | анонс"
  title: "string — Wagtail"
  slug: "string — Wagtail" {constraint: unique}
  cover_key: "string — обложка: медиа-библиотека Wagtail → R2"
  body: "StreamField — текст, картинки, врезки"
  status: "черновик | опубликован (Wagtail live/draft)"
  pinned: "bool — закреплён (анонс)"
  tournament_id: "uuid — если анонс про турнир, иначе пусто" {constraint: foreign_key}
  author_id: "uuid — owner страницы (Wagtail)" {constraint: foreign_key}
  published_at: "datetime — go_live (Wagtail)"
  created_at: datetime
}

# Рейтинг судей (Положение ФНТ РК, утв. 02.02.2026). R = S1 + S2 + S3 + S4.
# S1 (судейство) и S2 (опорный балл за категорию) — начисляются автоматически;
# S3 (семинары) и S4 (иная деятельность) — через загрузку документов, проверяет
# комиссия. Рейтинг живой; активность (S1/S3/S4) сбрасывается ежегодно, категория
# (S2) остаётся. Апелляция — только ПОСЛЕ публикации рейтинга, окно 10 дней
# (JUDGE_APPEAL), а не при подаче документа.
judge_doc: JUDGE_DOCUMENT {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: "uuid — судья" {constraint: foreign_key}
  kind: "семинар (S3) | награда/коллегия (S4) | присвоение/смена категории"
  file_key: "string — скан в R2"
  event_at: "datetime — дата мероприятия"
  meta: "json — уровень, роль, «вне региона» (для расчёта баллов)"
  status: "на проверке | принят | отклонён"
  points: "int — начислено при приёме"
  reviewed_by: "uuid — комиссия / председатель ГСК" {constraint: foreign_key}
  rejected_at: "datetime — дата отклонения (уведомление; оспаривание — после публикации рейтинга)"
}

# Журнал начислений — источник живого рейтинга и аудит. Заменяет ручной журнал.
judge_score: JUDGE_SCORE {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: "uuid — судья" {constraint: foreign_key}
  year: "int — отчётный год (активность сбрасывается ежегодно)"
  category: "S1 | S2 | S3 | S4"
  source: "наряд/турнир (авто) | категория из профиля (авто) | документ | апелляция (пересчёт)"
  ref_id: "uuid — JUDGE_DUTY, JUDGE_DOCUMENT или JUDGE_APPEAL"
  points: "int — начислено (может быть отрицательным: неявка −1)"
  at: datetime
}

# Наряд судей на турнире — кто и в какой роли работал. Источник ЯВКИ судей
# (сверка после закрытия турнира) и автоматического начисления S1: роль и выезд
# задают коэффициент, неявка при заявке даёт −1.
judge_duty: JUDGE_DUTY {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  tournament_id: uuid {constraint: foreign_key}
  user_id: "uuid — судья" {constraint: foreign_key}
  role: "главный | зам | секретарь | судья стола — коэффициент S1"
  traveled: "bool — выезд в другой регион (влияет на S1)"
  attended: "bool — явился и отсудил (сверка явки)"
  no_show: "bool — заявлен, но не явился → S1 −1"
}

# Официальная публикация рейтинга — якорь окна апелляции. Рейтинг живой и всегда
# актуален, но именно ПУБЛИКАЦИЯ открывает 10-дневное окно оспаривания.
rating_pub: JUDGE_RATING_PUBLICATION {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  year: int
  published_at: "datetime — старт окна апелляции (10 дней)"
  note: "string — период / примечание"
}

# Апелляция на ОПУБЛИКОВАННЫЙ рейтинг (а не на отклонение документа при подаче).
# Открывается только после публикации, в течение 10 дней. Обоснованная →
# пересчёт: правка пишется в журнал (JUDGE_SCORE), рейтинг обновляется.
judge_appeal: JUDGE_APPEAL {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  user_id: "uuid — судья" {constraint: foreign_key}
  publication_id: "uuid — от какой публикации считается окно 10 дней" {constraint: foreign_key}
  subject: "отклонённый документ | начисление | коэффициент"
  ref_id: "uuid — спорный JUDGE_SCORE или JUDGE_DOCUMENT, если есть"
  reason: string
  status: "оспаривается | обоснованно (пересчёт) | отклонено"
  opened_at: datetime
  decided_by: "uuid — рейтинговая комиссия" {constraint: foreign_key}
  decided_at: "datetime — решение окончательное"
}

user.id -> role.user_id: имеет
user.club_id -> club.id
club.id -> application.club_id: подаёт
user.id -> application.submitted_by: автор
tournament_template.id -> tournament.template_id: засевает регламент
user.id -> tournament_template.owner_id: кастомный шаблон
tournament.id -> application.tournament_id: получает
tournament.id -> referee_application.tournament_id: конкурс судейства
user.id -> referee_application.user_id: судья подаёт
user.id -> fee.user_id: годовой взнос
user.id -> fee.marked_by: экономист отмечает
tournament.id -> payment.tournament_id: плата за турнир
user.id -> payment.user_id: платит за участие
user.id -> payment.marked_by: организатор отмечает
user.id -> news.author_id: автор публикации
tournament.id -> news.tournament_id: анонс про турнир
user.id -> judge_doc.user_id: судья подаёт документ
user.id -> judge_doc.reviewed_by: комиссия проверяет
user.id -> judge_score.user_id: баллы судьи
judge_doc.id -> judge_score.ref_id: документ → начисление
tournament.id -> judge_duty.tournament_id: наряд судей
user.id -> judge_duty.user_id: судья в наряде
judge_duty.id -> judge_score.ref_id: судейство S1 → начисление
user.id -> judge_appeal.user_id: судья оспаривает после публикации
rating_pub.id -> judge_appeal.publication_id: окно 10 дней от публикации
user.id -> judge_appeal.decided_by: комиссия решает
judge_appeal.id -> judge_score.ref_id: обоснованная апелляция → пересчёт
application.id -> application_item.application_id: список игроков
user.id -> application_item.user_id: заявлен
application_item.id -> entry.id: принята — создаёт сторону

club.id -> team.club_id: заявляет команду
user.id -> team.submitted_by: администратор клуба
division.id -> team.division_id: играет в лиге
division.id -> tour.division_id: четыре тура за сезон
team.id -> team_member.team_id: состав
user.id -> team_member.user_id: заявлен за команду
tour.id -> team_member.tour_id: состав на тур
tour.id -> team_match.tour_id: встречи тура
team.id -> team_match.team_a_id: сторона встречи
team_match.id -> match.team_match_id: личные встречи внутри

tournament.id -> table_.tournament_id
tournament.id -> entry.tournament_id: составы и посев
tournament.id -> match.tournament_id
user.id -> entry.player1_id: игрок стороны
user.id -> table_.referee_id: судья стола
entry.id -> match.side_a_id: сторона матча
table_.id -> match.table_id: проводит

match.id -> game.match_id: партии
game.id -> rally.game_id: розыгрыши
match.id -> match_event.match_id
match.id -> score_log.match_id
user.id -> score_log.author_id: автор правки
user.id -> rating_point.user_id
tournament.id -> rating_point.tournament_id

scoreboard: SCOREBOARD {
  shape: sql_table
  class: new
  id: uuid {constraint: primary_key}
  key: string {constraint: unique}
  title: string
  tournament_id: uuid {constraint: foreign_key}
  table_number: int
  rev: "версия; растёт на каждую запись — по ней ловим двух секретарей сразу"
  mode: "разряд встречи: одиночный | парный | командный"
  players: "фамилии и страны сторон; второе имя стороны — для парного разряда"
  score: "партии и очки текущей партии"
  team: "счёт командной встречи и названия команд — строка над игроками"
  first_server: "кто подавал первым в партии — текущий подающий выводится по счёту"
  cards: "жёлтая и красная у сторон"
  timeouts: "тайм-аут взят"
  visible: bool
  updated_at: datetime
}

user.id -> notification.user_id: лента событий
user.id -> push_token.user_id: устройства
tournament.id -> scoreboard.tournament_id: плашки столов в трансляции
