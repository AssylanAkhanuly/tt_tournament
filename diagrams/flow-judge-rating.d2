...@_theme

direction: down

# Микрофлоу «Рейтинг спортивных судей» — цифровая версия Положения ФНТ РК
# (утв. Исполкомом 02.02.2026). R = S1 + S2 + S3 + S4.
#
# Подтверждено федерацией:
#   • баллы за активность (S1/S3/S4) обнуляются каждый год, категория (S2) остаётся;
#   • балл за категорию — опорный, начисляется автоматически, пока категория есть.
#
# Отсюда два вида начислений:
#   • АВТОМАТИЧЕСКИ, без загрузок: S1 (судейство из турниров) и S2 (опорный балл
#     за действующую категорию из профиля).
#   • ЧЕРЕЗ ЗАГРУЗКУ документов: семинары (S3), награды/иная деятельность (S4)
#     и присвоение/смена категории. Комиссия проверяет.
# Рейтинг обновляется сразу и всегда актуален. Апелляция — только ПОСЛЕ публикации
# рейтинга, окно 10 дней (а не во время подачи документов).
# Итоги года нужны только для номинаций Gold/Silver/Bronze.

# ── начисляется автоматически (без загрузок) ────────────────────
tdone: "Турнир завершён" { class: start }
s1: "Система начисляет S1 · судейство\nбаллы по статусу турнира с коэффициентом\nза роль (гл. судья / зам / секретарь) и выезд\nнеявка при заявке −1" { class: engine }
cat: "Действующая категория судьи (в профиле)" { class: start }
s2: "Опорный балл S2 · за категорию\nначисляется автоматически, пока категория действует" { class: engine }

# ── через загрузку документов (S3, S4, смена категории) ─────────
cab: "Кабинет судьи · «Добавить документ»" { class: start }
pick: "Выбирает тип\nсеминар (S3) · награда / коллегия (S4) · присвоение или смена категории\nтип определяет баллы" { class: step }
upload: "Прикладывает файл\nдата · уровень (рег./респ.) · роль · выезд в другой регион" { class: step }
pending: "Статус: На проверке" { class: step }
review: "Рейтинговая комиссия / председатель коллегии\nсистема подсказывает баллы — комиссия подтверждает" { class: decide }
accepted: "Принят (+N баллов)\nдокумент о категории — обновляет профиль\nсудье приходит уведомление" { class: good }
rejected: "Отклонён (с причиной)\nсудье приходит уведомление\nоспорить можно после публикации рейтинга" { class: block }

# ── апелляция · только ПОСЛЕ ПУБЛИКАЦИИ рейтинга · окно 10 дней ──
appealq: "Судья оспаривает свой рейтинг?\nокно 10 дней после публикации\n(отклонённый документ · начисление · коэффициент)" { class: decide }
appealing: "Статус: Оспаривается" { class: step }
commrev: "Рейтинговая комиссия рассматривает апелляцию\n10 рабочих дней · решение окончательное" { class: decide }
fixed: "Обоснованно → пересчёт\nисправление вносится в журнал, рейтинг обновляется\nсудье приходит уведомление" { class: good }
stands: "Рейтинг остаётся без изменений\nнет апелляции за 10 дней или отказ обоснован\nсудье приходит уведомление" { class: block }

# ── журнал → рейтинг ────────────────────────────────────────────
ledger: "Журнал начислений\nкто · год · за что · категория · баллы\nпрозрачно, заменяет ручной журнал" { class: gate }
calc: "R = S1 + S2 + S3 + S4\nS1 и S2 обязательны · зачёт при ≥3 из 4 категорий\nпри равенстве: сначала S1, затем S2, S3, S4" { class: step }
live: "Рейтинг обновляется сразу\nвсегда актуальный" { class: live }
pub: "Публичная страница «Рейтинг судей 2026»\nоткрыта всем, в том числе без входа" { class: client }

# ── итоги года ──────────────────────────────────────────────────
yearend: "Итоги года\nGold / Silver / Bronze (топ-10 каждая) + спецноминации" { class: good }
newyear: "1 января · баллы за активность (S1/S3/S4) обнуляются\nкатегория (S2) остаётся" { class: muted }

# автоматические начисления
tdone -> s1
s1 -> ledger
cat -> s2
s2 -> ledger

# загрузка документов
cab -> pick
pick -> upload
upload -> pending
pending -> review
review -> accepted: подтверждено
review -> rejected: отклонено { class: back }
accepted -> ledger

# апелляция · только после публикации рейтинга (не во время подачи)
pub -> appealq: в течение 10 дней после публикации { class: loop }
appealq -> appealing: судья оспорил ≤ 10 дней
appealq -> stands: нет апелляции за 10 дней { class: back }
appealing -> commrev
commrev -> fixed: обоснованно
commrev -> stands: не обоснованно { class: back }
fixed -> ledger: пересчёт { class: loop }

# рейтинг
ledger -> calc
calc -> live
live -> pub
live -> yearend: конец года { class: loop }
live -> newyear: новый год { class: loop }
