...@_theme

direction: down

# ПОЛНЫЙ ХОД ТУРНИРА по ФНТ ТЗ v1.5 — одна связная схема.
#
# Разбивать её на отдельные схемы нельзя: теряется главное, то есть связь между
# этапами. Поэтому здесь всё в одном полотне, а читаемость держится на
# контейнерах: каждый этап — своя рамка, стрелки идут между рамками сквозь всю
# схему.
#
# Что показано помимо счастливого пути:
#   * три категории турнира (§4.1) и настройки, которые их переопределяют (§4.2)
#   * все возвраты: отказ по заявке судьи, по системе проведения, по заявке
#     игрока, по итоговому протоколу
#   * запись без документов на лигу и любительский (§8.1)
#   * проверка взноса — только если турнир её требует (§9.2)
#   * блокировка старта без судьи на столе — если судьи нужны (§4.2)
#   * два разных хода игры: со судьёй стола (§6) и без него, где счёт ведут
#     сами игроки — и открытые вопросы второго сценария
#   * push-уведомления в шести местах процесса (§10.1)
#   * обрыв связи у судьи стола (§12)

# ── 1. ЗАВЕДЕНИЕ ────────────────────────────────────────────────────────────
zavedenie: "1 · ЗАВЕДЕНИЕ ТУРНИРА" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  create: "Заводит турнир\nназвание · уровень · город · окно дат" { class: step }
  settings: "НАСТРОЙКИ ТУРНИРА\nсудьи на столах · взнос · документы · утверждения\nкатегория задаёт умолчания, но всё правится (§4.2)" { class: rbac }
  category: "Категория турнира?" { class: decide }
  resp: "РЕСПУБЛИКАНСКИЙ\nсудьи, взнос, документы, утверждения" { class: rbac }
  league: "ЛИГА\nвзнос нужен, без судей и документов" { class: step }
  amateur: "ЛЮБИТЕЛЬСКИЙ\nвход свободный: ни взноса, ни документов" { class: good }

  create -> settings
  settings -> category
  category -> resp: республиканский
  category -> league: лига
  category -> amateur: любительский
}

# ── 2. СУДЕЙСТВО ────────────────────────────────────────────────────────────
sudeystvo: "2 · РАСПРЕДЕЛЕНИЕ СУДЕЙСТВА · только республиканские" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  openRef: "Коллегия открывает приём заявок судей" { class: step }
  apply: "Судья подаёт заявку" { class: step }
  pick: "Коллегия выбирает\nвидны оценка, категория, история" { class: step }
  refuse: "Отказ с причиной\nможно подать снова, пока приём открыт" { class: block }
  assigned: "Главный судья турнира назначен" { class: good }
  pushRef: "PUSH судье\nрешение по заявке на судейство" { class: push }

  openRef -> apply
  apply -> pick
  pick -> refuse: не выбран { class: back }
  refuse -> apply { class: back }
  pick -> assigned: выбран
  pick -> pushRef { class: loop }
}

# ── 3. СИСТЕМА ПРОВЕДЕНИЯ ───────────────────────────────────────────────────
sistema: "3 · СИСТЕМА ПРОВЕДЕНИЯ" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  hint: "ПОДСКАЗКА СИСТЕМЫ\nучастники · дни · часы · столы -> что укладывается" { class: engine }
  format: "Формат сетки\nбиблиотека или конструктор" { class: step }
  discipline: "Дисциплина и число партий\nодиночная или парная" { class: step }
  schedule: "Расписание по дням и столам" { class: step }
  tableRef: "Назначение судей столов\nи столов с трансляцией" { class: step }
  submit: "Отправляет на утверждение" { class: step }
  gate: "Коллегия утвердила?" { class: decide }
  rework: "Возврат с причиной\nбез утверждения турнир не публикуется" { class: block }
  pushOrg: "PUSH главному судье\nсистема утверждена или возвращена" { class: push }

  hint -> format: рекомендация
  format -> discipline
  discipline -> schedule
  schedule -> tableRef
  tableRef -> submit
  submit -> gate
  gate -> pushOrg { class: loop }
  gate -> rework: нет { class: back }
  rework -> format { class: back }
}

# ── 4. ЗАЯВКИ ───────────────────────────────────────────────────────────────
zayavki: "4 · ЗАЯВКИ ИГРОКОВ" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  published: "Турнир опубликован\nвиден публично, открыт приём заявок" { class: good }
  kind: "Категория турнира?" { class: decide }

  # Лига и любительский: записался — и всё. Обставлять клубный турнир
  # документами значит закрыть систему для тех, ради кого она делается (§8.1).
  signup: "Игрок записывается сам\nбез документов, без рассмотрения" { class: good }
  coachSignup: "Тренер записывает своих игроков" { class: step }

  who: "Кто подаёт?\nзависит от уровня турнира" { class: decide }
  self: "Игрок сам\nоткрытый городской" { class: step }
  coach: "Тренер или главный тренер региона\nодна заявка на список игроков" { class: step }
  docs: "Прикладывает документы" { class: step }
  review: "Главный судья рассматривает" { class: decide }
  reject: "Отказ с причиной\nправит и подаёт снова, пока приём открыт" { class: block }

  needVznos: "Турнир требует взноса?\nнастройка турнира (§4.2)" { class: decide }
  vznos: "Взнос за год оплачен?" { class: decide }
  noVznos: "Не проходит\nсостояние взноса видно заранее" { class: block }
  entry: "Игрок в списке участников" { class: good }
  pushApp: "PUSH заявителю\nзаявка принята или отклонена" { class: push }

  published -> kind
  kind -> signup: лига · любительский
  kind -> coachSignup: лига · любительский
  kind -> who: республиканский · городской

  who -> self
  who -> coach
  self -> docs
  coach -> docs
  docs -> review
  review -> pushApp { class: loop }
  review -> reject: отклонена { class: back }
  reject -> docs { class: back }
  review -> needVznos: принята

  signup -> needVznos
  coachSignup -> needVznos
  vznos -> noVznos: нет { class: back }
  noVznos -> published { class: back }
  needVznos -> vznos: да
  needVznos -> entry: нет · любительский
  vznos -> entry: да
}

# ── 5. ЗАПУСК ───────────────────────────────────────────────────────────────
zapusk: "5 · ЗАПУСК" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  seed: "Посев или жеребьёвка\nпара сеётся по среднему рейтингу" { class: step }
  refGate: "У каждого стола есть судья?" { class: decide }
  blocked: "Старт заблокирован\nесли турнир требует судей на столах (§4.2)" { class: block }
  start: "Турнир запущен" { class: step }
  engine: "ДВИЖОК: генерирует сетку\nи распределяет матчи по столам" { class: engine }

  seed -> refGate
  refGate -> blocked: нет { class: back }
  blocked -> refGate { class: back }
  refGate -> start: да
  start -> engine
}

# ── 6. ИГРА ─────────────────────────────────────────────────────────────────
# Ход матча зависит от того, есть ли на турнире судьи столов. Это два разных
# сценария, а не два режима одного: где судья есть, счёт ведёт и подтверждает
# он; где судей нет (лига, любительский), счёт вводят сами игроки. Поэтому
# отдельный флоу на каждый, а не общая развилка внутри одного блока.
whoScores: "Кто ведёт счёт?\nсудьи на столах — настройка турнира (§4.2)" { class: decide }

igraRef: "6А · ИГРА · счёт ведёт судья стола" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  call: "Главный судья вызывает пару на стол\nсудья стола получает уведомление мгновенно" { class: step }
  mode: "Режим ввода счёта?" { class: decide }
  byGame: "Ввод по партиям (§6.1)\nитог матча — производная от партий" { class: step }
  byPoint: "Ввод по очкам в реальном времени (§6.2)\nотмена последнего очка" { class: step }
  live: "ПРЯМОЙ ЭФИР на сайте\nсчёт обновляется в реальном времени" { class: live }
  youtube: "YOUTUBE: видео со столов\nсчёт накладывается автоматически" { class: live }
  offline: "Обрыв связи\nсудья продолжает локально, потом синхронизация" { class: block }
  fix: "Правка счёта\nкаждая пишется в журнал с автором" { class: block }
  doneRef: "Судья подтверждает результат\nуходит главному судье и в базу" { class: good }
  pushCall: "PUSH игрокам\nвас вызвали на стол" { class: push }

  call -> mode
  call -> pushCall { class: loop }
  mode -> byGame: по умолчанию
  mode -> byPoint: live включён на крупный турнир
  byPoint -> live
  live -> youtube
  byGame -> offline: сеть пропала { class: back }
  offline -> byGame: сеть вернулась { class: back }
  byGame -> doneRef
  byPoint -> doneRef
  doneRef -> fix: спорный счёт { class: back }
  fix -> doneRef { class: back }
}

igraSelf: "6Б · ИГРА · счёт ведут сами игроки" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  pair: "Главный судья турнира вызывает пару на стол" { class: step }
  p1: "Игрок 1 вводит счёт" { class: step }
  p2: "Игрок 2 подтверждает?" { class: decide }
  pushConfirm: "PUSH игроку 2\nподтвердите счёт" { class: push }
  dispute: "Не подтверждает\nспор решает главный судья турнира" { class: block }
  doneSelf: "Результат матча зафиксирован" { class: good }

  # Главный судья здесь есть, но конкурс судей (блок 2) идёт только на
  # республиканских, а коллегия в лигах не участвует (§4.1) — значит откуда
  # он берётся, ещё не определено.
  openQ: "ОТКРЫТЫЙ ВОПРОС (QUESTIONS 10.1)\nкто назначает главного судью на лигах\nи любительских: конкурса судей там нет" { class: muted }

  pair -> p1
  p1 -> pushConfirm { class: loop }
  p1 -> p2
  p2 -> dispute: нет { class: back }
  dispute -> doneSelf: решение судьи
  p2 -> doneSelf: да
  pair -> openQ { class: loop }
}

# ── 7. ПРОДВИЖЕНИЕ ПО СЕТКЕ ─────────────────────────────────────────────────
setka: "7 · ПРОДВИЖЕНИЕ ПО СЕТКЕ" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  advance: "ДВИЖОК: продвигает победителя\nсетка обновляется автоматически" { class: engine }
  more: "Остались матчи?" { class: decide }

  advance -> more
}

# ── 8. ЗАВЕРШЕНИЕ ───────────────────────────────────────────────────────────
finish: "8 · ЗАВЕРШЕНИЕ И РЕЙТИНГ" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  close: "Главный судья формирует итоговый протокол\nввод результатов блокируется" { class: step }
  gateRes: "Коллегия утвердила протокол?" { class: decide }
  back: "Возврат с причиной\nввод открывается снова" { class: block }
  rating: "ПЕРЕСЧЁТ РЕЙТИНГА\nидут все три категории турниров (§4.1)" {
    style: { fill: "#fffbeb"; stroke: "#f59e0b"; stroke-width: 2 }
  }
  print: "Печать протоколов\nитоговый и по каждому матчу" { class: step }
  pushRes: "PUSH игроку\nрезультат и новый рейтинг" { class: push }
  player: "Игрок видит результат,\nновый рейтинг и аналитику" { class: good }

  close -> gateRes
  gateRes -> back: нет { class: back }
  back -> close { class: back }
  gateRes -> rating: да
  rating -> player
  rating -> pushRes { class: loop }
  rating -> print
}

# ── СКВОЗНЫЕ СВЯЗИ МЕЖДУ ЭТАПАМИ ────────────────────────────────────────────
zavedenie.resp -> sudeystvo.openRef: конкурс судей { class: liveEdge }
zavedenie.league -> zayavki.published: без конкурса судей и утверждений { class: loop }
zavedenie.amateur -> zayavki.published: без конкурса судей и утверждений { class: loop }

sudeystvo.assigned -> sistema.hint: судья приступает { class: liveEdge }
sistema.gate -> zayavki.published: утверждено { class: liveEdge }
zayavki.entry -> zapusk.seed: состав собран { class: liveEdge }
zapusk.engine -> whoScores: матчи распределены { class: liveEdge }
whoScores -> igraRef.call: судьи на столах есть { class: liveEdge }
whoScores -> igraSelf.pair: судей нет · лига, любительский { class: liveEdge }

igraRef.doneRef -> setka.advance { class: liveEdge }
igraSelf.doneSelf -> setka.advance { class: liveEdge }
# Петля возвращается в развилку, а не в каждый контейнер по отдельности.
# Так 6А и 6Б остаются на одном ранге и встают рядом, а не лесенкой.
setka.more -> whoScores: да, следующий матч { class: loop }
setka.more -> finish.close: матчей больше нет { class: liveEdge }
