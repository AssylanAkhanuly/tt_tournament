...@_theme

direction: down

# ПОЛНЫЙ ХОД ТУРНИРА по ФНТ ТЗ v1.6 — одна связная схема.
#
# v1.6 переработан по замечаниям Андрея (обследование перед этапами).
# Что изменилось против v1.5:
#   * «Лига» больше НЕ отдельная категория. Есть два типа управления —
#     ОФИЦИАЛЬНЫЙ (заводит федерация/коллегия) и КЛУБНЫЙ (заводит организатор
#     клуба). Лига и любительский — это клубные турниры, а их свойства
#     (судьи, плата за турнир, рейтинг, ценз по рейтингу) задаются флагами,
#     каждый независимо. Клубный турнир может быть рейтинговым и со временем
#     стать официальным.
#   * блок «набор судей столов» УБРАН: отдельного конкурса на столы нет.
#     Главный судья распределяет доступных судей по столам — шаг в запуске.
#   * заявки игроков идут ДО системы проведения: сначала регламент и состав,
#     потом главный судья строит сетку и расписание.
#   * система проведения БЕЗ утверждения коллегией — решает главный судья.
#   * на клубных счёт называет победитель, вводит главный судья (без ввода
#     игроком и подтверждения соперником).
#   * плата за турнир — ОТДЕЛЬНАЯ сущность, её ставит организатор; это не
#     годовой взнос федерации.
#   * при обрыве связи приоритет у судьи стола; правка счёта — с лимитом
#     времени, чтобы не сломать сетку.

# ── 1. ЗАВЕДЕНИЕ И РЕГЛАМЕНТ ─────────────────────────────────────────────────
zavedenie: "1 · ЗАВЕДЕНИЕ И РЕГЛАМЕНТ" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  create: "Заводит турнир и задаёт регламент\nформат · дисциплина · число партий\nдаты · категории · столы" { class: step }
  kind: "Тип управления?" { class: decide }
  official: "ОФИЦИАЛЬНЫЙ · республиканский\nзаводит федерация / коллегия\nсудьи · годовой взнос · документы\nутверждение коллегией · рейтинг" { class: rbac }
  club: "КЛУБНЫЙ · лига или любительский\nзаводит ОРГАНИЗАТОР КЛУБА\n(руководитель, менеджер, тренер клуба)" { class: good }

  # Свойства клубного не заданы категорией — это независимые флаги, которые
  # ставит организатор. Так «лига» и «любительский» перестают быть отдельными
  # ветками: это один клубный турнир с разным набором флагов.
  flags: "ФЛАГИ КЛУБНОГО · каждый независимо\nсудьи на столах? · плата за турнир?\nрейтинг учитывается? · ценз по рейтингу?" { class: rbac }
  note: "«Лига» — не категория, а клубный турнир.\nМожет быть рейтинговым и стать официальным" { class: muted }

  create -> kind
  kind -> official: официальный
  kind -> club: клубный
  club -> flags
  club -> note { class: loop }
}

# ── 2. СУДЕЙСТВО ────────────────────────────────────────────────────────────
# Только официальные. Конкурс идёт на ГЛАВНОГО судью. Судьи столов отдельно
# НЕ набираются (прежний блок 3 убран по замечанию Андрея): их распределяет
# главный судья на запуске из числа доступных.
sudeystvo: "2 · ЗАЯВКИ СУДЕЙ И НАЗНАЧЕНИЕ · только официальные" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  openRef: "Коллегия открывает приём заявок судей\nтурнир ещё не опубликован" { class: step }
  list: "Судья видит турниры,\nоткрытые для заявок на судейство" { class: step }
  apply: "Судья подаёт заявку на турнир" { class: step }
  inbox: "Заявки в списке у коллегии\nвидны оценка, категория, история судейства" { class: step }
  any: "Заявки поступили?" { class: decide }
  none: "Заявок нет\nчто тогда — открытый вопрос (QUESTIONS 3.6)" { class: muted }
  pick: "Коллегия выбирает одного" { class: decide }
  refuse: "Отказ с причиной\nможно подать снова, пока приём открыт" { class: block }
  assigned: "Главный судья турнира назначен" { class: good }
  pushRef: "PUSH судье\nрешение по заявке на судейство" { class: push }

  qApply: "ОТКРЫТЫЕ ВОПРОСЫ (QUESTIONS 3.1-3.3)\nкто вправе подать: категория, регион, уровень\nнужны ли документы · есть ли срок приёма\nещё обсуждается с председателем коллегии" { class: muted }
  tableNote: "СУДЬИ СТОЛОВ отдельно не набираются\nглавный судья распределит доступных по столам\nна запуске (прежний блок «набор судей столов» убран)" { class: muted }

  openRef -> list
  list -> apply
  apply -> qApply { class: loop }
  apply -> inbox
  inbox -> any
  any -> none: нет { class: back }
  any -> pick: да
  pick -> refuse: не выбран { class: back }
  refuse -> apply { class: back }
  pick -> assigned: выбран
  pick -> pushRef { class: loop }
  assigned -> tableNote { class: loop }
}

# ── 3. ЗАЯВКИ ИГРОКОВ ───────────────────────────────────────────────────────
# Идут ДО системы проведения: сначала состав, потом главный судья строит
# сетку. Ветвление по типу управления, а не по трём категориям.
zayavki: "3 · ЗАЯВКИ ИГРОКОВ" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  published: "Турнир опубликован\nоткрыт приём заявок" { class: good }
  branch: "Тип управления?" { class: decide }

  # ── клубный: самозапись, тренер не обязателен
  selfSignup: "Игрок записывается сам\nтренер не обязателен: у игрока его может не быть" { class: good }
  ceiling: "Ценз по рейтингу?\nорганизатор может ограничить уровень игроков" { class: decide }
  denied: "Не проходит по цензу\nрейтинг вне допустимого диапазона" { class: block }
  payFee: "Есть плата за турнир?\nсбор ставит организатор" { class: decide }
  payDo: "Оплата организатору\nотдельная сущность, не годовой взнос федерации" { class: step }

  # ── официальный: заявка с документами и рассмотрением
  who: "Кто подаёт?\nзависит от уровня турнира" { class: decide }
  selfOff: "Игрок сам · открытый городской" { class: step }
  coachOff: "Тренер / главный тренер региона\nодна заявка на список игроков" { class: step }
  docs: "Прикладывает документы" { class: step }
  review: "Главный судья рассматривает" { class: decide }
  reject: "Отказ с причиной\nправит и подаёт снова, пока приём открыт" { class: block }
  needVznos: "Годовой взнос требуется?\nнастройка официального турнира" { class: decide }
  vznos: "Взнос за год оплачен?" { class: decide }
  noVznos: "Не проходит\nсостояние взноса видно заранее" { class: block }

  entry: "Игрок в списке участников" { class: good }
  pushApp: "PUSH заявителю\nзаявка принята или отклонена" { class: push }

  published -> branch
  branch -> selfSignup: клубный
  branch -> who: официальный

  selfSignup -> ceiling
  ceiling -> denied: не проходит { class: back }
  ceiling -> payFee: проходит
  payFee -> payDo: да
  payFee -> entry: нет
  payDo -> entry

  who -> selfOff
  who -> coachOff
  selfOff -> docs
  coachOff -> docs
  docs -> review
  review -> pushApp { class: loop }
  review -> reject: отклонена { class: back }
  reject -> docs { class: back }
  review -> needVznos: принята
  needVznos -> vznos: да
  needVznos -> entry: нет
  vznos -> noVznos: нет { class: back }
  noVznos -> published { class: back }
  vznos -> entry: да
}

# ── 4. СИСТЕМА ПРОВЕДЕНИЯ И ЗАПУСК ───────────────────────────────────────────
# После того как состав собран. Главный судья строит сетку сам, БЕЗ утверждения
# коллегией — он решает по регламенту, участникам, столам и времени с подсказкой
# системы. Никаких возвратов и PUSH об утверждении.
sistema: "4 · СИСТЕМА ПРОВЕДЕНИЯ И ЗАПУСК" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  hint: "ПОДСКАЗКА СИСТЕМЫ\nучастники · дни · часы · столы -> что укладывается" { class: engine }
  format: "Главный судья выбирает формат сетки\nбиблиотека или конструктор" { class: step }
  schedule: "Расписание по дням и столам" { class: step }
  seed: "Посев или жеребьёвка" { class: step }
  seedNote: "ОТКРЫТЫЙ ВОПРОС (QUESTIONS 5.2)\nпарные: сеются ли по среднему рейтингу — проверить" { class: muted }
  tableRef: "Распределяет судей по столам\nиз числа доступных · отмечает трансляционные столы" { class: step }
  refGate: "У каждого стола есть судья?\nтолько если турнир требует судей на столах" { class: decide }
  blocked: "Старт заблокирован\nпока стол без судьи" { class: block }
  engine: "ДВИЖОК: генерирует сетку\nи распределяет матчи по столам" { class: engine }
  start: "Турнир запущен" { class: good }

  hint -> format: рекомендация
  format -> schedule
  schedule -> seed
  seed -> seedNote { class: loop }
  seed -> tableRef
  tableRef -> refGate
  refGate -> blocked: нет { class: back }
  blocked -> refGate { class: back }
  refGate -> engine: да
  engine -> start
}

# ── 5. ИГРА ─────────────────────────────────────────────────────────────────
# Ход матча зависит от того, есть ли на турнире судьи столов. Два разных
# сценария: где судья есть — счёт ведёт и подтверждает он; где судей нет
# (клубный) — победитель называет результат главному судье, тот вводит.
whoScores: "Кто ведёт счёт?\nсудьи на столах — настройка турнира" { class: decide }

igraRef: "5А · ИГРА · счёт ведёт судья стола" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  call: "Главный судья вызывает пару на стол\nсудья стола получает уведомление мгновенно" { class: step }
  mode: "Режим ввода счёта?" { class: decide }
  byGame: "Ввод по партиям\nитог матча — производная от партий" { class: step }
  byPoint: "Ввод по очкам в реальном времени\nотмена последнего очка" { class: step }
  live: "ПРЯМОЙ ЭФИР на сайте\nсчёт обновляется в реальном времени" { class: live }
  youtube: "YOUTUBE: видео со столов\nсчёт накладывается автоматически" { class: live }
  offline: "Обрыв связи\nсудья продолжает локально, потом синхронизация\nпри расхождении ПРИОРИТЕТ У СУДЬИ СТОЛА: он видит игру" { class: block }
  fix: "Правка счёта · с лимитом времени\nчтобы не сломать сетку; на групповом этапе — до конца этапа\nкаждая правка пишется в журнал с автором" { class: block }
  doneRef: "Судья подтверждает результат\nуходит главному судье и в базу" { class: good }
  pushCall: "PUSH игрокам\nвас вызвали на стол" { class: push }

  call -> mode
  call -> pushCall { class: loop }
  mode -> byGame: по умолчанию
  mode -> byPoint: live включён на крупный турнир
  byPoint -> live
  live -> youtube
  byGame -> offline: сеть пропала { class: back }
  offline -> byGame: сеть вернулась { class: back }
  byGame -> doneRef
  byPoint -> doneRef
  doneRef -> fix: спорный счёт { class: back }
  fix -> doneRef { class: back }
}

igraSelf: "5Б · ИГРА · без судьи стола · клубный" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  # На клубных главного судью определяет организатор НЕФОРМАЛЬНО — это может
  # быть админ клуба или тренер. Так закрывается прежний открытый вопрос
  # QUESTIONS 10.1: конкурса судей здесь нет, судью назначает организатор.
  pair: "Главный судья вызывает пару на стол\nна клубных его назначает организатор неформально\n(админ клуба или тренер) — QUESTIONS 10.1 закрыт" { class: step }
  play: "Матч сыгран" { class: step }
  tell: "Победитель называет результат главному судье" { class: step }
  enter: "Главный судья вводит результат\nбез ввода игроком и подтверждения соперником" { class: step }
  doneSelf: "Результат матча зафиксирован" { class: good }

  pair -> play
  play -> tell
  tell -> enter
  enter -> doneSelf
}

# ── 6. ПРОДВИЖЕНИЕ ПО СЕТКЕ ──────────────────────────────────────────────────
setka: "6 · ПРОДВИЖЕНИЕ ПО СЕТКЕ" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  advance: "ДВИЖОК: продвигает победителя\nсетка обновляется автоматически" { class: engine }
  more: "Остались матчи?" { class: decide }

  advance -> more
}

# ── 7. ЗАВЕРШЕНИЕ ───────────────────────────────────────────────────────────
# Утверждение протокола коллегией — ТОЛЬКО на официальных. На клубных коллегии
# нет: главный судья закрывает турнир, и если он рейтинговый — рейтинг считается.
finish: "7 · ЗАВЕРШЕНИЕ И РЕЙТИНГ" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  close: "Главный судья закрывает турнир\nввод результатов блокируется" { class: step }
  offQ: "Тип управления?" { class: decide }
  gateRes: "Коллегия утвердила протокол?\nтолько официальные" { class: decide }
  back: "Возврат с причиной\nввод открывается снова" { class: block }
  rated: "Турнир рейтинговый?\nофициальные — всегда; клубные — по настройке" { class: decide }
  rating: "ПЕРЕСЧЁТ РЕЙТИНГА" {
    style: { fill: "#fffbeb"; stroke: "#f59e0b"; stroke-width: 2 }
  }
  noRating: "Без пересчёта\nклубный без рейтинга" { class: muted }
  print: "Печать протоколов\nитоговый и по каждому матчу" { class: step }
  pushRes: "PUSH игроку\nрезультат и новый рейтинг" { class: push }
  player: "Игрок видит результат,\nновый рейтинг и аналитику" { class: good }

  close -> offQ
  offQ -> gateRes: официальный
  offQ -> rated: клубный
  gateRes -> back: нет { class: back }
  back -> close { class: back }
  gateRes -> rated: да
  rated -> rating: да
  rated -> noRating: нет
  rating -> player
  rating -> pushRes { class: loop }
  rating -> print
}

# ── СКВОЗНЫЕ СВЯЗИ МЕЖДУ ЭТАПАМИ ────────────────────────────────────────────
# Официальный: конкурс судей, назначение, потом публикация и приём заявок.
zavedenie.official -> sudeystvo.openRef: конкурс судей { class: liveEdge }
sudeystvo.assigned -> zayavki.published: судья назначен, турнир опубликован { class: liveEdge }
# Клубный: без конкурса судей и без утверждений — сразу к приёму заявок.
zavedenie.club -> zayavki.published: без конкурса судей и утверждений { class: loop }

# Состав собран → главный судья строит сетку (после заявок, не до).
zayavki.entry -> sistema.hint: состав собран { class: liveEdge }
sistema.start -> whoScores: матчи распределены { class: liveEdge }
whoScores -> igraRef.call: судьи на столах есть { class: liveEdge }
whoScores -> igraSelf.pair: судей нет · клубный { class: liveEdge }

igraRef.doneRef -> setka.advance { class: liveEdge }
igraSelf.doneSelf -> setka.advance { class: liveEdge }
# Петля возвращается в развилку, а не в каждый контейнер по отдельности —
# так 5А и 5Б остаются на одном ранге и встают рядом.
setka.more -> whoScores: да, следующий матч { class: loop }
setka.more -> finish.close: матчей больше нет { class: liveEdge }
