...@_theme

direction: down

# Игрок — сайт и мобильное приложение (iOS/Android).
# Единственная роль с аналитикой; счёт своих матчей не вводит — это делает
# судья стола. Расширенная аналитика платная (TZ §11).

login: "Вход\nсайт или приложение" { class: start }

home: "Главная\nрейтинг 2456 (+24) · место 8 из 1042" { class: good }
stats: "Аналитика\nматчи · победы · винрейт · расширенная платная" { class: step }
chart: График динамики рейтинга { class: step }

nearest: "Ближайший турнир\nстатус регистрации" { class: step }

# Кто заявляет — зависит от категории соревнования (TZ §4.1, §8.2). Сам игрок
# заявляется только на открытые республиканские и клубные турниры.
kind: Какое это соревнование? { class: decide }
via_rep: "Заявляет представитель\nна чемпионаты и Кубок РК — старший тренер региона,\nв Евразийскую лигу — администратор клуба" { class: muted }
apply: Заявиться самому? { class: decide }
submit: "Подаёт заявку без тренера" { class: step }
verdict: Заявка одобрена? { class: decide }
rejected: Отказ с причиной { class: block }
inside: В составе турнира { class: good }

active: Турнир идёт? { class: decide }
my_match: "Мой матч\nсоперник · стол · когда выходить" { class: step }
playing: "Играет — счёт ведёт судья стола" { class: step }
result: "Результат матча\nсчёт по партиям" { class: step }
more: Ещё матчи? { class: decide }
place: "Турнир завершён — итоговое место" { class: good }
new_rating: "Рейтинг пересчитан" { class: good }

history: "Последние матчи\nсоперник · счёт по партиям · дата" { class: step }
h2h: Личные встречи с соперником { class: step }

login -> home
home -> stats
stats -> chart
home -> nearest
nearest -> kind
kind -> apply: "открытое республиканское или клубное"
kind -> via_rep: "чемпионат, Кубок РК или Евразийская лига"
via_rep -> verdict
apply -> submit: да
submit -> verdict
verdict -> rejected: нет { class: back }
rejected -> nearest { class: back }
verdict -> inside: да
apply -> history: нет { class: loop }
inside -> active
active -> my_match: да
my_match -> playing
playing -> result
result -> more
more -> my_match: да { class: loop }
more -> place: нет
place -> new_rating
new_rating -> history
active -> history: нет { class: loop }
history -> h2h
