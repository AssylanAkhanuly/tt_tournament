...@_theme

direction: down

# Семь сценариев в две колонки. Без этого dagre ставит их в один ряд, и схема
# выходит 9700 px шириной — на экране такое не прочитать. Внутри колонок
# раскладка обычная, сверху вниз.
grid-columns: 2

# СЦЕНАРИИ ПО КАЖДОМУ ТУРНИРУ КАЛЕНДАРЯ ФНТ РК.
# Источник: перечень стартов федерации + TZ.md §4.1, §4.10, §8.2.
#
# Заменяет прежнюю общую схему flow-tournament-full: там ход был один на всех,
# а различались турниры только «типом управления». Здесь у каждого старта свой
# путь, и видно, чем он отличается от соседнего.
#
# Как читать:
#   жёлтый ромб — развилка, зелёное — успешный шаг, красное — стоп или отказ,
#   серое — открытый вопрос к федерации, красный пунктир — возврат на доработку.
#
# Все семь колонок читаются сверху вниз и независимы друг от друга.

# ── 1. ЧЕМПИОНАТ РЕСПУБЛИКИ КАЗАХСТАН ────────────────────────────────────────
ch: "1 · ЧЕМПИОНАТ РЕСПУБЛИКИ КАЗАХСТАН\nбез ограничения по возрасту · заявляет регион" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  a1: "Федерация заводит старт\nдаты · город · разряды: одиночный и парный" { class: step }
  a2: "Председатель ГСК назначает главного судью\nпо заявке или напрямую — вопрос 12.6" { class: step }
  a3: "Старт опубликован — открыт приём заявок" { class: good }
  a4: "СТАРШИЙ ТРЕНЕР РЕГИОНА\nвидит своих спортсменов и их годовой взнос" { class: rbac }
  a5: "Подаёт состав от региона\nодной заявкой, с документами" { class: step }
  a6: "Игрок сам заявиться не может\nвидит только, что его заявили" { class: muted }
  a7: "Главный судья рассматривает заявку" { class: decide }
  a8: "Отказ с причиной\nтренер правит и подаёт снова" { class: block }
  a9: "Годовой взнос оплачен?" { class: decide }
  a10: "Не допущен" { class: block }
  a11: "Игрок в списке участников" { class: good }
  a12: "Главный судья и секретарь строят сетку,\nрасписание и жеребьёвку, ставят судей на столы" { class: step }
  a13: "Игра · счёт ведёт судья\nрезультаты видны публично сразу" { class: step }
  a14: "Итоговый протокол\nутверждает председатель ГСК" { class: step }
  a15: "Рейтинг пересчитан\nигрок и регион видят итоги" { class: good }

  a1 -> a2 -> a3 -> a4 -> a5
  a5 -> a6 { class: loop }
  a5 -> a7
  a7 -> a8: отклонена { class: back }
  a8 -> a5 { class: back }
  a7 -> a9: принята
  a9 -> a10: нет { class: back }
  a9 -> a11: да
  a11 -> a12 -> a13 -> a14 -> a15
}

# ── 2. МОЛОДЁЖНЫЙ ЧЕМПИОНАТ РК ───────────────────────────────────────────────
mch: "2 · МОЛОДЁЖНЫЙ ЧЕМПИОНАТ РК\nвозрастная граница не определена" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  b1: "Федерация заводит старт\nдаты · город · разряды" { class: step }
  b2: "ОТКРЫТЫЙ ВОПРОС\nкакая возрастная граница у молодёжного?\nбез неё не построить фильтр допуска" { class: muted }
  b3: "Председатель ГСК назначает главного судью" { class: step }
  b4: "Старт опубликован — открыт приём заявок" { class: good }
  b5: "СТАРШИЙ ТРЕНЕР РЕГИОНА подаёт состав\nтолько молодёжь своего региона" { class: rbac }
  b6: "Главный судья рассматривает заявку" { class: decide }
  b7: "Отказ с причиной" { class: block }
  b8: "Проходит по возрасту и взносу?" { class: decide }
  b9: "Не допущен" { class: block }
  b10: "Игрок в списке участников" { class: good }
  b11: "Сетка, расписание, жеребьёвка, судьи на столах" { class: step }
  b12: "Игра · счёт ведёт судья" { class: step }
  b13: "Протокол утверждает председатель ГСК" { class: step }
  b14: "Рейтинг пересчитан" { class: good }

  b1 -> b2 { class: loop }
  b1 -> b3 -> b4 -> b5 -> b6
  b6 -> b7: отклонена { class: back }
  b7 -> b5 { class: back }
  b6 -> b8: принята
  b8 -> b9: нет { class: back }
  b8 -> b10: да
  b10 -> b11 -> b12 -> b13 -> b14
}

# ── 3. ВОЗРАСТНЫЕ ЧЕМПИОНАТЫ (ПЯТЬ СТАРТОВ) ──────────────────────────────────
# Пять отдельных чемпионатов с одинаковым ходом: 2007, 2009, 2011, 2013 и 2015
# г.р. и моложе. Отличаются только границей года, и она сдвигается каждый сезон.
age: "3 · ВОЗРАСТНЫЕ ЧЕМПИОНАТЫ РК · пять стартов\n2007 · 2009 · 2011 · 2013 · 2015 г.р. и моложе" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  c1: "Федерация заводит старт на сезон\nзадаёт границу: «год рождения и моложе»" { class: step }
  c2: "ГРАНИЦА СДВИГАЕТСЯ САМА\nновый сезон — год +1: 2007 становится 2008\nназвание собирается из сезона и границы" { class: rbac }
  c3: "Председатель ГСК назначает главного судью" { class: step }
  c4: "Старт опубликован — открыт приём заявок" { class: good }
  c5: "СТАРШИЙ ТРЕНЕР РЕГИОНА видит только тех,\nкто проходит по году рождения" { class: rbac }
  c6: "Подаёт состав от региона" { class: step }
  c7: "Главный судья рассматривает заявку" { class: decide }
  c8: "Отказ с причиной" { class: block }
  c9: "Год рождения подходит и взнос оплачен?" { class: decide }
  c10: "Не допущен\nстарше границы этого сезона" { class: block }
  c11: "Игрок в списке участников" { class: good }
  c12: "Сетка, расписание, жеребьёвка, судьи на столах" { class: step }
  c13: "Игра · счёт ведёт судья" { class: step }
  c14: "Протокол утверждает председатель ГСК" { class: step }
  c15: "Рейтинг пересчитан" { class: good }

  c1 -> c2 { class: loop }
  c1 -> c3 -> c4 -> c5 -> c6 -> c7
  c7 -> c8: отклонена { class: back }
  c8 -> c6 { class: back }
  c7 -> c9: принята
  c9 -> c10: нет { class: back }
  c9 -> c11: да
  c11 -> c12 -> c13 -> c14 -> c15
}

# ── 4. КУБОК РЕСПУБЛИКИ КАЗАХСТАН ────────────────────────────────────────────
cup: "4 · КУБОК РЕСПУБЛИКИ КАЗАХСТАН\nзаявляет регион · система проведения не подтверждена" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  d1: "Федерация заводит Кубок\nдаты · город · разряды" { class: step }
  d2: "ОТКРЫТЫЙ ВОПРОС\nотличается ли система проведения Кубка\nот чемпионата и есть ли отбор" { class: muted }
  d3: "Председатель ГСК назначает главного судью" { class: step }
  d4: "Кубок опубликован — открыт приём заявок" { class: good }
  d5: "СТАРШИЙ ТРЕНЕР РЕГИОНА подаёт состав" { class: rbac }
  d6: "Главный судья рассматривает заявку" { class: decide }
  d7: "Отказ с причиной" { class: block }
  d8: "Игрок в списке участников" { class: good }
  d9: "Сетка, расписание, жеребьёвка, судьи на столах" { class: step }
  d10: "Игра · счёт ведёт судья" { class: step }
  d11: "Протокол утверждает председатель ГСК" { class: step }
  d12: "Рейтинг пересчитан · обладатель Кубка" { class: good }

  d1 -> d2 { class: loop }
  d1 -> d3 -> d4 -> d5 -> d6
  d6 -> d7: отклонена { class: back }
  d7 -> d5 { class: back }
  d6 -> d8: принята
  d8 -> d9 -> d10 -> d11 -> d12
}

# ── 5. ЕВРАЗИЙСКАЯ ЛИГА · МУЖСКИЕ КОМАНДЫ ────────────────────────────────────
# Здесь участник не игрок, а КОМАНДА КЛУБА. Заявляет администратор клуба.
# Розыгрыш идёт четыре тура, между турами команда может менять состав.
lm: "5 · ЕВРАЗИЙСКАЯ ЛИГА · МУЖСКИЕ КОМАНДЫ\nСуперлига и 2-6 лиги · четыре тура" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  e1: "Федерация открывает сезон\nзаводит шесть лиг и даты четырёх туров" { class: step }
  e2: "Клуб зарегистрирован,\nу него есть АДМИНИСТРАТОР КЛУБА" { class: rbac }
  e3: "Администратор заявляет команду в свою лигу\nи заявляет её состав" { class: step }
  e4: "Игрок сам в Лигу не заявляется\nвидит, что заявлен за команду" { class: muted }
  e5: "Команда допущена?" { class: decide }
  e6: "Отказ с причиной" { class: block }
  e7: "Календарь встреч тура составлен" { class: good }
  e8: "Перед туром администратор\nподтверждает состав на этот тур" { class: step }
  e9: "КОМАНДНАЯ ВСТРЕЧА\nвнутри играются личные встречи,\nсчёт встречи складывается из них" { class: step }
  e10: "ОТКРЫТЫЙ ВОПРОС\nсхема встречи: сколько игроков и личных встреч,\nпорядок, до скольких побед" { class: muted }
  e11: "Таблица лиги обновлена" { class: good }
  e12: "ОТКРЫТЫЙ ВОПРОС\nсколько очков за победу и как считать\nпри равенстве" { class: muted }
  e13: "Все четыре тура сыграны?" { class: decide }
  e14: "Итоги сезона: места в лиге" { class: good }
  e15: "Переходы между лигами\nповышение и понижение" { class: step }
  e16: "ОТКРЫТЫЙ ВОПРОС\nсколько команд переходит, есть ли переходные встречи,\nидут ли личные встречи в рейтинг игрока" { class: muted }

  e1 -> e2 -> e3
  e3 -> e4 { class: loop }
  e3 -> e5
  e5 -> e6: нет { class: back }
  e6 -> e3 { class: back }
  e5 -> e7: да
  e7 -> e8 -> e9
  e9 -> e10 { class: loop }
  e9 -> e11
  e11 -> e12 { class: loop }
  e11 -> e13
  e13 -> e8: нет, следующий тур { class: loop }
  e13 -> e14: да
  e14 -> e15
  e15 -> e16 { class: loop }
}

# ── 6. ЕВРАЗИЙСКАЯ ЛИГА · ЖЕНСКИЕ КОМАНДЫ ────────────────────────────────────
lw: "6 · ЕВРАЗИЙСКАЯ ЛИГА · ЖЕНСКИЕ КОМАНДЫ\nСуперлига и 2 лига · четыре тура" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  f0: "Женские команды выделены\nв отдельный розыгрыш с этого сезона" { class: muted }
  f1: "Федерация открывает сезон\nзаводит две лиги и даты четырёх туров" { class: step }
  f2: "АДМИНИСТРАТОР КЛУБА заявляет команду\nи её состав" { class: rbac }
  f3: "Команда допущена?" { class: decide }
  f4: "Отказ с причиной" { class: block }
  f5: "Календарь встреч тура составлен" { class: good }
  f6: "Перед туром состав на тур подтверждён" { class: step }
  f7: "КОМАНДНАЯ ВСТРЕЧА\nвнутри играются личные встречи" { class: step }
  f8: "Таблица лиги обновлена" { class: good }
  f9: "Все четыре тура сыграны?" { class: decide }
  f10: "Итоги сезона и переходы между лигами" { class: good }
  f11: "ОТКРЫТЫЙ ВОПРОС\nправила те же, что у мужчин, или свои —\nне подтверждено" { class: muted }

  f1 -> f0 { class: loop }
  f1 -> f2 -> f3
  f3 -> f4: нет { class: back }
  f4 -> f2 { class: back }
  f3 -> f5 -> f6 -> f7 -> f8 -> f9
  f9 -> f6: нет, следующий тур { class: loop }
  f9 -> f10: да
  f10 -> f11 { class: loop }
}

# ── 7. ОТКРЫТЫЕ РЕСПУБЛИКАНСКИЕ ТУРНИРЫ ──────────────────────────────────────
# Самый короткий путь: между игроком и турниром нет ни региона, ни клуба.
op: "7 · ОТКРЫТЫЕ РЕСПУБЛИКАНСКИЕ ТУРНИРЫ\nименные и городские опены · игрок заявляется сам" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  g1: "Турнир заводится в календаре\nдаты · город · разряды · условия допуска" { class: step }
  g2: "Назначен главный судья" { class: step }
  g3: "Турнир опубликован — открыт приём заявок" { class: good }
  g4: "ИГРОК ПОДАЁТ ЗАЯВКУ САМ\nпредставитель не нужен" { class: rbac }
  g5: "Тренер может подать за своих списком\nэто удобство, а не требование" { class: muted }
  g6: "Проходит по условиям турнира?\nвзнос · ценз по рейтингу · документы" { class: decide }
  g7: "Не допущен — с причиной" { class: block }
  g8: "Главный судья рассматривает заявку" { class: decide }
  g9: "Отказ с причиной\nигрок правит и подаёт снова" { class: block }
  g10: "Игрок в списке участников" { class: good }
  g11: "Сетка, расписание, жеребьёвка, судьи на столах" { class: step }
  g12: "Игра · счёт ведёт судья" { class: step }
  g13: "Итоговый протокол закрыт" { class: step }
  g14: "Рейтинг пересчитан" { class: good }
  g15: "ОТКРЫТЫЙ ВОПРОС\nполный список этих турниров и их положения\nне получены" { class: muted }

  g1 -> g2 -> g3 -> g4
  g4 -> g5 { class: loop }
  g4 -> g6
  g6 -> g7: нет { class: back }
  g7 -> g4 { class: back }
  g6 -> g8: да
  g8 -> g9: отклонена { class: back }
  g9 -> g4 { class: back }
  g8 -> g10: принята
  g10 -> g11 -> g12 -> g13 -> g14
  g1 -> g15 { class: loop }
}
