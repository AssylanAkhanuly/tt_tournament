...@_theme

direction: down

# Роль 6 · Главный судья соревнований — поэкранный флоу.
# СГЕНЕРИРОВАНО: npm run gen:diagrams (design/scripts/gen-flow-diagrams.mjs).
# Содержание — flows/06-glavnyy-sudya.md; руками этот файл не правим.
#
# Как читать: контейнер — экран (код Э№.№ в заголовке), внутри
#   синее   — зона экрана: из чего он состоит
#   жёлтое  — действие: что нажимает и когда
#   серое   — состояние экрана или открытый вопрос
#   красное — блокировка, отказ, «нельзя»

head: "6 · ГЛАВНЫЙ СУДЬЯ СОРЕВНОВАНИЙ\nУправление конкретным турниром, утверждение сеток,\nрезультатов, дисциплинарных решений (TZ §2).\nУстройство: десктоп · область: один турнир, на время турнира" { class: rbac }

s1: "Э6.1 · Мой турнир\nПульт турнира: где турнир сейчас находится и что от\nсудьи требуется прямо сейчас." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Первый экран после входа\n• При нескольких турнирах — список «мои\nтурниры», затем этот экран" { class: start }
  z1: "Шапка турнира\n• Название\n• Категория\n• Город\n• Даты\n• Шкала состояний — восемь состояний турнира\n(§4.3) с подсветкой текущего" { class: step }
  z2: "Счётчики\n• Заявок подано / принято\n• Участников в составе\n• Столов\n• Судей в наряде\n• Матчей сыграно / всего" { class: step }
  z3: "Что сейчас требуется\n• В «Приёме заявок игроков» — «N заявок ждут\nрешения»\n• В «Системе проведения» — «сетка не собрана»,\n«на 2 столах нет судьи»\n• В «Идёт» — «3 пары ждут стола»\n• Каждая строка — ссылка на нужный экран\nПодсказка меняется по состоянию турнира —\nэто главный вход в работу с экрана." { class: step }
  z4: "Условия допуска турнира\n• Возрастная граница\n• Годовой взнос\n• Ценз по рейтингу\n• Документы к заявке\nТолько чтение: от этих условий зависят\nпроверки допуска в заявках (Э6.2)." { class: step }
  a1: "Переход «Заявки участников»\nкогда: «Приём заявок игроков»\n→ Открывает список заявок" { class: rbac }
  a2: "Переход «Сетка и посев»\nкогда: «Система проведения», состав собран\n→ Открывает сборку системы проведения" { class: rbac }
  a3: "Переход «Расписание и столы»\nкогда: «Система проведения», сетка собрана\n→ Открывает расстановку матчей по дням и\nстолам" { class: rbac }
  a4: "Переход «Судьи на столах»\nкогда: «Система проведения», до и во время\n«Идёт»\n→ Открывает распределение судей по столам" { class: rbac }
  a5: "Переход «Ход турнира»\nкогда: «Идёт»\n→ Открывает карту столов и очередь пар" { class: rbac }
  a6: "Переход «Итоговый протокол»\nкогда: все матчи сыграны\n→ Открывает итоговую таблицу и работу с\nпротоколом" { class: rbac }
  a7: "Правка регламента ✳\nкогда: никогда\n→ Регламент судья не правит — он его\nисполняет" { class: rbac }
  st1: "Состояние «Приём заявок игроков»\nВ зоне «Что сейчас требуется» — «N заявок\nждут решения» со ссылкой на Э6.2." { class: muted }
  st2: "Состояние «Система проведения»\n«Сетка не собрана», «на 2 столах нет судьи»\n— ссылки на Э6.3 и Э6.5." { class: muted }
  st3: "Состояние «Идёт»\n«3 пары ждут стола» — ссылка на Э6.6." { class: muted }
}

s2: "Э6.2 · Заявки участников" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1 «Мой турнир»\n• Уведомление «новая заявка»" { class: start }
  z1: "Вкладки-фильтры\n• Ждут решения\n• Приняты\n• Отклонены\n• Отозваны" { class: step }
  z2: "Список заявок\n• Кто подал — бейдж: регион · клуб · сам игрок\n(три пути §8.2)\n• Когда подана\n• Состав заявки\n• Для списочной заявки тренера раскрывается\nперечень игроков" { class: step }
  z3: "Игрок внутри заявки\n• ФИО\n• Год рождения\n• Регион / клуб\n• Рейтинг" { class: step }
  z4: "Проверки допуска — авто-отметки системы\n• Возрастная граница — не проходит: красная\nпометка с годом\n• Ценз по рейтингу\n• Годовой взнос — не оплачен: заявка не\nпроходит там, где взнос требуется (§9.2)\n• Документы — приложены / нет, просмотр файлов" { class: step }
  z5: "Правило решения по списочной заявке\n• Решение принимается по заявке целиком (§8.2)" { class: step }
  a1: "«Принять»\nкогда: «Приём заявок игроков»\n→ Участники в составе; заявителю уведомление" { class: rbac }
  a2: "«Отклонить с причиной»\nкогда: «Приём заявок игроков»\n→ Заявитель правит и подаёт снова, пока\nприём открыт" { class: rbac }
  a3: "«Закрыть приём» ✳\nкогда: «Приём заявок игроков»\n→ Турнир → «Система проведения»; новые\nзаявки не принимаются" { class: rbac }
  st1: "Заявок нет\nПустое состояние со сроком приёма." { class: muted }
  st2: "Заявка с непроходящим игроком\nКнопка «Принять» остаётся, но с\nпредупреждением. ✳" { class: muted }
  st3: "Приём закрыт\nСписки только на чтение." { class: muted }
}

s3: "Э6.3 · Сетка: формат, посев, сборка" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1 в состоянии «Система проведения»\n• Только когда состав собран: построить сетку\nраньше нельзя (§4.3)" { class: start }
  z1: "Вводные\n• Участников — из состава\n• Дней и часов игры\n• Столов\n• Возрастных групп" { class: step }
  z2: "Подсказка системы (§5.3)\n• Несколько подходящих систем проведения\n• По каждой: сколько матчей\n• Сколько времени\n• Укладывается ли в столы и часы — светофор\n• Где образуется простой\n• Расчёт раскрывается — видно, из чего\nсложилась оценка\nПредложение рекомендательное." { class: step }
  z3: "Формат ⚠\n• Библиотека: олимпийская\n• Двойное выбывание\n• Круговая\n• Группы + плей-офф — ⚠ перечень\nпредварительный, QUESTIONS 17\n• Нестандартная структура через конструктор\n(§5.2)\n• Удачную конфигурацию можно сохранить\nшаблоном" { class: step }
  z4: "Расстановка\n• Переключатель «посев по рейтингу /\nжеребьёвка»\n• Предпросмотр расстановки\n• Недостающие слоты (bye) добираются\nавтоматически" { class: step }
  a1: "Выбрать систему проведения\nкогда: «Система проведения»\n→ Вводные и формат заполняют конструктор" { class: rbac }
  a2: "«Собрать сетку»\nкогда: «Система проведения»\n→ Движок строит сетку; предпросмотр — дерево\nили таблица групп" { class: rbac }
  a3: "Посев / жеребьёвка\nкогда: «Система проведения»\n→ Расстановка участников; жеребьёвку может\nпроводить секретарь (Э7.2)" { class: rbac }
  a4: "Утвердить сетку\nкогда: «Система проведения»\n→ Сетка готова; утверждение коллегией не\nтребуется (§4.6)" { class: rbac }
  st1: "Состав не собран\nЭкран закрыт с пояснением: сетку раньше\nсостава не строят." { class: block }
  st2: "Ни одна система не укладывается в столы и часы\nВсе варианты с красным светофором, судья\nрешает сам." { class: muted }
}

s4: "Э6.4 · Расписание и столы" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1\n• После сборки сетки (Э6.3)" { class: start }
  z1: "Сетка «дни × столы»\n• Раскладка матчей по дням и столам" { class: step }
  z2: "Карточка матча\n• Участники\n• Круг сетки" { class: step }
  z3: "Конфликты\n• Участник в двух местах — подсвечен\n• Стол занят — подсвечен" { class: step }
  z4: "Трансляция\n• Столы с трансляцией отмечены значком" { class: step }
  a1: "Расставить матчи по дням, столам и времени\nкогда: «Система проведения»\n→ С подсказкой системы" { class: rbac }
  a2: "Отметить трансляционные столы\nкогда: «Система проведения»\n→ Стол получает значок трансляции" { class: rbac }
  a3: "Проверить расписание секретаря\nкогда: расписание составил секретарь (Э7.4)\n→ Судья проверяет и меняет" { class: rbac }
  st1: "Сетки ещё нет\nЭкран пуст, со ссылкой на Э6.3." { class: muted }
}

s5: "Э6.5 · Судьи на столах" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1\n• Зона «Что сейчас требуется» — «на 2 столах\nнет судьи»" { class: start }
  z1: "Список столов\n• Стол\n• Назначенный судья или пустой слот — пустой\nподсвечен" { class: step }
  z2: "Доступные судьи из наряда турнира\n• ФИО\n• Категория\n• На каком столе уже стоит\nНаряд набирает председатель ГСК (Э5.3)." { class: step }
  z3: "Правило под списком\n• Матч не стартует, пока на столе нет судьи\n(§4.7)" { class: step }
  a1: "«Поставить судью на стол»\nкогда: «Система проведения», до и во время\n«Идёт»\n→ Судья видит стол в своём кабинете (Э9.2)" { class: rbac }
  a2: "«Снять / заменить» ✳\nкогда: «Система проведения», до и во время\n«Идёт»\n→ С записью в журнал" { class: rbac }
  st1: "На столе нет судьи\nСлот подсвечен; стол не примет матчи, пока\nсудья не назначен." { class: block }
}

s6: "Э6.6 · Ход турнира" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1 в состоянии «Идёт»" { class: start }
  z1: "Карта столов — карточка по каждому столу\n• Номер стола\n• Судья\n• Текущая пара\n• Счёт по партиям и в партии — обновляется в\nреальном времени\n• Длительность матча\n• Задержка — подсветка, если матч не начался\nвовремя\n• Свободные столы видны сразу" { class: step }
  z2: "Очередь ожидающих пар\n• Пара\n• Круг сетки\n• Планируемые стол и время\nКто играет следующим." { class: step }
  z3: "Сетка\n• Обновляется автоматически после каждого\nрезультата" { class: step }
  a1: "«Вызвать пару на стол»\nкогда: «Идёт»\n→ Уведомление обоим игрокам и судье стола —\nмгновенно (§4.7)" { class: rbac }
  a2: "«Исправить счёт» ⚠\nкогда: «Идёт», в пределах лимита времени\n→ На групповом этапе — до конца этапа,\nдальше — по лимиту (⚠ значения лимитов —\n§13.1); правка в журнал с автором" { class: rbac }
  a3: "«Техническая победа / снятие» ✳\nкогда: «Идёт»\n→ Неявка, отказ, дисциплинарное решение;\nотражается в сетке" { class: rbac }
  st1: "Матч не может стартовать\nНа карточке стола причина — «нет судьи»." { class: block }
  st2: "Обрыв связи у стола\nКарточка помечена; при расхождении приоритет\nу судьи стола (§12)." { class: muted }
}

s7: "Э6.7 · Итоговый протокол" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э6.1, когда все матчи сыграны" { class: start }
  z1: "Итоговая таблица\n• Результаты\n• Места" { class: step }
  z2: "Технические победы и снятия\n• С причинами" { class: step }
  z3: "Правки счёта\n• Из журнала действий" { class: step }
  z4: "Состояние протокола\n• Формируется\n• На утверждении\n• Возвращён с причиной\n• Закрыт" { class: step }
  a1: "«Сформировать протокол»\nкогда: все матчи сыграны\n→ Ввод результатов блокируется; турнир →\n«Итоговый протокол»" { class: rbac }
  a2: "«Отправить на утверждение»\nкогда: протокол сформирован\n→ Уходит председателю ГСК (Э5.4); решение\nпридёт уведомлением" { class: rbac }
  a3: "«Исправить и отправить снова»\nкогда: протокол возвращён\n→ Ввод открыт, причина возврата на экране" { class: rbac }
  a4: "«Печать»\nкогда: после утверждения\n→ Итоговый протокол турнира; протокол матча\n— участники, судья, счёт, дата, подпись\n(§4.9)" { class: rbac }
  st1: "Ожидание решения ГСК\nЭкран «протокол на утверждении» — без кнопок\nправки." { class: muted }
}

head -> s1
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s5
s5 -> s6
s6 -> s7

no: "ЧЕГО РОЛЬ НЕ МОЖЕТ\n• Назначить себя на турнир\n• Утвердить свой же протокол — утверждает председатель\nГСК\n• Менять состав после закрытия приёма заявок ✳\n• Править регламент турнира — судья его исполняет ✳" { class: block }
s7 -> no { class: loop }
q: "ОТКРЫТЫЕ ВОПРОСЫ К ФЕДЕРАЦИИ\n• 17 — перечень форматов сеток предварительный: какие\nформаты нужны на самом деле (Э6.3)\n• §13.1 — значения лимитов времени на правку счёта\nпосле группового этапа (Э6.6)" { class: muted }
s7 -> q { class: loop }
