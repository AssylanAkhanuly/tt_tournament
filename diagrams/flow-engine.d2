...@_theme

direction: down

# ДВИЖОК ТУРНИРОВ И КОНСТРУКТОР СЕТОК — внутренний конвейер.
# Зумит блоки 4 (система проведения) и 6 (продвижение) главного турнирного флоу.
#
# Свой движок за контрактом (ENGINE.md): читает состав и настройки, пишет сетку,
# продвижение и места; счётом (это судья -> GAME) и рейтингом не владеет.
# Перечень форматов уточняется — QUESTIONS §17.

# ── 1. ВХОД И ПОСЕВ ─────────────────────────────────────────────────────────
vhod: "1 · ВХОД И ПОСЕВ" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  roster: "Состав собран\nучастники (ENTRY) + настройки турнира\nформат · дисциплина · число партий · столы · окно дат" { class: start }
  seedq: "Посев или жеребьёвка?" { class: decide }
  seeded: "Посев по рейтингу\n1 против последнего · змейка по группам\nпарные — по среднему рейтингу пары" { class: engine }
  draw: "Случайная жеребьёвка\nseed розыгрыша сохраняется — раскладка воспроизводима" { class: engine }
  norate: "Рейтинга нет — методика не определена (5.1)\n→ падаем на жеребьёвку" { class: muted }

  roster -> seedq
  seedq -> seeded: посев
  seedq -> draw: жеребьёвка
  seeded -> norate: рейтинга нет { class: back }
  norate -> draw
}

# ── 2. ГЕНЕРАЦИЯ СЕТКИ ──────────────────────────────────────────────────────
# Ветвление по формату. Перечень §5.1 предварительный (QUESTIONS §17).
setka: "2 · ГЕНЕРАЦИЯ СЕТКИ · форматы §5.1 (уточняются — QUESTIONS §17)" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  gen: "ДВИЖОК строит сетку по формату\nразмер = ближайшая степень 2\nbye верхним сеяным при нечёте" { class: engine }
  se: "Олимпийская\nодна сетка на выбывание" { class: step }
  de: "Двойное выбывание\nверхняя + нижняя сетки; выбывание после 2 поражений" { class: step }
  rr: "Круговая\nвсе пары · N·(N−1)/2 матчей" { class: step }
  grp: "Группы + плей-офф\nгруппы (круговая) → K лучших в плей-офф" { class: step }
  cons: "Конструктор нестандартной сетки\nручная расстановка · свободные слоты авто\nсохранить шаблон в библиотеку (§5.2)" { class: rbac }

  gen -> se: олимпийская
  gen -> de: двойное выбывание
  gen -> rr: круговая
  gen -> grp: группы+плей-офф
}

# ── 3. РАСПИСАНИЕ ПО СТОЛАМ ─────────────────────────────────────────────────
raspis: "3 · РАСПИСАНИЕ ПО СТОЛАМ · подсказка §5.3" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  calc: "РАСЧЁТ, а не рекомендация (QUESTIONS 7.1)\nучастники·дни·часы·столы → сколько матчей, времени,\nвлезает ли, где простой · несколько вариантов, судья выбирает\nдлительность матча — норматив, пока нет данных (7.2)" { class: engine }
  lay: "Раскладка матчей по столам и времени\nотметка трансляционных столов" { class: step }
  launch: "Сетка построена · турнир стартует" { class: good }

  calc -> lay
  lay -> launch
}

# ── 4. ИГРА И ПРОДВИЖЕНИЕ ───────────────────────────────────────────────────
igra: "4 · ИГРА И ПРОДВИЖЕНИЕ" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  play: "Матч сыгран · исход (winner_side_id)\nсчёт вводит судья — это вне движка (GAME)" { class: step }
  adv: "ДВИЖОК продвигает победителя\nобновляет сетку · идемпотентно (не задваивает)" { class: engine }
  bye: "bye при нечёте\nавтопродвижение без матча" { class: muted }
  wo: "Неявка (attended = false)\nтех. победа сопернику (walkover)" { class: block }
  deroute: "Двойное выбывание\nпроигравший верхней → нижняя сетка" { class: muted }
  more: "Остались матчи?" { class: decide }

  play -> adv
  bye -> adv
  wo -> adv
  adv -> deroute: двойное выбывание { class: loop }
  deroute -> more
  adv -> more
  more -> play: да, следующий матч { class: loop }
}

# ── 5. ИТОГИ И РЕЙТИНГ ──────────────────────────────────────────────────────
itog: "5 · ИТОГИ И РЕЙТИНГ" {
  style.fill: "#fff7ed"
  style.stroke: "#fdba74"

  standings: "Определение мест\nкруговая/группы — таблица: победы → тай-брейки (уточняются)\nолимпийка — по кругу выбывания · матч за 3-е (уточняется)" { class: step }
  places: "Итоговые места → ENTRY.place" { class: good }
  attend: "Сверка явки (блок 7 турнира)\nтолько явившиеся идут в пересчёт" { class: engine }
  rating: "→ РАСЧЁТ РЕЙТИНГА (core.rating)\nдвижок отдаёт итоги, сам рейтинг не считает" { class: good }

  standings -> places
  places -> attend
  attend -> rating
}

# ── СКВОЗНЫЕ СВЯЗИ ──────────────────────────────────────────────────────────
vhod.seeded -> setka.gen: расставлено { class: liveEdge }
vhod.draw -> setka.gen: расставлено { class: liveEdge }
vhod.roster -> setka.cons: своя сетка · мимо посева { class: loop }

setka.se -> raspis.calc { class: liveEdge }
setka.de -> raspis.calc { class: liveEdge }
setka.rr -> raspis.calc { class: liveEdge }
setka.grp -> raspis.calc { class: liveEdge }
setka.cons -> raspis.calc: конструктор { class: liveEdge }

raspis.launch -> igra.play: матчи распределены { class: liveEdge }
igra.more -> itog.standings: матчей больше нет { class: liveEdge }
