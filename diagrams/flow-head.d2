...@_theme

direction: down

# Микрофлоу роли «Главный судья турнира».
# Выделен из общей схемы: глобальный флоу ссылается сюда стрелкой.
# Решения совещания федерации 04.11.2026: заявки участников судья не
# рассматривает — их проверяет система; систему проведения решает сам;
# исправляет счёт на любом этапе; может передать полномочия секретарю или
# заместителю; протокол закрывает сам, сутки его можно исправить.

login: Вход { class: start }
apply: "Подаёт заявку на судейство\nили подтверждает назначение" { class: step }
got: Назначен на турнир { class: good }
squad: "Видит состав\nзаявки проверяет система, допуск — врач" { class: step }
organize: "Выбирает систему проведения\nпо подсказке или сам" { class: step }
draw: "Проводит жеребьёвку по рейтингу\nсекретарь вносит" { class: step }
schedule: Расписание по дням и столам { class: step }
tables: Ставит судей на столы { class: step }
gate: Все столы с судьями? { class: decide }
noRef: "Вызывает пару «без судьи»\nсчёт вносит игрок" { class: step }
start: Запускает турнир { class: step }
engine: "ДВИЖОК: сетка и столы" { class: engine }
watch: "Ведёт турнир: вызывает пары, следит" { class: step }
delegate: "Передаёт полномочия\nсекретарю или заместителю;\nсам только смотрит" { class: step }
override: "Исправляет счёт на любом этапе\nвсё пишется в журнал" { class: block }
allDone: Все матчи сыграны? { class: decide }
close: "Формирует и закрывает\nитоговый протокол" { class: good }
day: "Сутки на исправление,\nпотом пересчитывается рейтинг" { class: good }

login -> apply
apply -> got
got -> squad
squad -> organize
organize -> draw
draw -> schedule
schedule -> tables
tables -> gate
gate -> noRef: нет
gate -> start: да
noRef -> start
start -> engine
engine -> watch
watch -> override
override -> watch { class: back }
watch -> delegate
delegate -> watch: вернул { class: back }
watch -> allDone
allDone -> watch: нет { class: loop }
allDone -> close: да
close -> day
