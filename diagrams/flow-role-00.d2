...@_theme

direction: down

# Роль 0 · Сквозные экраны — поэкранный флоу.
# СГЕНЕРИРОВАНО: npm run gen:diagrams (design/scripts/gen-flow-diagrams.mjs).
# Содержание — flows/00-obshchie-ekrany.md; руками этот файл не правим.
#
# Как читать: контейнер — экран (код Э№.№ в заголовке), внутри
#   синее   — зона экрана: из чего он состоит
#   жёлтое  — действие: что нажимает и когда
#   серое   — состояние экрана или открытый вопрос
#   красное — блокировка, отказ, «нельзя»

head: "0 · СКВОЗНЫЕ ЭКРАНЫ\nЭкраны, которые не принадлежат ни одной роли и есть у всех:\nвход, свой профиль, уведомления и публичная часть без входа.\nУстройство: десктоп, планшет, телефон" { class: rbac }

s1: "Э0.1 · Вход" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Любой адрес системы без действующего входа\n• Ссылка из приглашения (его присылает\nадминистратор Федерации, Э1.10)" { class: start }
  z1: "Вход по логину\n• Логин\n• Пароль\n• Ссылка «забыли пароль»" { class: step }
  z2: "Язык\n• Переключатель RU / KZ / EN — он есть на\nкаждом экране системы" { class: step }
  z3: "Вход по короткому коду — у судьи (TZ §6)\n• Крупное поле на несколько знаков\n• Чтобы войти с планшета за столом, не набирая\nпароль" { class: step }
  z4: "Выбор контекста — если ролей несколько ✳\n• Список ролей с областью каждой («Судья ·\nКубок РК · до 12.10»)\n• Выбор запоминается, переключатель остаётся в\nшапке" { class: step }
  a1: "«Войти»\nкогда: заполнены логин и пароль\n→ Человек попадает на первый экран своей\nроли (Э<роль>.1)" { class: rbac }
  a2: "«Войти по коду»\nкогда: планшет судьи за столом (TZ §6)\n→ Короткий код вместо пароля, дальше —\nрабочий экран судьи (Э9.2)" { class: rbac }
  a3: "Выбор роли в списке ✳\nкогда: у человека больше одной действующей\nроли\n→ Выбранный контекст становится текущим и\nзапоминается" { class: rbac }
  a4: "«Забыли пароль» ✳\nкогда: всегда\n→ Письмо или SMS со ссылкой на смену пароля" { class: rbac }
  st1: "Неверный логин или пароль\nОшибка под полем; поля не очищаются." { class: block }
  st2: "Роль истекла\nРоли нет в списке контекстов, история\nдействий человека сохраняется." { class: muted }
  st3: "Аккаунт не активирован ✳\nПриглашение отправлено, но пароль ещё не\nзадан — стыкуется с Э1.10." { class: muted }
}

s2: "Э0.2 · Свой профиль\nОболочка — той роли, под которой человек вошёл;\nсодержимое одинаковое." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Имя и фото в шапке — они есть на каждом\nэкране системы" { class: start }
  z1: "Профиль\n• Фото\n• ФИО\n• Контакты\n• Язык интерфейса" { class: step }
  z2: "Свои роли — только чтение\n• Роль · область · срок\n• Кто выдал и когда\n• Роли выдаёт администратор Федерации (Э1.11)" { class: step }
  z3: "Безопасность\n• Смена пароля" { class: step }
  a1: "«Править»\nкогда: всегда\n→ Правка своих контактов и фото" { class: rbac }
  a2: "«Сменить пароль»\nкогда: всегда\n→ Смена пароля" { class: rbac }
  a3: "Строка роли\nкогда: всегда\n→ Только чтение: свою роль отсюда не выдать\nи не продлить" { class: rbac }
  st1: "Срок роли скоро истекает ✳\nВидно, когда роль заканчивается и кто её\nвыдал." { class: muted }
  st2: "Роль истекла ✳\nОстаётся в списке серой, с датой окончания." { class: muted }
}

s3: "Э0.3 · Уведомления" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Счётчик в шапке — он есть на каждом экране\nсистемы" { class: start }
  z1: "Лента уведомлений\n• Значок типа\n• Текст\n• Время\n• Ссылка на экран, к которому уведомление\nотносится — заявка, матч, протокол\n• Непрочитанные выделены, счётчик — в шапке" { class: step }
  z2: "Перечень событий (TZ §10.1)\n• Решение по заявке на судейство\n• Заявка принята или отклонена\n• Пара вызвана на стол\n• Протокол утверждён или возвращён\n• Турнир завершён, рейтинг пересчитан\n• Турнир отменён или перенесён" { class: step }
  a1: "Строка уведомления\nкогда: всегда\n→ Переход на экран, о котором уведомление" { class: rbac }
  a2: "«Отметить все прочитанными» ✳\nкогда: есть непрочитанные\n→ Счётчик в шапке обнуляется" { class: rbac }
  st1: "Непрочитанных нет ✳\nПустая лента с подписью, что новые появятся\nздесь." { class: muted }
  st2: "⚠ 11 — куда приходят уведомления ролям без приложения\nБраузер, почта или SMS и можно ли их\nотключать — не решено. Приложение есть\nтолько у спортсмена." { class: muted }
}

s4: "Э0.4 · Публичные страницы\nРоли нет — это отсутствие роли (TZ §3). Видны всем, в\nтом числе каждой роли системы." {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Адрес сайта без входа\n• Ссылка из новости или из результатов" { class: start }
  z1: "Главная сайта\n• Ближайшие и текущие турниры\n• Матчи в реальном времени\n• Лидеры рейтинга\n• Новости" { class: step }
  z2: "Страница турнира\n• Состав\n• Сетка\n• Расписание\n• Результаты\n• Счёт в реальном времени\n• Трансляция" { class: step }
  z3: "Рейтинги и профили\n• Рейтинг игроков — таблица с фильтрами,\nпостранично до 500 строк\n• Рейтинг судей — публичная таблица (TZ §7.2)\n• Профиль игрока — рейтинг, статистика,\nистория матчей\n• Новости на трёх языках" { class: step }
  a1: "«Войти»\nкогда: всегда\n→ Экран входа" { class: rbac }
  a2: "Строка турнира\nкогда: всегда\n→ Публичная страница турнира" { class: rbac }
  a3: "Переключатель языка\nкогда: всегда\n→ RU / KZ / EN, как и внутри системы" { class: rbac }
  st1: "Действие требует входа ✳\nЗаявка, счёт, правка — любое действие ведёт\nна экран входа." { class: muted }
  st2: "⚠ 12.9 — открыта ли публичная часть без входа\nПодтвердить у федерации: мы исходим из того,\nчто открыта (TZ §3)." { class: muted }
}

head -> s1
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s1: "«Войти»" { class: loop }

no: "ЧЕГО РОЛЬ НЕ МОЖЕТ\n• Выдать себе роль — роли выдаёт администратор\nФедерации (Э1.11)\n• Изменить чужой профиль\n• Сделать что-либо в публичной части без входа" { class: block }
s4 -> no { class: loop }
q: "ОТКРЫТЫЕ ВОПРОСЫ К ФЕДЕРАЦИИ\n• 11 — куда приходят уведомления ролям без приложения\nи можно ли их отключать\n• 12.9 — подтвердить, что публичная часть открыта без\nвхода" { class: muted }
s4 -> q { class: loop }
