...@_theme

direction: down

# Роль 14 · Спортсмен — поэкранный флоу.
# СГЕНЕРИРОВАНО: npm run gen:diagrams (design/scripts/gen-flow-diagrams.mjs).
# Содержание — flows/14-sportsmen.md; руками этот файл не правим.
#
# Как читать: контейнер — экран (код Э№.№ в заголовке), внутри
#   синее   — зона экрана: из чего он состоит
#   жёлтое  — действие: что нажимает и когда
#   серое   — состояние экрана или открытый вопрос
#   красное — блокировка, отказ, «нельзя»

head: "14 · СПОРТСМЕН\nСамостоятельная регистрация на участие в ОРТ (TZ §2).\nУстройство: сайт и мобильное приложение (Android, iOS) —\nединственная роль с приложением; оба канала полноценные,\nаккаунт и данные общие (TZ §10)" { class: rbac }

s1: "Э14.1 · Главная" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Первый экран после входа — и в приложении, и\nна сайте" { class: start }
  z1: "Мой рейтинг\n• Значение\n• Место\n• Дельта после последнего турнира" { class: step }
  z2: "Ближайший турнир\n• Название\n• Даты\n• Состояние моей заявки\n• Если турнира нет — подводка к календарю" { class: step }
  z3: "Сейчас играю — во время турнира\n• Мой текущий или следующий матч\n• Соперник\n• Стол\n• Время\n• Ссылка на мой турнир и матч (Э14.5)" { class: step }
  z4: "Лента\n• Последние результаты\n• Уведомления\n• Новости федерации" { class: step }
  z5: "Уведомления (§10.1)\n• Заявка принята / отклонена — открывает мою\nзаявку (Э14.4)\n• Пара вызвана на стол — открывает мой матч\n(Э14.5)\n• Турнир завершён, рейтинг пересчитан\n• Турнир отменён или перенесён\nКаждое уведомление открывает свой экран." { class: step }
  a1: "Карточки главной\nкогда: всегда\n→ Переходы; всё содержимое — своё, чужих\nданных на главной нет" { class: rbac }
  a2: "Уведомление «заявка принята / отклонена»\nкогда: после решения по заявке\n→ Открывает мою заявку" { class: rbac }
  a3: "Уведомление «пара вызвана на стол»\nкогда: во время турнира\n→ Открывает мой турнир и матч" { class: rbac }
  st1: "Ближайшего турнира нет\nВместо карточки турнира — подводка к\nкалендарю." { class: muted }
  st2: "Турнир идёт\nПоявляется блок «Сейчас играю»: текущий или\nследующий матч — соперник, стол, время." { class: muted }
}

s2: "Э14.2 · Календарь" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Меню «Турниры»" { class: start }
  z1: "Список соревнований\n• Название\n• Категория — бейдж\n• Город\n• Даты\n• Состояние" { class: step }
  z2: "Что видит вместо кнопки — по категориям\n• Главный старт — «Состав подаёт старший\nтренер региона», кнопки нет\n• Евразийская лига — «Заявляет клуб»; если\nзаявлен — «Вы заявлены за команду N»\n• ОРТ — кнопка «Заявиться»\nПо каждому турниру видно, как в него\nпопадают — правило §8.2 прямо в карточке." { class: step }
  z3: "Условия допуска в карточке турнира\n• Возрастная граница\n• Ценз по рейтингу — если мой рейтинг не\nпроходит, сказано сразу\n• Требуется ли годовой взнос\n• Нужны ли документы" { class: step }
  a1: "«Заявиться»\nкогда: ОРТ, приём заявок открыт\n→ Форма заявки на открытый республиканский\nтурнир" { class: rbac }
  st1: "Приём не открыт / закрыт\nКнопка заменена сроком." { class: muted }
  st2: "Взнос не оплачен, а турнир его требует\nКнопка с предупреждением — ⚠ 6.1." { class: muted }
}

s3: "Э14.3 · Заявка на ОРТ" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Кнопка «Заявиться» в Э14.2" { class: start }
  z1: "Разряд ⚠\n• Одиночный\n• Парный — выбор партнёра ✳ (заявка парой,\n§8.2)\n• ⚠ Как именно пара подтверждается вторым\nигроком — не описано" { class: step }
  z2: "Документы\n• Загрузка файлов — если у турнира флаг\nдокументов" { class: step }
  z3: "Проверки перед отправкой\n• Возраст\n• Ценз по рейтингу\n• Взнос\n• Непроходящее показано до подачи" { class: step }
  a1: "«Подать заявку»\nкогда: приём заявок открыт\n→ Уходит главному судье турнира (Э6.2);\nрешение придёт уведомлением" { class: rbac }
  a2: "Подача тренером за игрока\nкогда: по §8.2\n→ Тренер может подать за игрока — тогда в\n«Моей заявке» видно, кто подал" { class: rbac }
  st1: "Пара — подтверждение вторым игроком\n⚠ Не описано, как именно партнёр\nподтверждает пару; дальше не проектируем." { class: muted }
}

s4: "Э14.4 · Моя заявка" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э14.1\n• Э14.2\n• Уведомление о решении" { class: start }
  z1: "Заявки по турнирам\n• Турнир\n• Подана когда\n• Кем — сам / тренер\n• Состояние: подана / принята / отклонена с\nпричиной (причина — текст судьи, видна\nсразу)" { class: step }
  a1: "«Исправить и подать снова»\nкогда: после отказа, пока приём открыт\n→ Форма заявки с данными этой заявки" { class: rbac }
  a2: "«Отозвать» ✳\nкогда: до закрытия приёма\n→ Выход из списка; уведомление организатору" { class: rbac }
  st1: "Заявка отклонена\nПричина — текст судьи, видна сразу; пока\nприём открыт можно исправить и подать снова." { class: block }
  st2: "Заявка принята\nДальше — вызов на стол уведомлением, экран\nматча (Э14.5)." { class: good }
}

s5: "Э14.5 · Мой турнир и мой матч" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Э14.1 во время турнира\n• Уведомление «пара вызвана»" { class: start }
  z1: "Моя сетка\n• Сетка турнира с подсветкой своего пути\n• В приложении — зумируемая (§5.2)" { class: step }
  z2: "Мой матч\n• Соперник — имя, рейтинг, личные встречи с\nним\n• Номер стола\n• Время\n• Статус «готовьтесь — вы следующие»\n• Статус «вас вызвали — подойдите к столу N» —\nпосле вызова главным судьёй" { class: step }
  z3: "Во время игры\n• Счёт по партиям и очкам в реальном времени\n• Счёт ведёт судья — спортсмен его не вводит и\nне подтверждает" { class: step }
  z4: "После матча\n• Результат по партиям\n• Следующий круг" { class: step }
  a1: "Всё содержимое экрана\nкогда: турнир идёт\n→ Только просмотр и переходы" { class: rbac }
  a2: "Уведомление «рейтинг пересчитан»\nкогда: после завершения турнира\n→ Открывает аналитику" { class: rbac }
  st1: "Счёт своего матча спортсмен не вводит\nСчёт ведёт судья на столе; спортсмен его не\nвводит и не подтверждает — экран только\nпоказывает." { class: block }
  st2: "Вас вызвали\n«Подойдите к столу N» — после вызова главным\nсудьёй." { class: good }
}

s6: "Э14.6 · Аналитика" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Меню «Аналитика»\n• После пересчёта рейтинга" { class: start }
  z1: "Базовая\n• Матчи, победы / поражения, винрейт\n• График динамики рейтинга\n• История матчей — турнир, соперник, счёт по\nпартиям, дата" { class: step }
  z2: "Личные встречи\n• Выбор соперника — баланс встреч\n• Список матчей с этим соперником" { class: step }
  z3: "Расширенная — платная ⚠\n• ⚠ Состав расширенной аналитики не\nзафиксирован\n• По очкам: длина розыгрышей, ход партий —\nматериал есть при вводе по очкам ✳\n• До решения — заглушка «подключить»" { class: step }
  a1: "«Подключить расширенную» ⚠\n→ ⚠ Как оплачивается, не решено" { class: rbac }
  st1: "Расширенная аналитика — заглушка\nСостав расширенной аналитики и её оплата не\nзафиксированы; до решения кнопка ведёт на\nзаглушку «подключить»." { class: muted }
}

s7: "Э14.7 · Профиль и взнос" {
  grid-columns: 2
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  entry: "КАК СЮДА ПОПАДАЕТ\n• Меню «Профиль»" { class: start }
  z1: "Профиль\n• Фото\n• Данные\n• Клуб\n• Тренер\n• Разряд" { class: step }
  z2: "Годовой взнос\n• Состояние: оплачен / не оплачен / просрочен\n• Год\n• Напоминание, на каких турнирах взнос\nтребуется" { class: step }
  a1: "Править свои контакты\nкогда: всегда\n→ Меняются свои контакты" { class: rbac }
  a2: "«Оплатить взнос»\nкогда: взнос не оплачен\n→ Оплата картой на платёжной странице Халык\nБанка (ePay), возврат обратно в приложение\n(§9.2)" { class: rbac }
  st1: "Оплачено\nСостояние меняется само, по подтверждению\nбанка, и видно также тренеру спортсмена\n(§9.2)." { class: good }
  st2: "Ждём подтверждения банка\n«Платёж обрабатывается». Вкладку держать не\nнужно: закрыл приложение сразу после оплаты\n— взнос всё равно станет оплаченным." { class: muted }
  st3: "Оплата не прошла\nПричина от банка и кнопка повторить." { class: block }
}

head -> s1
s1 -> s2
s2 -> s3
s3 -> s4
s4 -> s5
s5 -> s6
s6 -> s7
s4 -> s3: "«Исправить и подать снова»" { class: loop }

no: "ЧЕГО РОЛЬ НЕ МОЖЕТ\n• Вводить и подтверждать счёт своего матча — счёт\nведёт судья\n• Заявляться на главные старты — состав подаёт старший\nтренер региона\n• Заявляться в Евразийскую лигу — заявляет клуб\n• Видеть чужие заявки и документы" { class: block }
s7 -> no { class: loop }
q: "ОТКРЫТЫЕ ВОПРОСЫ К ФЕДЕРАЦИИ\n• 6.3 — чей счёт и договор эквайринга: федерации\nцеликом или каждого региона\n• Как пара подтверждается вторым игроком при парной\nзаявке — не описано\n• Состав платной расширенной аналитики и как она\nоплачивается" { class: muted }
s7 -> q { class: loop }
