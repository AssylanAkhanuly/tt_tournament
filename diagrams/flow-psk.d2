...@_theme

direction: down

# Микрофлоу роли «Председатель судейской коллегии».
# Выделен из общей схемы: глобальный флоу ссылается сюда стрелкой.
# Решения совещания федерации 04.11.2026: судьи — и заявками, и назначением;
# итоговый протокол председатель не утверждает — его закрывает главный судья.

login: Вход { class: start }
create: "Заводит турнир\nназвание · уровень · город · окно дат" { class: step }
openRef: Открывает приём заявок судей { class: step }
inbox: "Заявки судей\nрейтинг · категория · история" { class: step }
pick: "Собирает коллегию из заявок\nглавный судья · секретарь · заместитель · судьи" { class: step }
enough: Заявок хватает? { class: decide }
assign: "Назначает недостающих из реестра\nсудья получает уведомление и подтверждает" { class: step }
gateOrg: "Согласует систему проведения?\nне договорились" { class: block }
protocol: "Видит закрытый протокол\nтолько чтение" { class: good }

login -> create
create -> openRef
openRef -> inbox
inbox -> pick
pick -> enough
enough -> assign: нет
enough -> gateOrg: да
assign -> gateOrg
gateOrg -> protocol
