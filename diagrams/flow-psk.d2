...@_theme

direction: down

# Микрофлоу роли «Председатель судейской коллегии» (ФНТ ТЗ v1.5).
# Выделен из общей схемы: глобальный флоу ссылается сюда стрелкой.

login: Вход { class: start }
create: "Заводит турнир\nназвание · уровень · город · окно дат" { class: step }
openRef: Открывает приём заявок судей { class: step }
inbox: "Заявки судей\nрейтинг · категория · история" { class: step }
pick: Выбирает судью { class: step }
gateOrg: "Система проведения утверждена?" { class: decide }
rework: "Возврат с причиной\nтурнир не публикуется" { class: block }
publish: "Утверждает — турнир опубликован" { class: good }
gateRes: "Итоговый протокол утверждён?" { class: decide }
fix: "Возврат с причиной\nввод открывается снова" { class: block }
accept: "Утверждает — рейтинг пересчитывается" { class: good }

login -> create
create -> openRef
openRef -> inbox
inbox -> pick
pick -> gateOrg
gateOrg -> rework: нет { class: back }
rework -> gateOrg { class: back }
gateOrg -> publish: да
publish -> gateRes
gateRes -> fix: нет { class: back }
fix -> gateRes { class: back }
gateRes -> accept: да
