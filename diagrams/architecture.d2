...@_theme

# СИСТЕМНЫЙ ДИЗАЙН — слоями сверху вниз.
#
# Раньше здесь было direction: right одной лентой, и получалось 5829×1022:
# шесть экранов в ряд, читать невозможно. Теперь каждый слой — своя рамка,
# а стрелки между рамками идут вниз.
#
# НЕ СТАВИТЬ grid-columns на эти контейнеры. Пробовал: контейнер становится
# грид-контейнером, direction: down у корня перестаёт действовать, и все шесть
# слоёв выстраиваются в один ряд — 6771×438, ещё хуже исходного.
#
# ВАЖНО: обратных рёбер быть не должно. ELK послойный, цикл он ломает
# разворотом ребра и переворачивает схему. Связь "счёт в реальном времени →
# клиенты" поэтому не рисуется, а живёт подписью на узле.
direction: down

# ── 1. КЛИЕНТЫ ──────────────────────────────────────────────────────────────
clients: "1 · КЛИЕНТЫ · кто и с чего работает" {
  style.fill: "#f8faff"
  style.stroke: "#93c5fd"

  tablet: "Судья стола\nадаптивный сайт, обычно планшет\nофлайн-очередь на устройстве" { class: client }

  # У игрока ДВА канала, и это не «или», а «и»: дома и с чужого компьютера он
  # заходит на сайт, в зале между матчами — с приложения. Поэтому оба канала
  # показаны отдельными узлами и оба полноценные, приложение не урезано.
  player: "ИГРОК · два канала, оба полноценные" {
    style.fill: "#eef2ff"
    style.stroke: "#3b82f6"
    style.stroke-width: 3

    web: "Веб · Next.js 16 + React 19\nтот же сайт, любой браузер" { class: client }
    app: "Приложение · Android и iOS\npush через FCM и APNs" { class: client }
    note: "Один аккаунт, одни данные, один backend.\nРазличие только в push: он есть в приложении,\nв вебе решено не делать (Q 11.1).\nНа клубных счёт вводит главный судья (§6.4)" { class: muted }
  }

  desktop: "Десктоп · тот же Next.js\nадминистратор · федерация · коллегия · главный судья\nтренер · бухгалтер · организатор клуба" { class: client }
  guest: "Гость\nтолько чтение" { class: muted }
}

# ── 2. ФРОНТ ────────────────────────────────────────────────────────────────
# У Next.js запрос уходит из двух разных мест, и это не деталь реализации:
# от того, откуда он идёт, зависит, что вообще возможно. SSE, например,
# бывает только из браузера — серверный компонент отрендерился и умер, держать
# соединение ему нечем.
#
# Мобильное приложение через Next.js НЕ ходит: у него свой рендер, ему нужен
# только API. Поэтому его стрелка идёт мимо этого слоя.
front: "2А · ВЕБ · Next.js 16, App Router · Node-процесс на Railway" {
  style.fill: "#eef2ff"
  style.stroke: "#3b82f6"

  # ── что рендерится на сервере Next
  #
  # КЭША ПОКА НЕТ СОВСЕМ — это решение, а не недоделка. Каждый рендер идёт в
  # Django за свежими данными. Турнир — штука живая: сетка, состав и счёт
  # меняются во время игры, и устаревшая страница здесь дороже лишнего
  # запроса. Кэш вернём, когда будет видно, какие страницы реально читают
  # чаще, чем меняют.
  nocache: "КЭША НЕТ · осознанно\nни ISR, ни кэша запросов: каждый рендер\nидёт в Django за свежими данными\nданные турнира меняются по ходу игры" { class: block }

  rsc: "Серверные компоненты (RSC)\nстраница турнира, сетка, состав, профиль:\nданные тянутся на сервере Next и приезжают\nуже готовой разметкой" { class: service }

  # ── что живёт в браузере
  client: "Клиентские компоненты\nпосле гидрации: интерактив, формы,\nлокальное состояние" { class: client }

  # Это не выбор, а свойство технологии: держать открытое соединение или
  # хранить ключ подписки серверный компонент не может — он отрендерился
  # и умер. Такие вещи возможны ТОЛЬКО в браузере.
  only: "ТОЛЬКО ИЗ БРАУЗЕРА · не наш выбор\nSSE-поток счёта: EventSource живёт здесь\nподписка на push: ключ у устройства\nоптимистичный отклик до ответа сервера" { class: live }

  # Server Actions здесь больше нет, и вот почему.
  #
  # Единственное, ради чего они были нужны, — сбросить кэш Next после мутации:
  # revalidatePath и revalidateTag работают только на сервере. Кэш убрали —
  # сбрасывать нечего, и лишний прыжок браузер → Next → Django остался бы без
  # причины.
  #
  # Довод «браузер не видит адресов Django» не считается: приложение на Expo
  # ходит в Django напрямую, значит API и так смотрит наружу. Прятать от
  # браузера то, что открыто телефону, смысла нет.
  #
  # Побочная выгода: у веба и приложения теперь один и тот же путь мутаций,
  # то есть один контракт, который проверяют оба клиента.
  mutate: "Мутации — прямо в Django, мимо сервера Next\nServer Actions не используем: они нужны были\nтолько чтобы сбрасывать кэш, а кэша нет\nтот же путь, что у приложения — один контракт" { class: good }

  # Куки httpOnly: браузер отправляет их сам. Раз мутации идут напрямую в
  # Django, это уже кросс-доменный запрос — нужен общий родительский домен
  # и CORS с учётом кук. Серверу Next при рендере куку надо пробрасывать
  # руками, автоматически она туда не попадает.
  cookies: "JWT в httpOnly-куках\nиз браузера уходят сами, но домен общий:\nсайт и API под одним родительским доменом,\nCORS с credentials. С сервера Next — вручную" { class: step }

  nocache -> rsc
  rsc -> client: гидрация
  client -> only
  client -> mutate
}

# ── 2Б. ПРИЛОЖЕНИЕ ──────────────────────────────────────────────────────────
# Главное отличие от веба: серверной половины здесь нет вообще. Всё рендерится
# на устройстве, и «что на сервере, а что на клиенте» не стоит — всё на
# клиенте. Поэтому у приложения нет ни RSC, ни Server Actions, ни ISR: экраны
# собираются на телефоне, данные тянутся прямо из API.
#
# Два места, где приложение расходится с вебом и это придётся учесть в API:
#   * авторизация — не куки, а токен в защищённом хранилище устройства;
#   * SSE — в React Native нет EventSource, нужен polyfill.
expo: "2Б · ПРИЛОЖЕНИЕ · Expo (React Native) · Android и iOS" {
  style.fill: "#eef2ff"
  style.stroke: "#3b82f6"

  router: "Expo Router\nфайловая навигация, как в Next,\nно СЕРВЕРНОЙ ПОЛОВИНЫ НЕТ:\nвсе экраны рендерятся на устройстве" { class: client }
  data: "Данные\nfetch прямо в API, без промежуточного слоя\nкэш и офлайн-состояние на устройстве" { class: step }

  # Расхождение с вебом, которое упирается в бэкенд
  auth: "АВТОРИЗАЦИЯ ИНАЧЕ, ЧЕМ В ВЕБЕ\nhttpOnly-куки в приложении не работают:\nтокен лежит в SecureStore и уходит\nзаголовком Authorization" { class: rbac }

  sse: "SSE: нужен polyfill\nв React Native нет EventSource,\nставим react-native-sse.\nПоток тот же, что у веба" { class: live }

  push: "Push · expo-notifications\ngetExpoPushTokenAsync — токен Expo, один на обе ОС\nрегистрируется при входе, отзывается при выходе" { class: service }

  # ── путь релиза: сборка → тестовый круг → магазины → правки по воздуху.
  # Развёрнуто из одного узла «Выкатка» по просьбе: видно, где TestFlight,
  # где ревью, и что уходит мимо ревью.
  # После сборки пути расходятся: у Apple и Google свои тестовые треки, свои
  # ревью и свои скорости. Сходятся обратно только на expo-updates — правки по
  # воздуху общие для обеих ОС. Разными ветками нарисовано намеренно: когда
  # надо срочно чинить, «часы у Google» и «день-два у Apple» — это два разных
  # плана действий, а не один.
  build: "Сборка · EAS Build\nоблако Expo собирает бинарники обеих ОС,\nсвой мак для iOS не нужен" { class: step }

  # ── ветка Apple
  tf: "TestFlight · iOS\nвнутренние тестеры — сразу после сборки\nвнешние (судьи, федерация) — после\nлёгкой проверки Apple, обычно в тот же день" { class: service }
  appstore: "App Store\nревью — обычно день-два, бывает дольше\nоткат бинарника невозможен —\nтолько новая версия через новое ревью" { class: good }

  # ── ветка Google
  playtest: "Внутренний трек · Google Play\nтестеры по ссылке, без проверки Google\nобновления тестерам — за минуты" { class: service }
  play: "Google Play\nревью — часы\nпоэтапная раскатка по проценту пользователей:\nпроблема видна на 5% раньше, чем у всех" { class: good }

  ota: "Правки по воздуху · expo-updates\nобщие для обеих ОС: JS и ассеты — мимо ревью,\nза минуты. Новая нативная библиотека так\nне уедет — снова полный круг через магазин" { class: live }

  router -> data
  router -> auth
  data -> sse
  data -> push
  build -> tf: сборка iOS
  build -> playtest: сборка Android
  tf -> appstore: приняли — подаём
  playtest -> play: приняли — подаём
  appstore -> ota
  play -> ota: дальше мелкие правки — по воздуху
}

# ── 3. ВХОД ─────────────────────────────────────────────────────────────────
entry: "3 · ВХОД И ПРАВА · Django + DRF на Railway" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  # Два способа принести один и тот же JWT: веб — куками, приложение —
  # заголовком. Это не два вида авторизации, а один токен и два транспорта.
  gw: "API-шлюз · HTTPS\nиз веба — JWT в httpOnly-куках\nиз приложения — Bearer-заголовок\nтокен один, транспорт разный" { class: gate }
  auth: "Аутентификация\nвход по паролю или короткому коду" { class: service }
  rbac: "АВТОРИЗАЦИЯ\nроль → область → право\nдесять ролей (§2), в т.ч. организатор клуба" { class: rbac }

  gw -> auth: вход
  gw -> rbac: проверка прав
}

# ── 4. ПРИКЛАДНЫЕ СЕРВИСЫ ───────────────────────────────────────────────────
apps: "4 · ПРИКЛАДНЫЕ СЕРВИСЫ · Django 4.2 + DRF · gunicorn на Railway" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  # Профиль появился, когда разделяли PostgreSQL и R2: у USER есть photo_url,
  # у заявок — документы, а сервиса, который этими файлами владеет, на схеме
  # не было. Фото не относится ни к аутентификации, ни к заявкам.
  profile: "Профиль и аккаунт\nданные игрока, фото, клуб, город" { class: service }

  tournaments: "Турниры, столы и настройки\nдва типа: официальный и клубный\nсвойства — независимые флаги, не категория (§4.2)" { class: service }
  applications: "Заявки\nсудей на турнир (только официальные)\nигроков · самозапись на клубные (§4.3, §8)" { class: service }
  fees: "Платежи\nгодовой взнос (бухгалтер) + плата за турнир\n(организатор клуба) — две разные сущности (§9)" { class: service }
  score: "Счёт\nсудья стола (официальный) либо\nглавный судья (клубный, §6)" { class: service }
  referee: "Регламент\nподача и смена сторон" { class: service }
  analytics: "Аналитика игрока\nбесплатная и платная (§11)" { class: service }
}

# ── 5. ДВИЖОК И РАСЧЁТЫ ─────────────────────────────────────────────────────
core: "5 · ДВИЖОК И РАСЧЁТЫ · Python, там же" {
  style.fill: "#f0fdf4"
  style.stroke: "#86efac"

  engine: "ДВИЖОК ТУРНИРОВ И КОНСТРУКТОР СЕТОК\nПЕРЕИСПОЛЬЗУЕТСЯ: внутри ничего не переписываем" { class: engine }
  rating: "РАСЧЁТ РЕЙТИНГА\nметодика не определена — блокер (Q 5.1)\nофициальные — всегда; клубные — по флагу is_rated (§4.1)" {
    style: { fill: "#fffbeb"; stroke: "#f59e0b"; stroke-width: 3 }
  }
}

# ── 6. РЕАЛЬНОЕ ВРЕМЯ ───────────────────────────────────────────────────────
# Здесь показан сам ход SSE, а не только упоминание технологии. Читается
# слева направо: очко записано → шина → поток держится открытым → его слушают.
#
# ШИНА — ответ на дыру, которая была в прошлой версии схемы: «сервис счёта
# публикует событие» рисовалось стрелкой, а транспорта под ней не было. Счёт
# принимает gunicorn, поток держит uvicorn — процессы разные, общей памяти
# нет. Транспорт — LISTEN/NOTIFY в самом PostgreSQL: база уже есть, Redis
# ради одного канала не заводим. Лимит NOTIFY — 8 КБ, поэтому в сообщении
# только id матча, счёт получатель дочитывает из базы.
rt: "6 · РЕАЛЬНОЕ ВРЕМЯ И УВЕДОМЛЕНИЯ · Railway" {
  style.fill: "#fdfaff"
  style.stroke: "#ddd6fe"

  # SSE, а не WebSocket: счёт идёт в одну сторону. Обратный канал не нужен —
  # судья отправляет очко обычным POST. Плата в том, что соединение висит и
  # синхронный воркер gunicorn занят им целиком, поэтому отдельный процесс.
  emit: "Очко записано\nсервис счёта пишет в базу и делает NOTIFY" { class: step }
  bus: "ШИНА СОБЫТИЙ · LISTEN/NOTIFY в самом PostgreSQL\nмежду процессами нет общей памяти — нужен транспорт\nв сообщении только id матча (лимит NOTIFY — 8 КБ),\nсчёт получатель дочитывает из базы\nотдельный брокер (Redis) не нужен" { class: gate }
  stream: "SSE-ПОТОК · uvicorn (ASGI)\nContent-Type: text/event-stream\nсоединение держится открытым" { class: live }
  reconnect: "Обрыв связи\nбраузер сам переподключается,\nотдельной логики не пишем" { class: block }
  listeners: "Поток слушают\nстраница турнира · приложение игрока\nтабло в зале · гость без входа" { class: client }

  broadcast: "Трансляция на YouTube\nсчёт поверх видео со столов,\nбез оператора (§6.3)" { class: live }

  # Отправляем через Expo Push Service. Это не альтернатива FCM и APNs, а релей
  # поверх них: Django шлёт один POST на exp.host, Expo разводит по платформам.
  #
  # Сначала выбрали прямой FCM — ради того, что он закрывает и браузер тоже,
  # пока Q 11.1 не решён. Вопрос закрыли: веб-push не нужен, а если понадобится,
  # его делают отдельным каналом. Довод исчез, и остался простой счёт: мы уже на
  # Expo, отправка — один HTTP-запрос без firebase-admin и без ключа APNs в
  # Django, ключами управляет EAS.
  # ВОРКЕР — ответ на вторую дыру: всё остальное в дизайне только отвечает на
  # запросы, а три вещи должны случаться «сами»: рассылка не в цикле запроса,
  # квитанции забираются через минуты ПОСЛЕ отправки, пересчёт рейтинга долгий.
  # Очередь задач — procrastinate, она живёт в PostgreSQL и будится тем же
  # LISTEN/NOTIFY. Celery не берём по общему правилу: не добавлять хранилище
  # (Redis), пока единственное, что от него нужно, умеет Postgres.
  worker: "ВОРКЕР · третий процесс на Railway\nделает работу «потом», без входящего запроса:\nрассылка push · квитанции через минуты · пересчёт\nрейтинга. Очередь задач — procrastinate в PostgreSQL,\nбудится той же LISTEN/NOTIFY" { class: engine }

  notify: "Уведомления · семь событий (§10.1)\nExpo Push Service — релей поверх FCM и APNs\nворкер шлёт один POST на exp.host\nключами APNs и FCM управляет EAS, не мы\nтолько приложение: веб-push решено не делать" { class: service }

  # Квитанции — не деталь, а единственный способ узнать, что токен умер.
  # Без них список устройств копит мусор после переустановок.
  receipts: "Квитанции доставки\nворкер спрашивает статус через минуты после отправки\nDeviceNotRegistered — токен удаляем из PUSH_TOKEN" { class: step }
  inbox: "Лента уведомлений в интерфейсе\nтаблица NOTIFICATION — пропущенный push\nне теряет действие" { class: step }

  emit -> bus: "NOTIFY: id матча"
  bus -> stream: "LISTEN: дочитал счёт, отдал в поток"
  bus -> worker: будит задачей
  stream -> listeners: поток событий
  stream -> reconnect: сеть пропала { class: back }
  worker -> notify: рассылает
  notify -> inbox: дублируется всегда
  notify -> receipts: проверяем, дошло ли
}

# ── 7. ДАННЫЕ ───────────────────────────────────────────────────────────────
# Таблицы лежат прямо здесь, внутри PostgreSQL: видно, что именно хранится за
# словом «данные». А вот СВЯЗЕЙ между ними здесь нет, и это не забывчивость.
# Пробовал с ними: два десятка внешних ключей внутри вложенного контейнера
# elk растягивает через всё полотно, схема стала 6778×8121 и превратилась в
# паутину. Связи живут на отдельной схеме доменной модели, она под это сделана.
#
# Отдельного узла «Аудит счёта» больше нет: это таблица SCORE_LOG, она внутри
# и подсвечена красным. Два узла об одном и том же расходились бы.
#
# Тело вставляется из domain.d2 скриптом sync-domain.py — правим только
# domain.d2, иначе две копии модели разъедутся.
#
# PostgreSQL и R2 — РАЗНЫЕ хранилища у разных поставщиков, и раньше они были
# слиты в один заголовок слоя. По схеме нельзя было понять, что куда пишется.
# Теперь это два соседних блока, и стрелки из сервисов приходят в конкретный:
# строки — в базу, байты — в R2.
storage: "7 · ДАННЫЕ · два разных хранилища" {
  style.fill: "#f0fdfa"
  style.stroke: "#5eead4"

  # R2, а не S3: у Cloudflare нет платы за исходящий трафик. Для нас это
  # прямо считается — фото игроков и афиши раздаются на каждый просмотр
  # расписания. Протокол тот же S3, работаем через boto3 с
  # AWS_S3_ENDPOINT_URL, как уже настроено в tt_back.
  files: "Cloudflare R2 · файлы\nфото игроков · документы к заявкам\nв базе лежит только ключ объекта, не сам файл\nS3-совместимый: boto3, AWS_S3_ENDPOINT_URL\nисходящий трафик бесплатный — потому R2, а не S3" {
    style.fill: "#fff7ed"
    style.stroke: "#f97316"
    style.stroke-width: 3
  }

  # Копии — не «галочка площадки». Снимки Railway живут внутри Railway: если
  # проблема в аккаунте, вместе с базой пропадут и они. Поэтому свой pg_dump
  # уходит к другому поставщику.
  #
  # Про согласованность двух хранилищ: в базе только ключ, байты в R2. Откат
  # базы на вчера при живом R2 безопасен ТОЛЬКО потому, что из R2 мы ничего не
  # удаляем физически — объект, на который сошлётся восстановленная строка,
  # на месте. Осиротевшие объекты безвредны, это просто оплаченные байты.
  backup: "РЕЗЕРВНЫЕ КОПИИ\nсвой pg_dump — в бакет копий, не только снимки Railway\nво время турнира — восстановление на любой момент\nиз R2 НЕ УДАЛЯЕМ ФИЗИЧЕСКИ: удаление — флаг в базе,\nиначе откат базы оставит битые ссылки\nбакет копий закрыт на перезапись — журнал §12 неизменяем" {
    style.fill: "#fef2f2"
    style.stroke: "#dc2626"
    style.stroke-width: 3
  }

  # grid-columns здесь можно и нужно: контейнер вложенный, на direction корня
  # он не влияет (в отличие от слоёв верхнего уровня — см. шапку файла).
  # Без сетки elk раскладывает таблицы по логике внешней схемы и они
  # расползаются по всей ширине.
  pg: "PostgreSQL · управляемый Railway · что лежит в базе\nсвязи между таблицами — на схеме доменной модели" {
    grid-columns: 4
    grid-gap: 40
    style.fill: "#ffffff"
    style.stroke: "#06b6d4"
    style.stroke-width: 3

# DOMAIN-MODEL-HERE
    user: USER {
      shape: sql_table
      class: core
      id: uuid {constraint: primary_key}
      name: string
      phone: string {constraint: unique}
      city: string
      photo_url: string
      club_id: uuid {constraint: foreign_key}
      rating: int
    }

    role: ROLE {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      user_id: uuid {constraint: foreign_key}
      kind: "десять ролей, см. ТЗ §2 (в т.ч. организатор клуба)"
      scope: "система | турнир | клуб | стол"
      scope_id: uuid
    }

    club: CLUB {
      shape: sql_table
      class: core
      id: uuid {constraint: primary_key}
      name: string
      city: string
    }

    tournament: TOURNAMENT {
      shape: sql_table
      class: core
      id: uuid {constraint: primary_key}
      name: string
      govtype: "тип управления: официальный | клубный"
      city: string
      format: "олимпийка | круговая | швейцарка"
      discipline: "одиночный | парный"
      status: "состояния, см. ТЗ §4.3"
      games_to_win: int
      starts_at: datetime

      # Свойства — независимые флаги, а не следствие категории. «Лига» и
      # «любительский» — это клубный турнир с разным набором этих флагов.
      needs_table_referees: "bool — судьи на столах"
      is_rated: "bool — учитывается ли в рейтинге"
      rating_limit: "string — ценз по рейтингу, если организатор задал"
      entry_fee: "int — плата за участие, ставит организатор (0 — нет)"
      needs_fee: "bool — годовой взнос (официальный)"
      needs_documents: "bool — документы к заявке"
      needs_approval: "bool — утверждение коллегией (только официальный)"
    }

    # Одна таблица на оба конкурса: на главного судью и на судейство столов.
    # Различаются они тем, КТО рассматривает (коллегия либо главный судья) и
    # сколько человек берут — а не структурой заявки. Набор судей столов пока
    # наше допущение (QUESTIONS 12).
    referee_application: REFEREE_APPLICATION {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      user_id: "uuid — судья-заявитель" {constraint: foreign_key}
      kind: "главный судья | судья стола"
      status: "подана | принята | отклонена"
      reject_reason: string
      decided_by: "uuid — коллегия или главный судья" {constraint: foreign_key}
    }

    # Годовой взнос. Отдельная сущность, а не флаг на игроке: у взноса свой год,
    # своя дата оплаты и свой автор отметки. Влияет ли он на допуск — открытый
    # вопрос (QUESTIONS 6.1), поэтому связи с ENTRY здесь намеренно нет.
    fee: MEMBERSHIP_FEE {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      user_id: uuid {constraint: foreign_key}
      year: "int — календарный или сезон, вопрос (Q 6.4)"
      status: "оплачен | не оплачен | просрочен"
      paid_at: datetime
      marked_by: "uuid — бухгалтер" {constraint: foreign_key}
    }

    # Плата ЗА КОНКРЕТНЫЙ ТУРНИР — отдельно от годового взноса. Её ставит
    # организатор клуба, и она есть в т.ч. на любительских турнирах. Годовой взнос
    # (MEMBERSHIP_FEE) — членство в федерации; эта плата — вход в один турнир.
    payment: TOURNAMENT_PAYMENT {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      user_id: uuid {constraint: foreign_key}
      amount: "int — плата за этот турнир"
      status: "оплачено | не оплачено"
      paid_at: datetime
      marked_by: "uuid — организатор клуба" {constraint: foreign_key}
    }

    table_: TOURNAMENT_TABLE {
      shape: sql_table
      class: core
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      number: int
      referee_id: uuid {constraint: foreign_key}
    }

    application: APPLICATION {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      club_id: "uuid — пусто, если игрок сам" {constraint: foreign_key}
      submitted_by: uuid {constraint: foreign_key}
      source: "клуб | игрок сам"
      status: "подана | принята | отклонена"
      reject_reason: string
    }

    application_item: APPLICATION_ITEM {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      application_id: uuid {constraint: foreign_key}
      user_id: uuid {constraint: foreign_key}
    }

    entry: ENTRY {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      player1_id: uuid {constraint: foreign_key}
      player2_id: "uuid — пусто в одиночке" {constraint: foreign_key}
      seed: int
      place: int
    }

    match: MATCH {
      shape: sql_table
      class: core
      id: uuid {constraint: primary_key}
      tournament_id: uuid {constraint: foreign_key}
      table_id: uuid {constraint: foreign_key}
      round: "1/8 | 1/4 | финал"
      side_a_id: uuid {constraint: foreign_key}
      side_b_id: uuid {constraint: foreign_key}
      serving_player_id: uuid {constraint: foreign_key}
      status: "ожидает | идёт | завершён"
      winner_side_id: uuid {constraint: foreign_key}
      is_walkover: bool
    }

    game: GAME {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      match_id: uuid {constraint: foreign_key}
      number: "номер партии 1..5"
      score1: int
      score2: int
      status: "идёт | завершена"

      # Кто вводил счёт: судья стола (официальный) либо главный судья (клубный).
      # На клубных победитель называет результат главному судье, тот вводит —
      # ввода игроком и подтверждения соперником НЕТ (по замечанию Андрея).
      entered_by: uuid {constraint: foreign_key}
      entry_source: "судья стола | главный судья"
    }

    rally: RALLY {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      game_id: uuid {constraint: foreign_key}
      number: int
      won_by: uuid {constraint: foreign_key}
      at_device: "datetime — время НА УСТРОЙСТВЕ"
      entered_by: uuid {constraint: foreign_key}
    }

    match_event: MATCH_EVENT {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      match_id: uuid {constraint: foreign_key}
      kind: "смена сторон | смена подачи"
      recorded_by: uuid {constraint: foreign_key}
      at: datetime
    }

    score_log: SCORE_LOG {
      shape: sql_table
      # Не class: audit. У sql_table d2 красит ШАПКУ цветом fill, а ТЕЛО строк —
      # цветом stroke, то есть наоборот по сравнению с обычным узлом. С классом
      # audit (fill светлый, stroke насыщенный) строки заливались #ef4444 и текст
      # в них не читался. Здесь цвета заданы под эту особенность: насыщенная
      # шапка, светлые строки. Сам класс в теме не трогаем — он для цилиндров.
      style: { fill: "#ef4444"; stroke: "#fee2e2"; stroke-width: 2 }
      id: uuid {constraint: primary_key}
      match_id: uuid {constraint: foreign_key}
      author_id: uuid {constraint: foreign_key}
      at: datetime
      before: string
      after: string
      reason: "правка судьи | переопределение"
    }

    rating_point: RATING_POINT {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      user_id: uuid {constraint: foreign_key}
      kind: "игрок | судья"
      tournament_id: uuid {constraint: foreign_key}
      value: "int — методика не определена (Q 5.1)"
      change: "int — например +24"
      at: datetime
    }

    # Обе таблицы появились после ревизии дизайна: на схеме архитектуры была
    # «лента уведомлений» и «регистрация токена», а хранилища под ними — не было.
    notification: NOTIFICATION {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      user_id: uuid {constraint: foreign_key}
      kind: "семь событий, см. ТЗ §10.1"
      title: string
      body: string
      created_at: datetime
      read_at: "datetime — пусто, пока не открыто"
    }

    push_token: PUSH_TOKEN {
      shape: sql_table
      class: new
      id: uuid {constraint: primary_key}
      user_id: uuid {constraint: foreign_key}
      token: "string — токен Expo, один формат на обе ОС"
      platform: "ios | android"
      created_at: datetime
      revoked_at: "datetime — выход или DeviceNotRegistered"
    }
  }
}

# ── СВЯЗИ МЕЖДУ СЛОЯМИ ──────────────────────────────────────────────────────
clients.tablet -> front.client
clients.player.web -> front.rsc
clients.desktop -> front.rsc
clients.guest -> front.rsc: публичные страницы { class: loop }

# приложение рендерит себя само, Next.js ему не нужен — только API
clients.player.app -> expo.router: мимо Next.js

front.rsc -> entry.gw: данные для рендера, сервер → сервер
front.mutate -> entry.gw: мутация из браузера, тот же путь, что у приложения

# EventSource живёт в браузере: серверный компонент отрендерился и умер,
# держать соединение ему нечем. Поэтому стрелка идёт именно отсюда.
front.only -> rt.stream: EventSource — подписка на поток { class: liveEdge }
expo.sse -> rt.stream: тот же поток, через polyfill { class: liveEdge }
expo.auth -> entry.gw: Bearer-токен, не куки
expo.data -> entry.gw: fetch с устройства
expo.push -> rt.notify: токен устройства — в PUSH_TOKEN { class: loop }

entry.rbac -> apps.profile
entry.rbac -> apps.tournaments
entry.rbac -> apps.applications
entry.rbac -> apps.fees
entry.rbac -> apps.score
entry.rbac -> apps.referee
entry.rbac -> apps.analytics

apps.applications -> apps.fees: проверка взноса, если турнир требует
apps.tournaments -> core.engine: генерация сетки
apps.score -> core.engine: партия сыграна
core.engine -> core.rating: итоги турнира

apps.score -> rt.emit: очко записано в базу
apps.score -> rt.broadcast: счёт для наложения
core.engine -> rt.worker: задача «матч готов»

apps.score -> storage.pg: каждая правка в SCORE_LOG { style.stroke: "#ef4444"; style.stroke-width: 2 }
apps.referee -> storage.pg: события матча в MATCH_EVENT { style.stroke: "#ef4444" }
entry.auth -> storage.pg
apps.analytics -> storage.pg: чтение и запись
core.rating -> storage.pg: рейтинги в историю
rt.worker -> storage.pg: очередь задач и лента живут в базе

# Байты идут мимо базы. В PostgreSQL остаётся только ключ объекта — иначе
# дамп базы распухает и его нельзя быстро восстановить.
apps.profile -> storage.pg: строки профиля
apps.profile -> storage.files: фото игрока { style.stroke: "#f97316"; style.stroke-width: 2 }
apps.applications -> storage.files: документы к заявке { style.stroke: "#f97316"; style.stroke-width: 2 }

storage.pg -> storage.backup: дамп по расписанию { style.stroke: "#dc2626"; style.stroke-width: 2 }
storage.files -> storage.backup: копия в другой регион { style.stroke: "#dc2626"; style.stroke-width: 2 }
