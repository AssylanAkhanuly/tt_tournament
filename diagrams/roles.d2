...@_theme

direction: down

# Иерархия ролей по ФНТ ТЗ v1.3. Наследование прав: вышестоящая роль может
# всё, что может нижестоящая.
#
# Судейство разделено на два уровня: председатель судейской коллегии заводит
# турнир, назначает на него судью по заявке и принимает результат; главный
# судья турнира отвечает за один турнир.
#
# Администратор системы стоит В СТОРОНЕ от этой цепочки, а не над ней: его
# область техническая (аккаунты, организации, настройки, контент), судейские
# права он не наследует. Он заводит учётные записи, но не решает, кто судит.
# Поэтому его рёбра — пунктиром: это не наследование прав.
#
# Роль — не флаг на пользователе, а связка «пользователь → роль → область».
# Один человек может быть тренером в клубе А, судьёй стола на турнире Б
# и игроком на турнире В одновременно.

adm: "Администратор системы\nвся платформа · техническая роль" { class: rbac }
psk: "Председатель судейской коллегии\nвсе турниры" { class: step }
gs: "Главный судья турнира\nодин турнир" { class: step }
tr: "Тренер, представитель\nсвой клуб или регион" { class: good }
ss: "Судья стола\nодин стол" { class: step }
ig: "Игрок\nсвой профиль · сайт и приложение" { class: step }
go: "Гость\nтолько чтение" { class: muted }

adm -> psk: "заводит аккаунт\nно не судейские права" { class: back }
adm -> tr: заводит аккаунт { class: back }
psk -> gs
gs -> ss
gs -> ig
tr -> ig
ss -> ig
ig -> go

guest_note: |md
  Сплошная стрелка — наследование прав. Пунктир от администратора — только
  заведение учётных записей: кто судит турнир, решает судейская коллегия.
  **Гость** — единственный выход из роли: регистрация
| {
  near: bottom-center
  style.font-size: 14
  style.fill: transparent
  style.stroke-width: 0
}
