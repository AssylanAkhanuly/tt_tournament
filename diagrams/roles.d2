...@_theme

direction: down

# Иерархия ролей по ФНТ ТЗ v1.5. Наследование прав: вышестоящая роль может
# всё, что может нижестоящая.
#
# Судейство разделено на два уровня: главный судья турнира принимает решения
# по своему турниру (система проведения, сетка, итоговый протокол), а
# председатель судейской коллегии их утверждает и не подменяет судью.
# Оценку судей ведёт председатель, отсюда его доступ ко всем протоколам.
#
# Федерация видит всё, но не наследует прав: это наблюдение, а не управление.
# Администратор системы стоит В СТОРОНЕ от цепочки, а не над ней: его область
# техническая (аккаунты, организации, настройки, контент), судейские права он
# не наследует. Он заводит учётные записи, но не решает, кто судит.
# Поэтому эти рёбра не сплошные: это не наследование прав.
#
# Роль — не флаг на пользователе, а связка «пользователь → роль → область».
# Один человек может быть тренером в клубе А, судьёй стола на турнире Б
# и игроком на турнире В одновременно.

fed: "Федерация\nвся деятельность · полный доступ" { class: live }
adm: "Администратор системы\nвся платформа · техническая роль" { class: rbac }
psk: "Председатель судейской коллегии\nвсе турниры · оценка судей" { class: step }
gs: "Главный судья турнира\nодин турнир" { class: step }
# не class:decide — тот рисует ромб, а ромб в блок-схеме означает развилку, не роль
buh: "Бухгалтер\nвзносы" {
  style: { fill: "#fef3c7"; stroke: "#f59e0b"; stroke-width: 2; border-radius: 8 }
}
tr: "Тренер\nсвой клуб или регион" { class: good }
org: "Организатор клуба\nклубные турниры: регламент, судья, плата" { class: good }
adminclub: "Администратор клуба\nрегистрация клуба · заявка команды в Евразийскую лигу" { class: good }
ss: "Судья стола\nодин стол" { class: step }
ig: "Игрок\nсвой профиль · сайт и приложение" { class: step }
go: "Гость\nтолько чтение" { class: muted }

fed -> psk: видит всё { class: loop }
fed -> buh: видит всё { class: loop }
adm -> psk: "заводит аккаунт\nно не судейские права" { class: back }
adm -> tr: заводит аккаунт { class: back }
adm -> buh: заводит аккаунт { class: back }
adm -> org: заводит аккаунт { class: back }
adm -> adminclub: заводит аккаунт { class: back }
psk -> gs
org -> gs: назначает на клубных { class: loop }
gs -> ss
gs -> ig
buh -> ig: допуск по взносу { class: loop }
tr -> ig
org -> ig: клубные турниры { class: loop }
adminclub -> ig: заявляет в состав команды { class: loop }
ss -> ig
ig -> go

guest_note: |md
  Сплошная стрелка — наследование прав: вышестоящая роль может всё, что может
  нижестоящая. Пунктиром показано то, что правами не является: администратор
  заводит учётные записи, но не решает, кто судит; федерация видит всё, но не
  управляет. **Гость** — единственный выход из роли: регистрация
| {
  near: bottom-center
  style.font-size: 14
  style.fill: transparent
  style.stroke-width: 0
}
