...@_theme

direction: down

# РОЛИ по документу федерации «Роли и их функционал» и совещанию 04.11.2026.
# Прежняя схема (наши одиннадцать ролей) отменена целиком, см. TZ §2.
#
# Что здесь важно:
#   * роли 3 и 4 — наблюдатели: видят все модули, но НИЧЕГО не правят.
#     Это отдельный класс прав, а не «роль пониже»;
#   * судейство разнесено на пять ролей: председатель ГСК собирает коллегию
#     (заявками и назначением), главный судья ведёт турнир и сам закрывает
#     протокол, секретарь вносит жеребьёвку, заместитель и секретарь получают
#     полномочия главного, когда он их передаёт, судья ведёт матчи;
#   * врач соревнований (18) даёт медицинский допуск — новая роль по решению
#     совещания федерации 04.11.2026;
#   * роли сборной 19–22 — будущие (решение владельца продукта 10.11.2026
#     по совещанию 04.11.2026): консультант (19) — полная копия главного
#     тренера; врача (21) и психолога (22) сборной заводит администратор;
#   * «гостя» в списке нет — публичные страницы читает любой посетитель.
#
# Сплошная стрелка — управление и наследование прав. Пунктир — то, что правами
# не является: заведение аккаунтов, наблюдение, проверка.
#
# Роль — не флаг на пользователе, а связка «пользователь → роль → область».
# Один человек может быть администратором клуба А, судьёй на турнире Б и
# спортсменом на турнире В одновременно.

# ── Федерация ────────────────────────────────────────────────────────────────
af: "1 · АДМИНИСТРАТОР ФЕДЕРАЦИИ\n(вариант названия — спортивный директор)\nполный доступ ко всем модулям · правит данные\nуправляет пользователями и процессами" { class: rbac }

ec: "2 · Экономист / бухгалтер\nпроверка и подтверждение оплат, взносы" {
  style: { fill: "#fef3c7"; stroke: "#f59e0b"; stroke-width: 2; border-radius: 8 }
}

msr: "3 · Менеджер по спортивной работе\nвидит все модули · тренерский совет и его протоколы" { class: live }
moc: "4 · Менеджер по организации соревнований\nвидит все модули · НЕ правит данные" { class: live }

# ── Судейская вертикаль ──────────────────────────────────────────────────────
gsk: "5 · Председатель ГСК\nсудейские коллегии · заявки и назначение судей\nконтроль работы судей · протокол не утверждает" { class: step }
gs: "6 · Главный судья соревнований\nодин турнир: система проведения, жеребьёвка,\nисправление счёта, итоговый протокол" { class: step }
sec: "7 · Главный секретарь соревнований\nжеребьёвка · сетки · расписание · протоколы" { class: step }
zam: "8 · Заместитель главного судьи\nполномочия главного, когда тот их передал" { class: step }
sud: "9 · Судья\nведение матчей, внесение результатов;\nпосле «завершить матч» не правит" { class: step }
doc: "18 · Врач соревнований\nмедицинский допуск по справке 027/у\nдопущен / не допущен" { class: good }

# ── Тренеры, регионы, клубы ──────────────────────────────────────────────────
nat: "11 · Главный тренер национальной команды\nпланы подготовки сборной · рапорты" { class: good }
reg: "12 · Старший тренер региона\nрегистрация и подача заявок\nна чемпионаты РК" { class: good }
cons: "19 · Тренер-консультант\nполная копия главного тренера:\nте же экраны и права · будущая роль" { class: muted }
agec: "20 · Тренер сборной\nкадеты · юноши · взрослые\nрапорты регионов по возрасту · будущая роль" { class: muted }
ndoc: "21 · Врач сборной\nмедицинская карточка: УМО,\nболезни, травмы · будущая роль" { class: muted }
npsy: "22 · Психолог сборной\nспортивная карточка · будущая роль" { class: muted }
club: "13 · Администратор клуба\nрегистрация клуба, спортсменов, тренеров\nи иных лиц · заявки на клубные соревнования" { class: good }

# ── Участник ─────────────────────────────────────────────────────────────────
sport: "14 · Спортсмен\nсамостоятельная регистрация\nна открытые республиканские турниры" { class: step }

# ── Кто кого заводит (это не наследование прав) ───────────────────────────────
af -> gsk: "заводит аккаунт и роль\nно не решает, кто судит" { class: back }
af -> ec: заводит аккаунт { class: back }
af -> doc: заводит по договору { class: back }
af -> nat: заводит аккаунт { class: back }
af -> reg: заводит аккаунт { class: back }
af -> club: заводит аккаунт { class: back }
af -> ndoc: заводит аккаунт и роль { class: back }
af -> npsy: заводит аккаунт и роль { class: back }

# ── Наблюдатели ──────────────────────────────────────────────────────────────
msr -> gs: смотрит, не правит { class: loop }
moc -> gs: смотрит, не правит { class: loop }

# ── Судейство ────────────────────────────────────────────────────────────────
gsk -> gs: назначает на турнир
gs -> sec: передаёт полномочия { class: loop }
gs -> zam: передаёт полномочия { class: loop }
gs -> sud
doc -> sport: допуск к соревнованию
sud -> sport: ведёт матчи и вносит результаты

# ── Путь спортсмена в турнир ─────────────────────────────────────────────────
ec -> sport: допуск по годовому взносу { class: loop }
reg -> sport: заявляет на чемпионаты РК
club -> sport: регистрирует и заявляет на клубные
nat -> sport: сборная { class: loop }
nat -> cons: копия: те же права { class: loop }
reg -> agec: рапорт по возрасту { class: loop }
ndoc -> nat: медкарточка { class: loop }
npsy -> nat: спортивная карточка { class: loop }

note: "Гостя как роли нет: публичные страницы —\nрейтинги, результаты, расписание, новости —\nчитает любой посетитель без входа в систему" { class: muted }
sport -> note: без входа в систему { class: loop }
