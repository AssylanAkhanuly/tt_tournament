...@_theme

direction: down

# ЧЕТЫРНАДЦАТЬ РОЛЕЙ по документу федерации «Роли и их функционал».
# Прежняя схема (наши одиннадцать ролей) отменена целиком, см. TZ §2.
#
# Что здесь важно:
#   * роли 3 и 4 — наблюдатели: видят все модули, но НИЧЕГО не правят.
#     Это отдельный класс прав, а не «роль пониже»;
#   * судейство разнесено на пять ролей: председатель ГСК назначает и
#     утверждает, главный судья ведёт турнир, секретарь делает жеребьёвку и
#     протоколы, заместитель подменяет главного, судья ведёт матчи;
#   * инспектор стоит В СТОРОНЕ: он не управляет турниром, а проверяет
#     качество судейства и пишет заключение;
#   * «гостя» в списке нет — публичные страницы читает любой посетитель.
#
# Сплошная стрелка — управление и наследование прав. Пунктир — то, что правами
# не является: заведение аккаунтов, наблюдение, проверка.
#
# Роль — не флаг на пользователе, а связка «пользователь → роль → область».
# Один человек может быть администратором клуба А, судьёй на турнире Б и
# спортсменом на турнире В одновременно.

# ── Федерация ────────────────────────────────────────────────────────────────
af: "1 · АДМИНИСТРАТОР ФЕДЕРАЦИИ\n(вариант названия — спортивный директор)\nполный доступ ко всем модулям · правит данные\nуправляет пользователями и процессами" { class: rbac }

ec: "2 · Экономист / бухгалтер\nпроверка и подтверждение оплат, взносы" {
  style: { fill: "#fef3c7"; stroke: "#f59e0b"; stroke-width: 2; border-radius: 8 }
}

msr: "3 · Менеджер по спортивной работе\nвидит все модули · НЕ правит данные" { class: live }
moc: "4 · Менеджер по организации соревнований\nвидит все модули · НЕ правит данные" { class: live }

# ── Судейская вертикаль ──────────────────────────────────────────────────────
gsk: "5 · Председатель ГСК\nсудейские коллегии · назначение судей\nутверждение результатов · контроль работы судей" { class: step }
gs: "6 · Главный судья соревнований\nодин турнир: сетки, результаты,\nдисциплинарные решения" { class: step }
sec: "7 · Главный секретарь соревнований\nжеребьёвка · сетки · расписание · протоколы" { class: step }
zam: "8 · Заместитель главного судьи\nфункционал в документе не указан" { class: muted }
sud: "9 · Судья\nведение матчей, внесение результатов,\nподтверждение сыгранных встреч" { class: step }
insp: "10 · Инспектор / супервайзер\nконтроль качества судейства,\nпроверки, заключения" { class: live }

# ── Тренеры, регионы, клубы ──────────────────────────────────────────────────
nat: "11 · Главный тренер национальной команды\nфункционал в документе не указан" { class: muted }
reg: "12 · Старший тренер региона\nрегистрация и подача заявок\nна чемпионаты РК" { class: good }
club: "13 · Администратор клуба\nрегистрация клуба, спортсменов, тренеров\nи иных лиц · заявки на клубные соревнования" { class: good }

# ── Участник ─────────────────────────────────────────────────────────────────
sport: "14 · Спортсмен\nсамостоятельная регистрация\nна открытые республиканские турниры" { class: step }

# ── Кто кого заводит (это не наследование прав) ───────────────────────────────
af -> gsk: "заводит аккаунт и роль\nно не решает, кто судит" { class: back }
af -> ec: заводит аккаунт { class: back }
af -> insp: заводит аккаунт { class: back }
af -> nat: заводит аккаунт { class: back }
af -> reg: заводит аккаунт { class: back }
af -> club: заводит аккаунт { class: back }

# ── Наблюдатели ──────────────────────────────────────────────────────────────
msr -> gs: смотрит, не правит { class: loop }
moc -> gs: смотрит, не правит { class: loop }

# ── Судейство ────────────────────────────────────────────────────────────────
gsk -> gs: назначает на турнир
gs -> sec
gs -> zam
gs -> sud
insp -> gs: проверяет качество судейства { class: loop }
sud -> sport: ведёт матчи и вносит результаты

# ── Путь спортсмена в турнир ─────────────────────────────────────────────────
ec -> sport: допуск по годовому взносу { class: loop }
reg -> sport: заявляет на чемпионаты РК
club -> sport: регистрирует и заявляет на клубные
nat -> sport: сборная { class: loop }

note: "Гостя как роли нет: публичные страницы —\nрейтинги, результаты, расписание, новости —\nчитает любой посетитель без входа в систему" { class: muted }
sport -> note: без входа в систему { class: loop }
