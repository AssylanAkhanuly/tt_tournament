...@_theme

direction: down

# Иерархия ролей. Наследование прав: вышестоящая роль может всё,
# что может нижестоящая.
#
# Роль — не флаг на пользователе, а связка «пользователь → роль → область».
# Один человек может быть тренером в клубе А, судьёй стола на турнире Б
# и игроком на турнире В одновременно.

gs: "Главный судья\nвся система" { class: rbac }
st: "Судья турнира\nодин турнир" { class: step }
tr: "Тренер клуба\nсвой клуб" { class: good }
ss: "Судья стола\nодин стол · планшет" { class: step }
ig: "Игрок\nсвой профиль · телефон" { class: step }
go: "Гость\nтолько чтение" { class: muted }

gs -> st
gs -> tr
st -> ss
st -> ig
tr -> ig
ss -> ig
ig -> go

guest_note: |md
  **Гость** — единственный выход из роли: регистрация
| {
  near: bottom-center
  style.font-size: 14
  style.fill: transparent
  style.stroke-width: 0
}
